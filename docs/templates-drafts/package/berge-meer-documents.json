{
  "id": "package:berge-meer-documents",
  "domain": "package",
  "version": "2026.10.09",
  "issuer": {
    "name": "Berge & Meer",
    "kind": "tour-operator",
    "keys": {
      "senderDomains": [
        "berge-meer.de"
      ]
    }
  },
  "markets": [
    "DE",
    "AT",
    "CH"
  ],
  "match": {
    "markers": [
      "Berge & Meer"
    ],
    "anchors": [
      "Ihr Reiseablauf",
      "Details zu Ihren Unterkünften"
    ]
  },
  "extraction": {
    "fields": {
      "bookingReference": {
        "patterns": [
          "^Buchungs-Nr\\.\\s+(?<v>[A-Z0-9]+)"
        ]
      },
      "issuedOn": {
        "patterns": [
          "^(?:Rechnungsdatum|Datum)[:\\s]+(\\d{2}\\.\\d{2}\\.(?:\\d{4}|\\d{2}))\\b"
        ],
        "transform": "date"
      },
      "tripName": {
        "patterns": [
          "^Sie haben bei uns gebucht:\\s*(.+)$"
        ],
        "transform": "text"
      },
      "startDate": {
        "patterns": [
          "^(?:Ihr Reisetag:|Reisedatum)\\s*(\\d{2}\\.\\d{2}\\.(?:\\d{4}|\\d{2}))\\b"
        ],
        "transform": "date"
      }
    },
    "repeats": {
      "flights": {
        "mode": "matchAll",
        "within": {
          "startAfter": "^Ihr Reiseablauf$",
          "endBefore": "^(?:Ihre Reiseunterlagen|Ihre Unterkünfte)$"
        },
        "pattern": "^(?<date>\\d{2}\\.\\d{2}\\.\\d{2}) (?<from>.+?) - (?<to>.+?) (?<dt>\\d{1,2}:\\d{2}) Uhr - (?<at>\\d{1,2}:\\d{2})(?<off>\\+\\d)? Uhr (?<fn>(?<al>[A-Z0-9]{2}) ?\\d{3,4})[ \\t]*$",
        "fields": {
          "date": {
            "group": "date",
            "transform": "date"
          },
          "depCity": {
            "group": "from",
            "transform": "text"
          },
          "arrCity": {
            "group": "to",
            "transform": "text"
          },
          "depTime": {
            "group": "dt",
            "transform": "time"
          },
          "arrTime": {
            "group": "at",
            "transform": "time"
          },
          "arrDayOffset": {
            "group": "off",
            "transform": "dayOffset"
          },
          "flightNumber": {
            "group": "fn",
            "transform": "flightNumber"
          },
          "airline": {
            "group": "al",
            "transform": "upper"
          }
        }
      },
      "stays": {
        "mode": "split",
        "within": {
          "startAfter": "^Details zu Ihren Unterkünften",
          "endBefore": "^[^\\n]*Seite \\d+ von \\d+"
        },
        "splitPattern": "^\\d{2}\\.\\d{2}\\.\\d{2} - \\d{2}\\.\\d{2}\\.\\d{2} ",
        "fields": {
          "checkIn": {
            "patterns": [
              "^(\\d{2}\\.\\d{2}\\.\\d{2}) - \\d{2}\\.\\d{2}\\.\\d{2} "
            ],
            "transform": "date"
          },
          "checkOut": {
            "patterns": [
              "^\\d{2}\\.\\d{2}\\.\\d{2} - (\\d{2}\\.\\d{2}\\.\\d{2}) "
            ],
            "transform": "date"
          },
          "name": {
            "patterns": [
              "^\\d{2}\\.\\d{2}\\.\\d{2} - \\d{2}\\.\\d{2}\\.\\d{2} (.+)$"
            ],
            "transform": "text"
          },
          "address": {
            "patterns": [
              "^\\d{2}\\.\\d{2}\\.\\d{2} - \\d{2}\\.\\d{2}\\.\\d{2} [^\\n]*\\n(?!Tel|www\\.|https?:|Seite )([^\\n]+)\\n[^\\n]+\\n[^\\n]+"
            ],
            "flags": "i",
            "transform": "text"
          },
          "city": {
            "patterns": [
              "\\n(?!Tel|www\\.|https?:|Seite )([^\\n]+)\\n(?!Tel|www\\.|https?:|Seite )[^\\n]+(?:\\n(?:Tel|www\\.|https?:)[^\\n]*)*\\s*$"
            ],
            "flags": "i",
            "transform": "text"
          },
          "country": {
            "patterns": [
              "\\n(?!Tel|www\\.|https?:|Seite )([^\\n]+)(?:\\n(?:Tel|www\\.|https?:)[^\\n]*)*\\s*$"
            ],
            "flags": "i",
            "transform": "text"
          }
        }
      }
    },
    "required": [
      "bookingReference",
      "issuedOn",
      "stays"
    ]
  },
  "testCases": [
    {
      "name": "invented travel documents are read: ticketed legs by city, hotels with address",
      "input": "Berge & Meer Touristik GmbH · Beispielallee 1 · 99999 Musterstadt\nIhre Reiseunterlagen\nBuchungs-Nr. 7Q654321\nDatum: 01.03.25\nReisedatum 21.03.2025\nIhr Reiseablauf\n20.03.25 Zug zum Flug\n21.03.25 Munich - Bahrain 11:40 Uhr - 19:20 Uhr GF 0086\n21.03.25 Bahrain - Hanoi 21:05 Uhr - 08:10+1 Uhr GF 0156\n22.03.25 - 29.03.25 div. Rundreisehotels Vietnam\n24.03.25 Hanoi - Hue 00:00 Uhr - 00:01 Uhr XX XXX\n26.03.25 Hue - Da Nang sep. Ticket*\n29.03.25 Hanoi - Bahrain 23:55 Uhr - 04:30+1 Uhr GF 0157\n30.03.25 Bahrain - Munich 07:40 Uhr - 12:35 Uhr GF 0017\nIhre Unterkünfte\nDetails zu Ihren Unterkünften\n22.03.25 - 24.03.25 Hotel Lotus Example\n12 Beispielgasse\nHanoi\nVietnam\nTel.: +84 000 0000\n24.03.25 - 26.03.25 Song Huong Muster Resort\n7 Uferweg\nHue\nVietnam\n26.03.25 - 29.03.25 Hotel Lotus Example\n12 Beispielgasse\nHanoi\nVietnam\nwww.lotus-example.invalid\nXY0000 MUC 21.03.2025 - 7Q654321.1 - 1/1 - ABCD Seite 3 von 8\nNotfallnummern\nReiseleitung vor Ort: +84 111 1111",
      "expect": "match",
      "expected": {
        "bookingReference": "7Q654321",
        "issuedOn": "2025-03-01",
        "startDate": "2025-03-21",
        "flights": [
          {
            "date": "2025-03-21",
            "depCity": "Munich",
            "arrCity": "Bahrain",
            "depTime": "11:40",
            "arrTime": "19:20",
            "arrDayOffset": 0,
            "flightNumber": "GF0086",
            "airline": "GF"
          },
          {
            "depCity": "Bahrain",
            "arrCity": "Hanoi",
            "arrDayOffset": 1
          },
          {
            "depCity": "Hanoi",
            "arrCity": "Bahrain",
            "date": "2025-03-29",
            "arrDayOffset": 1
          },
          {
            "depCity": "Bahrain",
            "arrCity": "Munich",
            "flightNumber": "GF0017"
          }
        ],
        "stays": [
          {
            "checkIn": "2025-03-22",
            "checkOut": "2025-03-24",
            "name": "Hotel Lotus Example",
            "address": "12 Beispielgasse",
            "city": "Hanoi",
            "country": "Vietnam"
          },
          {
            "name": "Song Huong Muster Resort",
            "city": "Hue",
            "country": "Vietnam"
          },
          {
            "checkIn": "2025-03-26",
            "checkOut": "2025-03-29",
            "city": "Hanoi",
            "country": "Vietnam"
          }
        ]
      }
    },
    {
      "name": "the operator's invoice is not a travel document",
      "input": "Berge & Meer Touristik GmbH · Beispielallee 1 · 99999 Musterstadt\nRECHNUNG\nBuchungs-Nr. 9Z123456/2\nDatum: 02.03.26\nSie haben bei uns gebucht: Kenia & Tansania – Erlebnisreise\nIhr Reisetag: 18.05.2026\nREISETEILNEHMER NAME GEBURTSDATUM\n1 Frau Erika Beispiel 01.01.70\n2 Herr Max Muster 02.02.71\nIHRE FLUGSTRECKE\nVON - NACH AIRLINE FLUGNR DATUM ABFLUG ANKUNFT\nFRA - ADD ET 707 18.05.26 21:35 06:25+1\nADD - NBO ET 308 19.05.26 08:40 10:55\nNBO - ADD ET 309 30.05.26 12:00 14:10\nADD - FRA ET 706 30.05.26 23:15 05:50+1\n* Flugzeiten unter Vorbehalt\nLEISTUNGEN\nRundreise laut Programm\nHotel für 2 Erw.\nGesamtbetrag 3.249,00 EUR",
      "expect": "decline"
    },
    {
      "name": "a cover letter pointing at the PDF is declined",
      "input": "Berge & Meer Touristik GmbH\nSehr geehrte Frau Beispiel, anbei erhalten Sie Ihre Reiseunterlagen als PDF-Datei.",
      "expect": "decline"
    }
  ]
}
