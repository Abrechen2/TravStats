{
  "name": "travstats-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "tokens": "node scripts/generate-theme.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format": "cd .. && npm run format",
    "format:check": "cd .. && npm run format:check",
    "dead-code": "ts-prune | grep -v \"(used in module)\""
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "~9.4.1",
    "@deck.gl/core": "~9.4.1",
    "@deck.gl/extensions": "~9.4.1",
    "@deck.gl/geo-layers": "~9.4.1",
    "@deck.gl/layers": "~9.4.1",
    "@deck.gl/mapbox": "~9.4.1",
    "@hookform/resolvers": "^5.9.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "axios": "^1.21.0",
    "d3-geo": "^3.1.2",
    "date-fns": "^3.0.6",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.5.1",
    "html2canvas": "^1.4.1",
    "i18next": "^26.7.2",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.9",
    "jsqr": "^1.4.0",
    "maplibre-gl": "^6.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.13",
    "react-map-gl": "^8.1.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tesseract.js": "^6.0.1",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "date-fns-tz": "^3.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^17.14.0",
    "jsdom": "^23.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "ts-prune": "^0.10.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.1",
    "vitest": "^5.0.3"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "preact": ">=10.27.3",
    "lodash-es": ">=4.17.23",
    "uuid": ">=14.0.0",
    "fast-xml-parser": ">=5.10.1",
    "dompurify": ">=3.4.17",
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "@loaders.gl/compression": {
      "fflate": "0.7.5"
    },
    "texture-compressor": {
      "image-size": "^2.0.3"
    }
  }
}
