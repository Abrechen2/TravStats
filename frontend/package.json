    "@simplewebauthn/browser": "^13.3.0",
    "@turf/turf": "^6.5.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "axios": "^1.15.2",
    "d3-geo": "^3.1.1",
    "date-fns": "^3.0.6",
    "date-fns-tz": "^3.2.0",
    "deck.gl": "^9.2.11",
