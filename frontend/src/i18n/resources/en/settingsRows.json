      "confirm_one": "Delete {{count}}",
      "confirm_other": "Delete {{count}}"
    },
    "companiondel": {
      "title": "Delete {{name}}?",
      "affects": "{{name}}",
      "amount": "No entries",
      "after": "The person disappears from all suggestions.",
      "confirm": "Delete"
    },
    "linksoff": {
      "title": "Turn off public links?",
      "affects": "Every account on this server",
      "amount_one": "{{count}} link",
      "amount_other": "{{count}} links",
      "after": "I delete them at once. Turning on again won't bring them back.",
      "confirm_one": "Delete {{count}} link",
      "confirm_other": "Delete {{count}} links"
    },
    "replace": {
      "title": "Replace contents?",
      "affects": "The sheets {{sheets}} in your account",
      "amount": "{{missing}} entries are missing from the file and will be deleted. {{kept}} come from {{file}}.",
