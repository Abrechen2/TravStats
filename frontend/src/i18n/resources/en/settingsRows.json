      "confirm": "Replace {{missing}} entries",
      "word": "REPLACE"
    },
    "carddelete": {
      "title": "Delete “{{name}}”?",
      "affects": "{{name}}",
      "amount": "One card",
      "after": "The card and its links to airlines, chains or hotels are gone. Your flights, stays and journeys stay.",
