      "title": "Merge {{from}} into {{to}}?",
      "affects": "{{from}}",
      "amount_one": "{{count}} entry",
      "amount_other": "{{count}} entries",
      "after": "They will name {{to}}. This can't be undone.",
      "confirm": "Merge"
    },
    "unused": {
      "title": "Delete unused companions?",
      "affects": "People without entries",
      "amount_one": "{{count}} person",
      "amount_other": "{{count}} people",
