{
  "$schema": "./vectors.schema.json",
  "version": 1,
  "minTzdata": "2025a",
  "cases": [
    {
      "id": "berlin-gap-typed",
      "op": "toInstant",
      "note": "02:30 does not exist on 2027-03-28 in Berlin; a person who typed it is refused",
      "input": { "local": "2027-03-28T02:30", "zone": "Europe/Berlin", "origin": "typed" },
      "expect": { "error": "LOCAL_TIME_NONEXISTENT" }
    },
    {
      "id": "berlin-gap-edge-before",
      "op": "toInstant",
      "input": { "local": "2027-03-28T01:59", "zone": "Europe/Berlin" },
      "expect": { "utc": "2027-03-28T00:59:00Z", "offset": "+01:00", "ambiguous": false }
    },
    {
      "id": "berlin-gap-edge-after",
      "op": "toInstant",
      "input": { "local": "2027-03-28T03:00", "zone": "Europe/Berlin" },
      "expect": { "utc": "2027-03-28T01:00:00Z", "offset": "+02:00", "ambiguous": false }
    },
    {
      "id": "berlin-gap-machine",
      "op": "toInstant",
      "note": "a machine wall clock in the gap is never refused; it lands where a clock not yet turned forward puts it",
      "input": { "local": "2027-03-28T02:30", "zone": "Europe/Berlin", "origin": "machine" },
      "expect": { "utc": "2027-03-28T01:30:00Z", "offset": "+02:00", "ambiguous": false }
    },
    {
      "id": "berlin-gap-machine-read",
      "op": "toLocal",
      "input": { "utc": "2027-03-28T01:30:00Z", "zone": "Europe/Berlin" },
      "expect": { "local": "2027-03-28T03:30:00", "offset": "+02:00" }
    },
    {
      "id": "berlin-fold-default",
      "op": "toInstant",
      "note": "owner decision Q5: the earlier occurrence by default",
      "input": { "local": "2027-10-31T02:30", "zone": "Europe/Berlin" },
      "expect": { "utc": "2027-10-31T00:30:00Z", "offset": "+02:00", "ambiguous": true }
    },
    {
      "id": "berlin-fold-later",
      "op": "toInstant",
      "input": { "local": "2027-10-31T02:30", "zone": "Europe/Berlin", "fold": "later" },
      "expect": { "utc": "2027-10-31T01:30:00Z", "offset": "+01:00", "ambiguous": true }
    },
    {
