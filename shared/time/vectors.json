    },
    {
      "id": "utc-zone",
      "op": "toInstant",
      "input": { "local": "2027-06-01T12:00:00", "zone": "UTC" },
      "expect": { "utc": "2027-06-01T12:00:00Z", "offset": "+00:00", "ambiguous": false }
