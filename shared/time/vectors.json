    },
    {
      "id": "red-eye-nye-day",
      "op": "localDay",
      "note": "counts for 2026 in statistics, although its UTC year is 2027",
      "input": { "utc": "2027-01-01T03:30:00Z", "zone": "America/New_York" },
      "expect": { "day": "2026-12-31" }
    },
    {
      "id": "stay-utc-inversion-checkout",
      "op": "toInstant",
      "note": "a 10:00 check-out on 2027-05-02 in Kiritimati is still 2027-05-01 in UTC, before the check-in day's UTC-midnight anchor",
      "input": { "local": "2027-05-02T10:00", "zone": "Pacific/Kiritimati" },
      "expect": { "utc": "2027-05-01T20:00:00Z", "offset": "+14:00", "ambiguous": false }
    },
    {
      "id": "stay-utc-inversion-day",
      "op": "localDay",
      "note": "ordering and nights go by the local day: check-in and check-out share 2027-05-02, zero nights",
      "input": { "utc": "2027-05-01T20:00:00Z", "zone": "Pacific/Kiritimati" },
      "expect": { "day": "2027-05-02" }
    },
    {
      "id": "stay-utc-inversion-span",
      "op": "span",
      "input": {
        "start": { "local": "2027-05-02T00:00", "zone": "Pacific/Kiritimati" },
        "end": { "local": "2027-05-02T10:00", "zone": "Pacific/Kiritimati" }
      },
      "expect": {
        "startUtc": "2027-05-01T10:00:00Z",
        "endUtc": "2027-05-01T20:00:00Z",
        "minutes": 600,
        "startDay": "2027-05-02",
        "endDay": "2027-05-02",
        "dayDiff": 0
      }
    },
