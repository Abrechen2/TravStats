      "expect": { "error": "LOCAL_TIME_NONEXISTENT" }
    },
    {
      "id": "sydney-fold-default",
      "op": "toInstant",
      "input": { "local": "2027-04-04T02:30", "zone": "Australia/Sydney" },
      "expect": { "utc": "2027-04-03T15:30:00Z", "offset": "+11:00", "ambiguous": true }
    },
    {
      "id": "sydney-fold-later",
      "op": "toInstant",
      "input": { "local": "2027-04-04T02:30", "zone": "Australia/Sydney", "fold": "later" },
      "expect": { "utc": "2027-04-03T16:30:00Z", "offset": "+10:00", "ambiguous": true }
    },
    {
      "id": "lordhowe-gap",
      "op": "toInstant",
      "note": "Lord Howe turns its clock by 30 minutes: 02:00 becomes 02:30",
      "input": { "local": "2027-10-03T02:15", "zone": "Australia/Lord_Howe" },
      "expect": { "error": "LOCAL_TIME_NONEXISTENT" }
    },
    {
      "id": "lordhowe-fold-default",
      "op": "toInstant",
      "input": { "local": "2027-04-04T01:45", "zone": "Australia/Lord_Howe" },
      "expect": { "utc": "2027-04-03T14:45:00Z", "offset": "+11:00", "ambiguous": true }
    },
    {
      "id": "lordhowe-fold-later",
      "op": "toInstant",
      "input": { "local": "2027-04-04T01:45", "zone": "Australia/Lord_Howe", "fold": "later" },
      "expect": { "utc": "2027-04-03T15:15:00Z", "offset": "+10:30", "ambiguous": true }
    },
    {
      "id": "tokyo-fra",
      "op": "span",
      "input": {
        "start": { "local": "2027-06-01T10:00", "zone": "Asia/Tokyo" },
        "end": { "local": "2027-06-01T15:00", "zone": "Europe/Berlin" }
      },
      "expect": {
        "startUtc": "2027-06-01T01:00:00Z",
        "endUtc": "2027-06-01T13:00:00Z",
        "minutes": 720,
        "startDay": "2027-06-01",
        "endDay": "2027-06-01",
        "dayDiff": 0
      }
    },
    {
      "id": "tokyo-hnl",
      "op": "span",
      "note": "eastbound over the date line: the arrival reads earlier than the departure and is still seven hours later",
      "input": {
        "start": { "local": "2027-06-01T21:00", "zone": "Asia/Tokyo" },
        "end": { "local": "2027-06-01T09:00", "zone": "Pacific/Honolulu" }
      },
      "expect": {
        "startUtc": "2027-06-01T12:00:00Z",
        "endUtc": "2027-06-01T19:00:00Z",
        "minutes": 420,
        "startDay": "2027-06-01",
        "endDay": "2027-06-01",
        "dayDiff": 0
      }
    },
    {
      "id": "samoa-2011-before",
      "op": "toLocal",
      "note": "Samoa skipped 2011-12-30 entirely",
      "input": { "utc": "2011-12-30T09:00:00Z", "zone": "Pacific/Apia" },
      "expect": { "local": "2011-12-29T23:00:00", "offset": "-10:00" }
    },
    {
      "id": "samoa-2011-after",
      "op": "toLocal",
      "input": { "utc": "2011-12-30T10:00:00Z", "zone": "Pacific/Apia" },
      "expect": { "local": "2011-12-31T00:00:00", "offset": "+14:00" }
    },
    {
      "id": "samoa-2011-typed",
      "op": "toInstant",
      "input": { "local": "2011-12-30T12:00", "zone": "Pacific/Apia" },
      "expect": { "error": "LOCAL_TIME_NONEXISTENT" }
    },
    {
      "id": "kolkata-half-hour",
      "op": "toInstant",
      "input": { "local": "2027-01-15T00:15", "zone": "Asia/Kolkata" },
      "expect": { "utc": "2027-01-14T18:45:00Z", "offset": "+05:30", "ambiguous": false }
    },
    {
      "id": "kathmandu-quarter-hour",
      "op": "toInstant",
      "input": { "local": "2027-01-15T05:44", "zone": "Asia/Kathmandu" },
      "expect": { "utc": "2027-01-14T23:59:00Z", "offset": "+05:45", "ambiguous": false }
    },
    {
      "id": "kathmandu-day",
      "op": "localDay",
      "input": { "utc": "2027-01-14T23:59:00Z", "zone": "Asia/Kathmandu" },
      "expect": { "day": "2027-01-15" }
    },
    {
      "id": "moscow-2012-offset",
      "op": "toLocal",
      "note": "Moscow kept summer time all year from 2011 to 2014",
      "input": { "utc": "2012-07-01T12:00:00Z", "zone": "Europe/Moscow" },
      "expect": { "local": "2012-07-01T16:00:00", "offset": "+04:00" }
    },
    {
      "id": "moscow-2015-offset",
      "op": "toLocal",
      "input": { "utc": "2015-07-01T12:00:00Z", "zone": "Europe/Moscow" },
      "expect": { "local": "2015-07-01T15:00:00", "offset": "+03:00" }
    },
    {
      "id": "moscow-2014-fold-default",
      "op": "toInstant",
      "note": "2014-10-26 02:00 +04 became 01:00 +03, so 01:00-02:00 happened twice",
      "input": { "local": "2014-10-26T01:30", "zone": "Europe/Moscow" },
      "expect": { "utc": "2014-10-25T21:30:00Z", "offset": "+04:00", "ambiguous": true }
    },
    {
      "id": "moscow-2014-fold-later",
      "op": "toInstant",
      "input": { "local": "2014-10-26T01:30", "zone": "Europe/Moscow", "fold": "later" },
      "expect": { "utc": "2014-10-25T22:30:00Z", "offset": "+03:00", "ambiguous": true }
    },
    {
      "id": "moscow-2011-no-fold",
      "op": "toInstant",
      "note": "October 2011 had no fall-back in Moscow",
      "input": { "local": "2011-10-30T02:30", "zone": "Europe/Moscow" },
      "expect": { "utc": "2011-10-29T22:30:00Z", "offset": "+04:00", "ambiguous": false }
    },
    {
      "id": "istanbul-2016",
      "op": "toLocal",
      "note": "Turkey stayed on +03 all year from September 2016",
      "input": { "utc": "2016-11-15T12:00:00Z", "zone": "Europe/Istanbul" },
      "expect": { "local": "2016-11-15T15:00:00", "offset": "+03:00" }
    },
    {
      "id": "istanbul-2015",
      "op": "toLocal",
      "input": { "utc": "2015-11-15T12:00:00Z", "zone": "Europe/Istanbul" },
      "expect": { "local": "2015-11-15T14:00:00", "offset": "+02:00" }
