    {
      "id": "unknown-zone-server-read",
      "op": "toLocal",
      "appliesTo": ["server"],
      "input": { "utc": "2027-06-01T12:00:00Z", "zone": "Mars/Olympus" },
      "expect": { "error": "ZONE_UNKNOWN" }
    },
    {
      "id": "unknown-zone-server-write",
      "op": "toInstant",
      "appliesTo": ["server"],
      "input": { "local": "2027-06-01T12:00", "zone": "Mars/Olympus" },
      "expect": { "error": "ZONE_UNKNOWN" }
    },
    {
      "id": "raw-offset-is-not-a-zone",
      "op": "toInstant",
      "appliesTo": ["server"],
      "note": "an offset is not a place and has no DST",
      "input": { "local": "2027-06-01T12:00", "zone": "+02:00" },
      "expect": { "error": "ZONE_UNKNOWN" }
    },
    {
      "id": "unknown-zone-client-display",
      "op": "display",
      "appliesTo": ["web", "companion"],
      "note": "a client meeting a zone it does not know shows the server's local and offset and never throws",
      "input": {
        "value": {
          "utc": "2027-06-01T12:00:00Z",
          "zone": "Mars/Olympus",
          "offset": "+01:30",
          "local": "2027-06-01T13:30:00",
          "precision": "minute"
        }
      },
      "expect": { "date": "2027-06-01", "time": "13:30", "offset": "+01:30" }
    },
    {
      "id": "precision-minute-display",
      "op": "display",
      "appliesTo": ["web", "companion"],
      "input": {
        "value": {
          "utc": "2027-01-14T23:59:00Z",
          "zone": "Asia/Kathmandu",
          "offset": "+05:45",
          "local": "2027-01-15T05:44:00",
          "precision": "minute"
        }
      },
      "expect": { "date": "2027-01-15", "time": "05:44", "offset": "+05:45" }
    },
    {
      "id": "precision-day-display",
      "op": "display",
      "appliesTo": ["web", "companion"],
      "input": {
        "value": {
          "utc": "2027-05-01T22:00:00Z",
          "zone": "Europe/Berlin",
          "offset": "+02:00",
          "local": "2027-05-02T00:00:00",
          "precision": "day"
        }
      },
      "expect": { "date": "2027-05-02", "time": null, "offset": null }
    },
    {
      "id": "precision-unknown-display",
      "op": "display",
      "appliesTo": ["web", "companion"],
      "note": "owner decision Q4: the date is kept, the time of day is not shown",
      "input": {
        "value": {
          "utc": "2026-08-01T10:00:00Z",
          "zone": "Europe/Berlin",
          "offset": "+02:00",
          "local": "2026-08-01T12:00:00",
          "precision": "unknown"
        }
      },
      "expect": { "date": "2026-08-01", "time": null, "offset": null }
    },
    {
      "id": "precision-month-display",
      "op": "display",
      "appliesTo": ["web", "companion"],
      "input": {
        "value": {
          "utc": "1998-07-01T00:00:00Z",
          "zone": "UTC",
          "offset": "+00:00",
          "local": "1998-07-01T00:00:00",
          "precision": "month"
        }
      },
      "expect": { "date": "1998-07", "time": null, "offset": null }
    },
    {
      "id": "precision-year-display",
      "op": "display",
      "appliesTo": ["web", "companion"],
      "input": {
        "value": {
          "utc": "1998-01-01T00:00:00Z",
          "zone": "UTC",
          "offset": "+00:00",
          "local": "1998-01-01T00:00:00",
          "precision": "year"
        }
      },
      "expect": { "date": "1998", "time": null, "offset": null }
    },
    {
      "id": "floating-birthday",
      "op": "floatingDate",
      "note": "a floating date has no zone and comes back as the same day on every host",
      "input": { "date": "1990-02-28" },
      "expect": { "date": "1990-02-28" }
    },
    {
      "id": "floating-leap-day",
      "op": "floatingDate",
      "input": { "date": "2028-02-29" },
      "expect": { "date": "2028-02-29" }
    },
    {
      "id": "floating-not-a-date",
      "op": "floatingDate",
      "input": { "date": "2027-02-29" },
