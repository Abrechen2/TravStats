      "expect": { "utc": "2027-11-07T05:30:00Z", "offset": "-04:00", "ambiguous": true }
    },
    {
      "id": "ny-fold-later",
      "op": "toInstant",
      "input": { "local": "2027-11-07T01:30", "zone": "America/New_York", "fold": "later" },
      "expect": { "utc": "2027-11-07T06:30:00Z", "offset": "-05:00", "ambiguous": true }
    },
    {
      "id": "sydney-gap",
      "op": "toInstant",
