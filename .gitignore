# Worktrees
.worktrees/

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment
.env
.env.local
.env.dev.local
.env.development.local
.env.test.local
.env.production.local
.claude
.claude/settings.json
Agent.md
CLAUDE.local.md

# All markdown files except root README.md, CHANGELOG.md, CLAUDE.md, CONTRIBUTING.md, ROADMAP.md, SECURITY.md, docs/**/*.md
*.md
!README.md
!CHANGELOG.md
!CLAUDE.md
!CONTRIBUTING.md
!ROADMAP.md
!SECURITY.md
!docs/**/*.md
!backend/OLLAMA_OPTIMIZATION.md

# Private: audit findings, internal plans, personal notes — never commit
.private/


# Build outputs
dist/
build/
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
nul

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output

# Test files with credentials (should not be committed)
backend/test-imap.js

# Uploads (user data should not be committed)
backend/uploads/
uploads/
Sample Boardingpasses/
Sample Emails/
Logo/

# Test samples (privacy - actual sample files should not be committed)
test-samples/**/*.msg
test-samples/**/*.eml
test-samples/**/*.txt
test-samples/**/*.jpg
test-samples/**/*.png
test-samples/**/*.gif
test-samples/**/results/*.json
# But keep directory structure and README
!test-samples/README.md
!test-samples/**/.gitkeep

# Database
*.db
*.sqlite
pgdata/

# Docker
.dockerignore

# Large binary files (users can download separately)
backend/eng.traineddata

# Dev scripts
backend/scripts/test-parser-samples.ts

# Lab / scratch tooling — workspace for ad-hoc experiments, never commit.
# `tools/*` (not `tools/`) so specific committed tools can be re-included below.
tools/*
# Committed, non-scratch tools (real deliverables, tracked normally):
!tools/discord-setup/
frontend/test-export.xlsx

# Training data and outputs (should not be committed)
backend/data/training/training-*.jsonl
backend/data/training/output-*/
backend/data/training/test-output/
backend/data/logs/training/

# Land-mask rasterizer cache (downloaded GeoJSON, regenerated on demand).
# The packed output at backend/data/land-mask.bin IS committed.
backend/data/.cache/

# Tool-generated directories (never commit)
.playwright-mcp/
.superpowers/
screenshots/

# Loose screenshots / lab renders / demo PNGs that accumulate at the
# repo root during sessions. Tracked PNGs (docs/images/, frontend/public/,
# test-samples/) are unaffected.
/*.png
/*.jpg
/*.jpeg

# Production logs (never commit)
ProdLogs/
.cursor
/.tmp/
.gitnexus
brand-smoke-shots/

# Playwright test artifacts (never commit)
/playwright-report/
/test-results/

# Private memory archive + backups (owner-local, never committed)
memory-archive/
memory-backup-*.tar.gz

# Internal roadmap board — the curated data layer and the generated page.
# The *.md rule above does NOT cover .yaml, so this must be explicit:
# without it the internal roadmap would be published to the public repo.
roadmap.local.yaml
.roadmap/
# Nor does the *.md rule cover a renamed *.md.archive (glob `*.md` only
# matches names ending in ".md" — verified with `git check-ignore`, it did
# NOT match). The archived hand-written roadmap carries the same real
# hosts/IPs as roadmap.local.yaml, so it needs the same explicit rule.
ROADMAP.local.md.archive

# Real boarding passes for local parser testing — personal data (name, PNR,
# FF number in the barcode). NEVER in this public repo; the private companion
# repo TravStats-local is the place if they need to be versioned at all.
test-samples/boarding-passes/
