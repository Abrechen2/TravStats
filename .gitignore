# Worktrees
.worktrees/

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment
.env
.env.local
.env.dev.local
.env.development.local
.env.test.local
.env.production.local
.claude
.claude/settings.json
Agent.md
CLAUDE.local.md

# All markdown files except root README.md, CHANGELOG.md, CLAUDE.md, CONTRIBUTING.md, ROADMAP.md, SECURITY.md, docs/**/*.md
*.md
!README.md
!CHANGELOG.md
!CLAUDE.md
!CONTRIBUTING.md
!ROADMAP.md
!SECURITY.md
!docs/**/*.md
!design/**/*.md
!ClaudeDesign/**/*.md
!backend/OLLAMA_OPTIMIZATION.md
# Provenance of the seeded catalogs. The POI spec REQUIRES the source and
# licence of any bulk-derived catalog to be recorded next to the data, so this
# one is not optional — the blanket *.md above had silently swallowed it, which
# would have shipped 1247 rows of vendored data with no record of where they
# came from.
!backend/src/seedData/*.md

# Private: audit findings, internal plans, personal notes — never commit
.private/


# Build outputs
dist/
build/
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
nul

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output

# Test files with credentials (should not be committed)
backend/test-imap.js

# Uploads (user data should not be committed)
backend/uploads/
uploads/
Sample Boardingpasses/
Sample Emails/
Logo/

# Test samples (privacy - actual sample files should not be committed)
test-samples/**/*.msg
test-samples/**/*.eml
test-samples/**/*.txt
# PDFs waren hier NICHT abgedeckt: vier Kreuzfahrt-Rechnungen mit Name,
# Anschrift, IBAN und Telefonnummer lagen dadurch ab 2026-04-25 im
# oeffentlichen Repository. Beispieldokumente sind fast immer echte
# Buchungen - die Regel deckt deshalb jedes Dokumentformat ab, nicht die,
# an die gerade jemand gedacht hat.
test-samples/**/*.pdf
test-samples/**/*.doc
test-samples/**/*.docx
test-samples/**/*.html
test-samples/**/*.csv
test-samples/**/*.jpg
test-samples/**/*.png
test-samples/**/*.gif
test-samples/**/results/*.json
# The corpus ratchet names the owner's own flights, hotels and dates — data, not code.
test-samples/**/expectations.json
# But keep directory structure and README
!test-samples/README.md
!test-samples/**/.gitkeep

# Database
*.db
*.sqlite
pgdata/

# Docker
# `.dockerignore` is deliberately NOT ignored: it is build configuration, and
# the Dockerfile beside it is tracked. Ignoring one half meant every clone built
# a different image — measured 2026-09-02, the context was ~1.9 GB and the
# host's node_modules were copied over the ones `npm ci` had just installed.

# Large binary files (users can download separately)
backend/eng.traineddata

# Dev scripts
backend/scripts/test-parser-samples.ts

# Lab / scratch tooling — workspace for ad-hoc experiments, never commit.
# `tools/*` (not `tools/`) so specific committed tools can be re-included below.
tools/*
# Committed, non-scratch tools (real deliverables, tracked normally):
!tools/discord-setup/
frontend/test-export.xlsx

# Training data and outputs (should not be committed)
backend/data/training/training-*.jsonl
backend/data/training/output-*/
backend/data/training/test-output/
backend/data/logs/training/

# Land-mask rasterizer cache (downloaded GeoJSON, regenerated on demand).
# The packed output at backend/data/land-mask.bin IS committed.
backend/data/.cache/

# Tool-generated directories (never commit)
.playwright-mcp/
.superpowers/
screenshots/
!ClaudeDesign/screenshots/

# Loose screenshots / lab renders / demo PNGs that accumulate at the
# repo root during sessions. Tracked PNGs (docs/images/, frontend/public/,
# test-samples/) are unaffected.
/*.png
/*.jpg
/*.jpeg

# Production logs (never commit)
ProdLogs/
.cursor
/.tmp/
.gitnexus
brand-smoke-shots/

# Playwright test artifacts (never commit)
/playwright-report/
/test-results/

# Private memory archive + backups (owner-local, never committed)
memory-archive/
memory-backup-*.tar.gz

# Internal roadmap board — the curated data layer and the generated page.
# The *.md rule above does NOT cover .yaml, so this must be explicit:
# without it the internal roadmap would be published to the public repo.
roadmap.local.yaml
.roadmap/
# Nor does the *.md rule cover a renamed *.md.archive (glob `*.md` only
# matches names ending in ".md" — verified with `git check-ignore`, it did
# NOT match). The archived hand-written roadmap carries the same real
# hosts/IPs as roadmap.local.yaml, so it needs the same explicit rule.
ROADMAP.local.md.archive

# Real boarding passes for local parser testing — personal data (name, PNR,
# FF number in the barcode). NEVER in this public repo; the private companion
# repo TravStats-local is the place if they need to be versioned at all.
test-samples/boarding-passes/

# Auto-generated JWT/encryption secrets and the logo cache. The backend writes
# them next to its working directory on first boot, so a stray start from the
# wrong folder drops them anywhere in the tree — a real secret nearly landed in
# a commit this way.
.travstats-data/
