{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travstats.de/schemas/suggestion-plugin/v1.schema.json",
  "title": "TravStats suggestion plugin contract, version 1",
  "description": "Exported from the TravStats server's OpenAPI document (scripts/export-plugin-contract.ts). Do not edit by hand. Request: what TravStats POSTs; response: what the plugin answers; hello: the optional signed GET; maintenance*: the optional location-maintenance capability.",
  "$defs": {
    "SuggestionPluginRequestV1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "stop",
            "test"
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "stop": {
          "$ref": "#/$defs/SuggestionPluginStopV1"
        },
        "locale": {
          "type": "string",
          "enum": [
            "de",
            "en"
          ]
        }
      },
      "required": [
        "version",
        "kind",
        "requestId",
        "stop",
        "locale"
      ]
    },
    "SuggestionPluginStopV1": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timeZone": {
          "type": "string",
          "maxLength": 64
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "precisionMeters": {
          "type": "integer",
          "minimum": 1
        },
        "nearestPlace": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 200
            },
            "distanceMeters": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "name",
            "distanceMeters"
          ]
        },
        "venue": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 200
            },
            "category": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "name"
          ]
        },
        "address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string",
              "maxLength": 200
            },
            "postcode": {
              "type": "string",
              "maxLength": 32
            },
            "town": {
              "type": "string",
              "maxLength": 200
            },
            "country": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      },
      "required": [
        "start",
        "end",
        "timeZone",
        "lat",
        "lon",
        "precisionMeters"
      ]
    },
    "SuggestionPluginResponseV1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SuggestionPluginSuggestionV1"
          },
          "maxItems": 5
        },
        "nameRadiusMeters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "version",
        "suggestions"
      ]
    },
    "SuggestionPluginSuggestionV1": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "purpose": {
          "type": "string",
          "enum": [
            "private",
            "business"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "externalRef": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "$ref": "#/$defs/SuggestionPluginExternalRefV1"
            }
          ]
        },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "enum": [
            "distance",
            "name"
          ]
        },
        "distanceMeters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "matchedToken": {
          "type": "string",
          "maxLength": 64
        },
        "lowPrecision": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "confidence"
      ]
    },
    "SuggestionPluginExternalRefV1": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "required": [
        "id"
      ]
    },
    "SuggestionPluginHelloV1": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 32
          },
          "maxItems": 10
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 32
          },
          "maxItems": 10
        },
        "list": {
          "type": "object",
          "properties": {
            "defaultName": {
              "type": "object",
              "properties": {
                "de": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "de",
                "en"
              ]
            },
            "refNamespace": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "de": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    },
                    "required": [
                      "de",
                      "en"
                    ]
                  }
                },
                "required": [
                  "key",
                  "label"
                ]
              },
              "maxItems": 6,
              "default": []
            }
          },
          "required": [
            "defaultName"
          ]
        }
      },
      "required": [
        "name",
        "version",
        "kinds"
      ]
    },
    "PluginMaintenanceStopV1": {
      "type": "object",
      "properties": {
        "venueName": {
          "type": "string",
          "maxLength": 200
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "venueName",
        "lat",
        "lon"
      ]
    },
    "PluginMaintenanceProposalsRequestV1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "locale": {
          "type": "string",
          "enum": [
            "de",
            "en"
          ]
        },
        "stops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginMaintenanceStopV1"
          },
          "maxItems": 2000
        },
        "query": {
          "type": "string",
          "maxLength": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "required": [
        "version",
        "requestId",
        "locale",
        "stops"
      ]
    },
    "PluginMaintenanceProposalV1": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "stop",
            "geocoder"
          ]
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "street": {
          "type": "string",
          "maxLength": 200
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "venueName": {
              "type": "string",
              "maxLength": 200
            },
            "stopStart": {
              "type": "string",
              "nullable": true,
              "maxLength": 40
            },
            "stopEnd": {
              "type": "string",
              "nullable": true,
              "maxLength": 40
            },
            "query": {
              "type": "string",
              "maxLength": 300
            },
            "label": {
              "type": "string",
              "maxLength": 200
            },
            "precision": {
              "type": "string",
              "maxLength": 16
            },
            "matchedTokens": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 64
              },
              "maxItems": 10
            },
            "distanceMeters": {
              "type": "integer",
              "minimum": 0
            },
            "agreesWithGeocoder": {
              "type": "boolean"
            },
            "agreesWithStop": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "source",
        "lat",
        "lon",
        "confidence"
      ]
    },
    "PluginMaintenanceRowV1": {
      "type": "object",
      "properties": {
        "rowId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "integer"
            }
          ]
        },
        "projNr": {
          "type": "string",
          "nullable": true,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "street": {
          "type": "string",
          "nullable": true,
          "maxLength": 200
        },
        "postcode": {
          "type": "string",
          "nullable": true,
          "maxLength": 32
        },
        "town": {
          "type": "string",
          "nullable": true,
          "maxLength": 200
        },
        "lat": {
          "type": "number",
          "nullable": true,
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "nullable": true,
          "minimum": -180,
          "maximum": 180
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "noCoordinates",
              "noStreet",
              "lowPrecision",
              "coordsMismatch"
            ]
          },
          "maxItems": 4
        },
        "ignored": {
          "type": "boolean"
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginMaintenanceProposalV1"
          },
          "maxItems": 10
        }
      },
      "required": [
        "rowId",
        "name",
        "issues",
        "proposals"
      ]
    },
    "PluginMaintenanceNoticeV1": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "enum": [
            "readOnly",
            "geocoderOff",
            "coordsMismatch",
            "ambiguousGeocoder",
            "severalStops"
          ]
        },
        "rowId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "integer"
            }
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "maxLength": 300
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "distanceMeters": {
          "type": "integer",
          "minimum": 0
        },
        "at": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ]
    },
    "PluginMaintenanceConfirmRequestV1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "apply",
            "undo"
          ]
        },
        "rowId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "street": {
          "type": "string",
          "maxLength": 200
        },
        "postcode": {
          "type": "string",
          "maxLength": 32
        },
        "town": {
          "type": "string",
          "maxLength": 200
        },
        "undoId": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "version",
        "requestId",
        "kind"
      ]
    },
    "PluginMaintenanceConfirmResponseV1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "token": {
          "type": "string",
          "maxLength": 200
        },
        "expiresAt": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "version",
        "token",
        "expiresAt"
      ]
    },
    "PluginMaintenanceAppliedV1": {
      "type": "object",
      "properties": {
        "undoId": {
          "type": "string",
          "maxLength": 64
        },
        "rowId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "integer"
            }
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "written": {
          "type": "object",
          "properties": {
            "Latitude": {
              "type": "number",
              "nullable": true
            },
            "Longitude": {
              "type": "number",
              "nullable": true
            },
            "Strasse": {
              "type": "string",
              "nullable": true,
              "maxLength": 200
            },
            "PLZ": {
              "type": "string",
              "nullable": true,
              "maxLength": 32
            },
            "Ort": {
              "type": "string",
              "nullable": true,
              "maxLength": 200
            }
          }
        },
        "previous": {
          "type": "object",
          "properties": {
            "Latitude": {
              "type": "number",
              "nullable": true
            },
            "Longitude": {
              "type": "number",
              "nullable": true
            },
            "Strasse": {
              "type": "string",
              "nullable": true,
              "maxLength": 200
            },
            "PLZ": {
              "type": "string",
              "nullable": true,
              "maxLength": 32
            },
            "Ort": {
              "type": "string",
              "nullable": true,
              "maxLength": 200
            }
          }
        },
        "source": {
          "type": "string",
          "maxLength": 16
        },
        "appliedAt": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "undoId",
        "rowId",
        "name",
        "written",
        "source",
        "appliedAt"
      ]
    },
    "PluginMaintenanceProposalsResponseV1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "array",
          "items": {
