          "maxItems": 300
        },
        "totalRows": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "applied": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginMaintenanceAppliedV1"
          },
          "maxItems": 200
        },
        "pendingSearches": {
          "type": "integer",
          "minimum": 0
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginMaintenanceNoticeV1"
          },
          "maxItems": 100
        },
        "noticeCount": {
          "type": "integer",
          "minimum": 0
        },
        "geocoder": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "rows"
      ]
    },
