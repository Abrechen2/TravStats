{
  "name": "travstats-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for a self-hosted TravStats instance (local stdio, personal access token).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "bin": {
    "travstats-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --banner:js='#!/usr/bin/env node' --outfile=dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
