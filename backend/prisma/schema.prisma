model AdminSettings {
  id Int @id @default(autoincrement())

  // Global API keys (encrypted at application level)
  globalOpenaiApiKey String? @map("global_openai_api_key")
  globalClaudeApiKey String? @map("global_claude_api_key")

  // Global flight lookup API keys (encrypted at application level)
  globalAirlabsApiKey       String?   @map("global_airlabs_api_key")
  globalAviationstackApiKey String?   @map("global_aviationstack_api_key")
  globalAerodataboxApiKey   String?   @map("global_aerodatabox_api_key")
  globalAeroapiApiKey       String?   @map("global_aeroapi_api_key")
  /// Push to the Companion app (TravStats#156). OFF until this server's admin
  /// agrees (owner decision 2026-10-01): with it off the server never
  /// contacts the relay, not even to register.
  pushEnabled               Boolean   @default(false) @map("push_enabled")
  /// When the admin switched push on — the record of the consent.
  pushConsentAt             DateTime? @map("push_consent_at")
  pushRelayUrl              String    @default("https://push.travstats.de") @map("push_relay_url")
  pushInstanceId            String?   @map("push_instance_id")
  /// encrypted at application level, like the API keys
  pushInstanceSecret        String?   @map("push_instance_secret")
  /// Set from the relay's Retry-After on a 429; no push before then.
  pushPausedUntil           DateTime? @map("push_paused_until")
  globalLogostreamApiKey    String?   @map("global_logostream_api_key")
  /// Google Places, the ONLY tier that finds a hotel by its business name
  /// where OpenStreetMap has no entry (measured: 27/30 vs 14/30). Off by
  /// default — the keyless chain stays the normal case, exactly like the FX
  /// CDN switch and the airline-logo tiers.
  globalGooglePlacesApiKey  String?   @map("global_google_places_api_key")
  globalOpenskyClientId     String?   @map("global_opensky_client_id")
  globalOpenskyClientSecret String?   @map("global_opensky_client_secret")
  globalOpenskyUsername     String?   @map("global_opensky_username")
  globalOpenskyPassword     String?   @map("global_opensky_password")

  // Global tour routing provider API keys (encrypted at application level,
  // Phase 3) — same per-user > global > ENV chain as the flight lookup keys.
  globalOpenrouteserviceApiKey String? @map("global_openrouteservice_api_key")
  globalGraphhopperApiKey      String? @map("global_graphhopper_api_key")

  /// Which routing provider computes routed leg geometry for tour routes
  /// (Phase 3): one of `"openrouteservice" | "graphhopper" | "custom"`
  /// (`RoutingProviderId`, services/tour/routing/types.ts), or null when
  /// routing is not configured at all. Deliberately a bare string rather than
  /// a Prisma enum — `RoutingProviderId` already owns the closed set in
  /// TypeScript, and Zod (`schemas/tour.ts`) validates it at the boundary; a
  /// duplicate DB-level enum would be a second place for that list to drift.
  routingProvider  String? @map("routing_provider")
  /// Base URL of a self-hosted OSRM instance, used only when
  /// `routingProvider == "custom"`. The "custom" provider takes no API key —
  /// see UserSettings/AdminSettings `*OpenrouteserviceApiKey` /
  /// `*GraphhopperApiKey` above, which have no "custom" counterpart.
  ///
  /// Validated as a plain http(s) URL by `normalizeRoutingCustomUrl`
  /// (schemas/tour.ts) with DELIBERATELY NO egress restriction — no block on
  /// loopback / link-local / private / RFC1918 hosts. This mirrors
  /// `normalizeImmichBaseUrl` (services/immich/types.ts) exactly and for the
  /// same reason: a self-hosted OSRM instance lives on the operator's LAN by
  /// design, so a private-IP filter would break the primary use case. The URL
  /// is admin-supplied, not attacker-chosen, in the single-tenant deployment
  /// this targets. Do not re-flag without changing that threat model.
  routingCustomUrl String? @map("routing_custom_url")

  // Which geo-tz dataset last derived the airport catalogue's time zones.
  // Until 2026-09-24 the default import was geo-tz's "now" dataset, which
  // folds zones that share TODAY's rules into one name: Bangkok became
  // Asia/Jakarta, Dublin Europe/London, Tahiti Pacific/Honolulu (526 airports
  // on a test catalogue, CAMP-03). "all" is the full set. Startup repairs the
  // stored zones once when this is not "all", then records it.
  airportTimezoneDataset String? @map("airport_timezone_dataset")

  // Global Immich connection (base URL plain, API key encrypted)
  globalImmichBaseUrl String? @map("global_immich_base_url")
  globalImmichApiKey  String? @map("global_immich_api_key")

  // Global Dawarich connection (base URL plain, API key encrypted, Phase 3b)
  globalDawarichBaseUrl String? @map("global_dawarich_base_url")
  globalDawarichApiKey  String? @map("global_dawarich_api_key")

  // The operator's own Strava API application (client secret encrypted).
  // TravStats ships no client id: since June 2026 Strava's standard API tier
  // needs a subscription, and a self-hosted instance registers its own app.
  stravaClientId     String? @map("strava_client_id")
  stravaClientSecret String? @map("strava_client_secret")

  // User permissions
  allowUserApiKeys       Boolean @default(true) @map("allow_user_api_keys")
  allowUserFlightApiKeys Boolean @default(true) @map("allow_user_flight_api_keys")

  // FX: whether a rate the ECB cannot serve may be fetched from the keyless
  // jsDelivr currency dataset. On by default because it needs no key and is
  // the only way to convert a currency outside the ECB's 30 — but a
  // self-hoster gets to decide whether their instance talks to jsDelivr at all.
  fxCdnFallbackEnabled Boolean @default(true) @map("fx_cdn_fallback_enabled")

  // Which reader gets the first look at a booking document, in EVERY domain:
  // "template_first" or "llm_first". Owner decision 2026-09-17, after the
  // paths were measured against the sample corpus: the template chain read
  // all 31 flight mails in under a second, gemma3:12b took 19 minutes and
  // missed three. Flight parsing used to be LLM-first while lodging and
  // cruise were template-first — one hardcoded order each, and no way to say
  // otherwise. This is that say, and it is the same say for all four domains.
  parserOrder String @default("template_first") @map("parser_order")

  // Whether this instance may ask a language model anything at all — parsing,
  // CSV mapping suggestions and trip summaries alike. Owner decision
  // 2026-09-25: before this, any configured Ollama (or a bare OLLAMA_URL in
  // the environment) was used and there was no way to say no, for privacy,
  // for a slow box, or for deterministic parses. On by default, so an
  // instance that has a model keeps using it; off means template/regex only,
  // enforced by `services/llm/llmGate.ts` in front of every model call.
  llmEnabled Boolean @default(true) @map("llm_enabled")

  // Aviationstack usage guard — max lookups per UTC day before falling
  // through to AirLabs/OpenSky. Default 3 keeps Free tier (100/month) safe.
  // Set to 0 to disable Aviationstack entirely.
  aviationstackDailyBudget Int @default(3) @map("aviationstack_daily_budget")

  // Ollama configuration (overrides OLLAMA_URL / OLLAMA_MODEL env vars)
  ollamaUrl         String? @map("ollama_url")
  ollamaModel       String? @map("ollama_model")
  ollamaVisionModel String? @map("ollama_vision_model")
  /// Consent for a REMOTE Ollama (the common local case never needs one) —
  /// its own flag, never borrowed from a cloud slot's consent.
  llmOllamaOptIn    Boolean @default(false) @map("llm_ollama_opt_in")

  /// beta.18: the fallback CHAIN's own priority among the four cloud slots,
  /// comma-separated (`services/llm/llmProvider.ts` `parseProviderOrder`).
  /// Ollama is not in this list — it is implicitly always tried first when it
  /// has an eligible endpoint. Replaced the single admin-picked "active
  /// provider" (`llmProvider`, beta.17): every enabled+consented slot is now
  /// tried in this order on a connectivity failure, not chosen exclusively.
  llmProviderOrder String @default("openai,anthropic,google,custom") @map("llm_provider_order")

  /// The `custom` slot (beta.17's `openai_compatible`): a free-form
  /// OpenAI-compatible endpoint — OpenRouter, Ollama Cloud, a LAN vLLM/LM
  /// Studio. Base URL INCLUDES its version path (e.g. https://api.openai.com/v1).
  /// https, except on a local/LAN host (`services/llm/llmEndpoint.ts`). Column
  /// names kept from beta.17 on purpose — the beta.18 migration maps existing
  /// rows onto this slot verbatim.
  openaiCompatBaseUrl String? @map("openai_compat_base_url")
  openaiCompatModel   String? @map("openai_compat_model")
  /// Encrypted at application level, masked on read — same as the other keys.
  openaiCompatApiKey  String? @map("openai_compat_api_key")
  /// The custom slot's OWN consent. Replaces beta.17's single `llmCloudOptIn`
  /// — the beta.18 migration copies that one flag onto this column, since it
  /// only ever gated this slot; the three NAMED cloud slots below start
  /// unconsented, never inheriting it.
  llmCustomOptIn      Boolean @default(false) @map("llm_custom_opt_in")

  /// OpenAI — fixed endpoint (`services/llm/llmProvider.ts` `OPENAI_BASE_URL`),
  /// so only a key and a model are asked for; no base-URL field.
  llmOpenaiApiKey String? @map("llm_openai_api_key")
  llmOpenaiModel  String? @map("llm_openai_model")
  llmOpenaiOptIn  Boolean @default(false) @map("llm_openai_opt_in")

  /// Anthropic — native Messages API (`services/llm/llmProvider.ts`
  /// `ANTHROPIC_BASE_URL`, `generateWithAnthropic`), fixed endpoint.
  llmAnthropicApiKey String? @map("llm_anthropic_api_key")
  llmAnthropicModel  String? @map("llm_anthropic_model")
  llmAnthropicOptIn  Boolean @default(false) @map("llm_anthropic_opt_in")

  /// Google — Gemini's own OpenAI-compatible endpoint (`GOOGLE_BASE_URL`),
  /// fixed, reusing the same request path as OpenAI/custom.
  llmGoogleApiKey String? @map("llm_google_api_key")
  llmGoogleModel  String? @map("llm_google_model")
  llmGoogleOptIn  Boolean @default(false) @map("llm_google_opt_in")

  // Backup schedule configuration (overrides AUTO_BACKUP_ENABLED / BACKUP_INTERVAL env vars)
  backupEnabled       Boolean   @default(false) @map("backup_enabled")
  backupInterval      String    @default("weekly") @map("backup_interval")
  backupRetentionDays Int       @default(30) @map("backup_retention_days")
  /// IANA zone the backup cron expression is read in (owner decision
  /// 2026-09-26). Null = the host zone the process booted with, which is what
  /// every instance ran in before the setting existed — so an upgrade keeps
  /// its backup hour.
  backupZone          String?   @map("backup_zone")
  /// ADR 0002 phase 3b: when the time-model backfill finished on this
  /// instance. Null = it has not run (or did not finish), and the next boot
  /// runs it; set = never again. Not a lock: the backfill is idempotent.
  timeModelBackfillAt DateTime? @map("time_model_backfill_at")

  // Instance configuration — supersedes INSTANCE_NAME / MAX_USERS /
  // ALLOW_REGISTRATION / FRONTEND_URL ENV variables. ENV is read as fallback
  // only when the column is null / unset (transitional for v1.x).
  instanceName      String? @map("instance_name")
  maxUsers          Int     @default(10) @map("max_users")
  allowRegistration Boolean @default(false) @map("allow_registration")
  frontendUrl       String? @map("frontend_url")

  // Public base URL the mobile app should talk to after pairing (e.g.
  // https://travstats.example.com). Surfaced by the device-pairing flow so a
  // freshly paired phone knows the externally reachable origin instead of the
  // LAN address the browser happened to be on. `lanUrl` is an optional
  // secondary hint for on-network clients.
  publicUrl String? @map("public_url")
  lanUrl    String? @map("lan_url")

  /// WebAuthn relying-party identity. Explicit rather than derived from the
  /// request Host: a credential is bound to this value forever, so guessing it
  /// from whichever origin happened to arrive would mint passkeys that stop
  /// working the moment the user switches between LAN and tunnel.
  ///
  /// ONE rpId, because a registration ceremony can only name one. Several
  /// ORIGINS may share it — an rpId may be a registrable parent domain, so
  /// `example.com` covers `app.example.com` and `www.example.com`. What it can
  /// never span is unrelated names, and a bare IP is not a valid rpId at all.
  webauthnRpId    String?  @map("webauthn_rp_id")
  /// Full origins (scheme + host + port) the browser may be on. A list, because
  /// @simplewebauthn verifies against `expectedOrigin: string[]` and this
  /// instance is routinely reached under more than one name.
  webauthnOrigins String[] @default([]) @map("webauthn_origins")

  // Geocoder endpoints — supersedes PHOTON_URL / NOMINATIM_URL ENV variables.
  // Defaults are the public instances (photon.komoot.io, OSM Nominatim); an
  // operator may point either at a self-hosted instance. Resolution order:
  // this column -> ENV -> default (see `resolveGeocoderUrls()`).
  photonUrl    String? @map("photon_url")
  nominatimUrl String? @map("nominatim_url")

  // Instance-level beta gate. OFF on production, ON on RC/Beta servers.
  // Reveals unfinished / not-yet-useful features (see
  // frontend/src/config/betaFeatures.ts for the registry of what it gates).
  // Admin-settable via PUT /api/v1/admin/instance-settings; every logged-in
  // user reads it (read-only) from GET /api/v1/settings.
  betaFeaturesEnabled Boolean @default(false) @map("beta_features_enabled")

  /// May this instance ask open data services on its users' behalf: historical
  /// weather and elevations from Open-Meteo, article summaries from Wikipedia /
  /// Wikidata, hotel tags from OpenStreetMap's Overpass API. OFF by default,
  /// because each call sends a place and a date to a third party, and the
  /// sign-in page promises that nothing leaves the instance unless it is set
  /// up (2026-09-24).
  openDataEnabled Boolean @default(false) @map("open_data_enabled")

  /// The instance's STARTING POINT for "a country counts as visited from …" —
  /// one of `COUNTRY_TIERS` (shared/countryEvidence.ts). Spec §3.2: a fresh
  /// account must not have to decide anything, so the admin picks the default;
  /// any user may then override it in their own settings
  /// (`UserSettings.countryThreshold`, where null means "follow this").
  ///
  /// Non-nullable with a default, deliberately: there is no ENV fallback and no
  /// "unset" state a caller has to handle, exactly like `betaFeaturesEnabled`.
  ///
  /// The default is "transited" — a connection does not count, and everything
  /// else does. That is the SAME rule the earlier default "visited" stated,
  /// re-spelled: while there were three rungs, "everything but the bottom one"
  /// was called `visited`; §3.4c added `transited` beneath it and renamed the
  /// bottom rung `connection`, so the same sentence is now spelled `transited`.
  /// Migration `20260902160000_country_tier_connection_rename` rewrites stored
  /// values along that mapping, so no instance's headline moves.
  countryThreshold String @default("transited") @map("country_threshold")

  /// May the rail train-number lookup ask Transitous (api.transitous.org) and
  /// db-rest (v6.db.transport.rest) on its users' behalf. Both ON by default:
  /// the lookup only runs when a user presses the button, and an admin whose
  /// instance must not talk to third parties switches either off here.
  railTransitousEnabled Boolean @default(true) @map("rail_transitous_enabled")
  railDbRestEnabled     Boolean @default(true) @map("rail_db_rest_enabled")
  /// Base URL of a self-hosted OpenRailRouting (GraphHopper on the OSM rail
  /// network). Null = off, the default: a rail journey without a Transitous
  /// trace then keeps the straight line and says so. When set, such a journey
  /// gets its line routed over the tracks between its stations, once, when it
  /// is saved (services/rail/openRailRouting.ts). Same threat model as
  /// `routingCustomUrl`: admin-supplied, may be a LAN host by design.
  railRoutingUrl        String? @map("rail_routing_url")

  // Off-site backup sync via WebDAV — supersedes WEBDAV_* ENV variables.
  // webdavPasswordEncrypted is AES-GCM via encryptApiKey() — never stored plain.
  webdavSyncEnabled       Boolean @default(false) @map("webdav_sync_enabled")
  webdavUrl               String? @map("webdav_url")
  webdavUsername          String? @map("webdav_username")
  webdavPasswordEncrypted String? @map("webdav_password_encrypted")
  webdavBackupPath        String  @default("/TravStats/backups/") @map("webdav_backup_path")

  // === LOGGING CONFIGURATION ===
  // Log level for file output (error | warn | info | debug | trace)
  logLevel String @default("info") @map("log_level")

  // Maximum file size before rotation (in MB)
  maxLogFileSize Int @default(10) @map("max_log_file_size")

  // Number of rotated log files to keep
  maxLogFiles Int @default(7) @map("max_log_files")

  // Enable request/response logging (captures full HTTP traffic)
  logHttpRequests Boolean @default(false) @map("log_http_requests")

  // Enable database query logging (captures SQL with parameters)
  logDatabaseQueries Boolean @default(false) @map("log_database_queries")

  // Enable parser operation logging (captures LLM requests/responses)
  logParserOperations Boolean @default(false) @map("log_parser_operations")

  // Log retention in days (auto-delete older logs)
  logRetentionDays Int @default(7) @map("log_retention_days")

  // === ANONYMOUS USAGE STATISTICS (opt-in) ===
  // Consent is instance-wide and admin-only. 'unset' | 'granted' | 'denied'.
  // Only 'granted' ever sends. The install id is a purely random uuid4 — never
  // derived from IP, hostname, MAC, or paths.
  usageStatsConsent   String  @default("unset") @map("usage_stats_consent")
  usageStatsInstallId String? @map("usage_stats_install_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_settings")
}

model TrainingData {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  /// Which KIND of document this sample is — 'flight' | 'lodging' | 'cruise' |
  /// 'place'. `type` beside it is the MEDIUM (a mail or a boarding pass) and
  /// never answered this; without the distinction the workshop derived every
  /// template as a flight template, which is what forgejo#124 phase 6 ends.
  /// Existing rows default to `flight` because that is the only value they
  /// could have had: nothing else was derivable before this column.
  domain        String    @default("flight")
  type          String // "email" | "boarding_pass"
  /// Who sent the sample, and what the message was called — read from the
  /// uploaded file's headers ONCE, at upload, and kept.
  ///
  /// The annotation blob cannot answer either question. For an `.eml` the
  /// extractor hands the workshop the BODY, header block removed, and the
  /// annotation view then saves it through `filterEmailText`, which strips
  /// every address it finds. So both anchor sources a lodging template needs
  /// — the sender's domain and the subject — were structurally absent by the
  /// time the deriver ran, and every browser upload abstained with
  /// `noDistinguishingMarker` (beta audit 2026-09-19, NOT FIXED 5).
  ///
  /// Null on a row written before this column existed and on a pasted sample
  /// that carries no header block; the deriver falls back to reading `From:`
  /// and `Subject:` out of the text, which is all it ever had.
  senderAddress String?   @map("sender_address")
  subject       String?
  originalFile  String    @map("original_file") // Path to uploaded file
  annotations   Json // Markierte Bereiche (Text-Selections oder Bounding Boxes)
  extractedData Json // Extrahierte Flight-Daten (als Ground Truth)
  status        String    @default("pending") // "pending" | "trained" | "failed"
  tags          String[]  @default([]) // Tags for filtering and organization
  trainedAt     DateTime? @map("trained_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("training_data")
}

model AirportSeedingStatus {
