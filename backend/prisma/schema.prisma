  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  flights        Flight[]
  bookings       Booking[]
  cruises        Cruise[]
  stops          TripStop[]
  routes         TripRoute[]
  journalEntries TripJournalEntry[]
  photos         TripPhoto[]
