// This is your Prisma schema file

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model User {
  id                  String              @id @default(uuid())
  username            String              @unique
  passwordHash        String              @map("password_hash")
  createdAt           DateTime            @default(now()) @map("created_at")
  flights             Flight[]
  userAchievements    UserAchievement[]

  @@map("users")
}

model Airport {
  id       Int     @id @default(autoincrement())
  iata     String? @unique
  icao     String? @unique
  name     String
  city     String?
  country  String?
  lat      Float
  lon      Float
  altitude Int?
  timezone String?

  @@index([iata])
  @@index([icao])
  @@index([name])
  @@index([city])
  @@map("airports")
}

model Flight {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  airline           String?
  flightNumber      String?  @map("flight_number")
  callsign          String?
  aircraft          String?
  depIcao           String?  @map("dep_icao")
  depIata           String?  @map("dep_iata")
  depName           String?  @map("dep_name")
  depLat            Float    @map("dep_lat")
  depLon            Float    @map("dep_lon")
  arrIcao           String?  @map("arr_icao")
  arrIata           String?  @map("arr_iata")
  arrName           String?  @map("arr_name")
  arrLat            Float    @map("arr_lat")
  arrLon            Float    @map("arr_lon")
  departureTime     DateTime @map("departure_time")
  arrivalTime       DateTime @map("arrival_time")
  status            String   @default("scheduled") // scheduled, flown, cancelled
  notes             String?
  // Boarding Pass Information
  seatNumber        String?  @map("seat_number")
  seatClass         String?  @map("seat_class") // economy, premium_economy, business, first
  boardingGroup     String?  @map("boarding_group")
  gate              String?
  terminal          String?
  bookingReference  String?  @map("booking_reference")
  ticketNumber      String?  @map("ticket_number")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([departureTime])
  @@index([status])
  @@index([airline])
  @@map("flights")
}

model Achievement {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  description      String
  category         String            // explorer, distance, collector, social, elite, special
  icon             String            // icon identifier
  tier             String            @default("bronze") // bronze, silver, gold, platinum, diamond
  requirement      Int               // numeric requirement for achievement
  requirementType  String            // flights_count, distance_km, countries, airlines, airports, continents, etc.
  points           Int               @default(10)
  isHidden         Boolean           @default(false) @map("is_hidden")
  createdAt        DateTime          @default(now()) @map("created_at")
  userAchievements UserAchievement[]

  @@index([category])
  @@index([tier])
  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  achievementId String      @map("achievement_id")
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")
  progress      Int         @default(0) // current progress towards achievement

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}
