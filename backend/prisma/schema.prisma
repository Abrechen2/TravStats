  appliedUpdates    Int      @default(0) @map("applied_updates")
  rejectedUpdates   Int      @default(0) @map("rejected_updates")
  editedUpdates     Int      @default(0) @map("edited_updates")
  expiredUpdates    Int      @default(0) @map("expired_updates")
  mostChangedFields Json     @map("most_changed_fields") // Map of field name to count
  averageUpdateTime Float?   @map("average_update_time") // minutes
  lastUpdated       DateTime @updatedAt @map("last_updated")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pending_update_statistics")
}

model ParserTemplate {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  domain      String   @default("flight")
  name        String
  status      String   @default("pending") // pending | active | disabled
  fingerprint Json
  patterns    Json
  stats       Json?
  sourceId    String?  @map("source_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  // The shape the matcher actually asks for since 2026-09-17 (forgejo#124):
  // this user's ACTIVE templates for the domain being parsed. The two indexes
  // below stay — `[userId, status]` still serves the workshop's own list, and
  // `[domain]` the per-domain counts.
  @@index([userId, domain, status])
  @@index([domain])
  @@map("parser_templates")
}

model Trip {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  name        String
  description String?
  color       String  @default("#818cf8") @map("color")

  // Phase-1 metadata redesign — see migration 20260509120000_trip_metadata.
  // All optional / defaulted so legacy rows stay valid.
  startDate          DateTime? @map("start_date")
  endDate            DateTime? @map("end_date")
  status             String    @default("planned") // planned | in_progress | completed
  /// ADR 0002 phase 2 dual-write: the local days of the first departure and
  /// the last arrival (owner decision 2026-09-26, plan open point 1), with the
  /// zone each belongs to. Null zone = a day typed without a place to anchor it.
  startDay           DateTime? @map("start_day") @db.Date
  endDay             DateTime? @map("end_day") @db.Date
  startZone          String?   @map("start_zone")
  endZone            String?   @map("end_zone")
  category           String? // vacation | business | weekend | family | other
  tags               String[]  @default([])
  companions         String[]  @default([])
  notes              String? // markdown long-form
  summary            String? // optional, may be LLM-generated later
  /// Who wrote `summary` (forgejo#132 item 8): "llm" (POST /trips/:id/summarize)
  /// or "user" (typed on create or PATCH). NULL = unknown — every summary
  /// written before the column existed, which may have been either, and a
  /// trip without a summary. Never back-filled as "user".
  summarySource      String?   @map("summary_source")
  /// When the model wrote the current summary; NULL unless `summarySource` is "llm".
  summaryGeneratedAt DateTime? @map("summary_generated_at")
  /// How many entries (flights, cruises, stays, place visits, stops, journal
  /// entries) the model was given; NULL unless `summarySource` is "llm".
  summaryEntryCount  Int?      @map("summary_entry_count")
  originLabel        String?   @map("origin_label")
  destinationLabel   String?   @map("destination_label")
  coverImageUrl      String?   @map("cover_image_url")
  icon               String?
  countries          String[]  @default([])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  flights        Flight[]
  bookings       Booking[]
  cruises        Cruise[]
  railJourneys   RailJourney[]
  rentalBookings RentalBooking[]
  stops          TripStop[]
  routes         TripRoute[]
  expenses       TripExpense[]
  journalEntries TripJournalEntry[]
  photos         TripPhoto[]
  lodgingStays   LodgingStay[]
  placeVisits    PlaceVisit[]
  immichAlbums   TripImmichAlbum[]
  companionLinks TripCompanion[]
  photoJourneys  PhotoJourney[]

  documents Document[]

  @@index([userId])
  @@index([userId, status])
  @@map("trips")
}

model TripPhoto {
  id        String    @id @default(uuid())
  tripId    String    @map("trip_id")
  filename  String
  mimetype  String
  sizeBytes Int       @map("size_bytes")
  caption   String?
  takenAt   DateTime? @map("taken_at")
  sortIdx   Int       @default(0) @map("sort_idx")
  createdAt DateTime  @default(now()) @map("created_at")

  // Immich provenance — set only for photos imported from a linked album.
  immichAssetId     String? @map("immich_asset_id")
  immichAlbumLinkId String? @map("immich_album_link_id")

  // EXIF coordinates (Phase C map layer). Populated on Immich import;
  // best-effort for manual uploads.
  lat Float?
  lon Float?

  /// The station (or timeline stop) this photo belongs to, linked for good
  /// rather than derived from `takenAt` — two stations on one day cannot be
  /// told apart by date (forgejo#139). Always a stop OF THIS TRIP: on its
  /// timeline (`TripStop.tripId`) or of a roadtrip filed on it
  /// (`TripStop.route.tripId`); `services/trips/photoStation.ts` holds that on
  /// every write, since a foreign key proves existence, not membership.
  /// SetNull — deleting a station keeps the photo on the trip.
  stopId String? @map("stop_id")

  trip         Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  immichAlbum  TripImmichAlbum?    @relation(fields: [immichAlbumLinkId], references: [id], onDelete: Cascade)
  stop         TripStop?           @relation(fields: [stopId], references: [id], onDelete: SetNull)
  visitLinks   PlaceVisitPhoto[]
  journalLinks JournalEntryPhoto[]

  @@unique([tripId, immichAssetId])
  @@index([tripId])
  @@index([tripId, sortIdx])
  @@index([immichAlbumLinkId])
  @@index([stopId])
  @@map("trip_photos")
}

model TripImmichAlbum {
  id               String    @id @default(uuid())
  tripId           String    @map("trip_id")
  immichAlbumId    String    @map("immich_album_id")
  albumName        String    @map("album_name")
  assetCount       Int       @default(0) @map("asset_count")
  thumbnailAssetId String?   @map("thumbnail_asset_id")
  mode             String    @default("link")
  sortIdx          Int       @default(0) @map("sort_idx")
  lastSyncedAt     DateTime? @map("last_synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  photos    TripPhoto[]
  importJob ImmichImportJob?

  @@unique([tripId, immichAlbumId])
  @@index([tripId])
  @@map("trip_immich_albums")
}

model ImmichImportJob {
  id              String    @id @default(uuid())
  albumLinkId     String    @unique @map("album_link_id")
  status          String    @default("pending") // pending | running | completed | failed
  totalAssets     Int       @default(0) @map("total_assets")
  processedAssets Int       @default(0) @map("processed_assets")
  failedAssets    Int       @default(0) @map("failed_assets")
  error           String?
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  albumLink TripImmichAlbum @relation(fields: [albumLinkId], references: [id], onDelete: Cascade)

  @@map("immich_import_jobs")
}

model TripStop {
  id            String    @id @default(uuid())
  /// The trip this stop sits on, or NULL for a stop that exists only as a
  /// vertex of a standalone tour. A stop always has one or the other —
  /// `trip_stops_trip_or_route` in the migration refuses a row with
  /// neither, because such a row would belong to nobody.
  tripId        String?   @map("trip_id")
  orderIdx      Int       @default(0) @map("order_idx")
  // Free-form DomainKey-style label so the timeline picks the right
  // colour ("poi", "hotel", "train", "hike", …). Null means "generic".
  domain        String?
  // Optional id of an existing flight/cruise/etc. that this stop wraps.
  sourceId      String?   @map("source_id")
  title         String
  description   String?
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  lat           Float?
  lon           Float?
  /// ADR 0002 phase 2 dual-write: `startDate`/`endDate` keep their old
  /// meaning (the stop's wall clock stored as if it were UTC); these hold the
  /// real instants, the zone of the stop (its coordinates or the entry it
  /// wraps) and the precision. Null zone + precision `unknown` = no place to
  /// read a clock at.
  startUtc      DateTime? @map("start_utc")
  endUtc        DateTime? @map("end_utc")
  stopZone      String?   @map("stop_zone")
  precision     String?
  notes         String?
  /// Route membership. NULL means what every stop is today: a timeline
  /// point that produces no kilometres. Set means it is a vertex of that
  /// route section. Nothing derives this — see the migration note.
  routeId       String?   @map("route_id")
  /// Position WITHIN the route, 0-based and contiguous. Written only by
  /// PUT /trips/:id/routes/:routeId/stops, never by a client.
  routeOrderIdx Int?      @map("route_order_idx")
  /// Roadtrip station: the stay slept in here. SetNull — deleting the stay
  /// keeps the station, which then reads as a free night (`overnight` stays
  /// true), because the night still happened. The stay never points back:
  /// the stay owns the night (design 2026-09-24 §2).
  lodgingStayId String?   @map("lodging_stay_id")
  /// Roadtrip station: a night was spent here. With `lodgingStayId` it is a
  /// "stay" station; without it a "free" one (a pitch with no accommodation
  /// record); false is a pass-through. Derived, never stored as an enum — a
  /// stored enum plus the SetNull above would need a CHECK that the cascade
  /// itself then violates (the trap migration 20260921195505 met).
  overnight     Boolean   @default(false)
  /// A route correction ("Streckenkorrektur", tester 2026-09-26): a point
  /// with no name of its own that exists only to bend the route between its
  /// neighbours. Legs run through it like through any vertex, so distances
  /// and routing honour it; everything that COUNTS stations (the station
  /// count, countries, nights, days away, achievements, the phone's list, the
  /// dashboard markers) leaves it out. Never overnight and never a stay —
  /// `trip_stops_via_point_passes` holds that in the database.
  viaPoint      Boolean   @default(false) @map("via_point")
  /// Roadtrip pass-through: the user's own place (POI) it passed, as a stay
  /// station names its stay (tester 2026-09-26). SetNull — deleting the
  /// place leaves the pass-through standing. Only on a pass-through:
  /// `trip_stops_place_on_pass` holds that in the database.
  placeId       String?   @map("place_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  trip            Trip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  /// Cascade, and the delete handler does the other half.
  ///
  /// The two cases want opposite things and the database can only be told
  /// one: a stop of a TRIP must survive its section being deleted (a tour
  /// is scaffolding over the timeline, and the delete confirmation says
  /// so), while a stop of a STANDALONE tour must not, because it would be
  /// left owned by nobody and reachable from nothing — which
  /// `trip_stops_trip_or_route` refuses to store anyway.
  ///
  /// SetNull was the other way round and broke on the harder path: dropping
  /// a USER cascades the sections away, SetNull then tries to strand their
  /// trip-less stops, and the CHECK rejects the cascade itself. So the
  /// cascade handles the orphans and the delete handler releases the trip's
  /// stops BEFORE deleting the section (`tourRoutes.ts`). Deleting a
  /// section any other way than through that handler takes its stops with
  /// it — which is what every other caller (seeds, account deletion) wants.
  route           TripRoute?     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  legsFrom        TripRouteLeg[] @relation("LegFrom")
  legsTo          TripRouteLeg[] @relation("LegTo")
  lodgingStay     LodgingStay?   @relation(fields: [lodgingStayId], references: [id], onDelete: SetNull)
  place           Place?         @relation(fields: [placeId], references: [id], onDelete: SetNull)
  /// Tours that started from this station ("Preikestolen, from Mosvangen").
  anchoredTours   TripRoute[]    @relation("TourAnchor")
  /// Trip photos filed at this station (forgejo#139).
  photos          TripPhoto[]
  expenses        TripExpense[]  @relation("ExpenseStop")
  expensesLegFrom TripExpense[]  @relation("ExpenseLegFrom")
  expensesLegTo   TripExpense[]  @relation("ExpenseLegTo")

  @@unique([routeId, routeOrderIdx])
  @@index([tripId])
  @@index([tripId, orderIdx])
  @@index([routeId])
  @@index([lodgingStayId])
  @@index([placeId])
  @@map("trip_stops")
}

/// A named, ordered route section inside a trip: "Norwegen mit dem
/// Wohnmobil", "Besseggen-Wanderung", "Fähre nach Hirtshals".
///
/// A trip may hold several. A section may be a LOOP — its first and last
/// stop may be the same place — which is what makes a day hike from a base
/// camp expressible. The vehicle link arrives with phase 2.
model TripRoute {
  id       String  @id @default(uuid())
  /// The owner, held DIRECTLY rather than read through the trip.
  ///
  /// A tour may stand on its own since 2026-09-21 (owner ruling: "Sie
  /// können auch einzeln leben"), and a tour with no trip has no trip to
  /// read an owner from. Holding it here also means authorisation never
  /// depends on a join that a later query might forget — a foreign key
  /// proves existence, not ownership.
  userId   String  @map("user_id")
  /// The trip this section belongs to, or NULL for a standalone tour.
  tripId   String? @map("trip_id")
  name     String
  /// Default mode for legs created in this section:
  /// road | ferry | rail | foot | bike
  mode     String
  orderIdx Int     @default(0) @map("order_idx")
  color    String?
  notes    String?

  /// Odometer at section start and end. Deliberately NOT reconciled with
  /// the sum of the legs: the difference is the finding.
  startOdometerKm Int? @map("start_odometer_km")
  endOdometerKm   Int? @map("end_odometer_km")

  /// "tour" | "roadtrip" (design 2026-09-24). Decides which page owns the
  /// row and which of the fields below mean anything; every leg, track and
  /// routing feature is kind-agnostic, which is the point of one engine.
  kind                      String    @default("tour")
  /// Tour only: hike | walk | run | bike | mtb | ski | paddle | climb | other.
  activity                  String?
  /// Roadtrip only: motorhome | campervan | caravan | car | motorcycle |
  /// bicycle | rail | other. A free field on purpose (owner, 2026-09-24): a
  /// vehicle catalog waits until someone asks for per-vehicle figures.
  vehicle                   String?
  vehicleName               String?   @map("vehicle_name")
  /// Tour only: the roadtrip station this day trip set out from.
  anchorStopId              String?   @map("anchor_stop_id")
  /// Set on rows the 2.7 migration classified by rule. The UI lists them
  /// once so a misfiled row can be moved; confirming or switching clears it.
  kindAssignedAutomatically Boolean   @default(false) @map("kind_assigned_automatically")
  /// Tour only: the local day the day tour happened, at its place (ADR 0002:
  /// a DATE, crossing code boundaries as "YYYY-MM-DD"). Set by the user, or
  /// prefilled from the first recorded track's start. Without it a standalone
  /// tour had no day at all, and the trip suggestions could never place it
  /// (acceptance D2, 2026-09-26).
  tourDate                  DateTime? @map("tour_date") @db.Date
  /// Tour only: when on `tourDate` it started, in minutes after local
  /// midnight at its place, as the user entered it. A tour is created before
  /// it has a point, so no zone can be resolved at write time; the instant is
  /// derived from the place when needed, never stored beside this.
  tourStartMinute           Int?      @map("tour_start_minute")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip       Trip?            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  anchorStop TripStop?        @relation("TourAnchor", fields: [anchorStopId], references: [id], onDelete: SetNull)
  stops      TripStop[]
  legs       TripRouteLeg[]
  tracks     TripRouteTrack[]
  expenses   TripExpense[]
  /// Rental cars this roadtrip was driven in (rental spec §7.2).
  rentals    RentalBooking[]

  @@index([userId])
  @@index([userId, kind])
  @@index([tripId])
  @@index([anchorStopId])
  @@map("trip_routes")
}

/// One leg of one section.
///
/// Keyed by its two ENDPOINT STOPS, never by an ordinal — the lesson
/// `CruiseLegRoute` records: keying by position means inserting a stop
/// shifts every stored line one leg along, and the map then looks like the
/// router broke. With endpoint keying an inserted stop leaves its
/// neighbours' stored geometry untouched.
model TripRouteLeg {
  id         String @id @default(uuid())
  routeId    String @map("route_id")
  fromStopId String @map("from_stop_id")
  toStopId   String @map("to_stop_id")

  distanceKm Float  @map("distance_km")
  /// straight | drawn (phase 1). routed | track arrive in phase 3.
  source     String
  /// road | ferry | rail | foot | bike. Per LEG, not per section: a road
  /// tour with one ferry crossing must not count it as motorway km.
  mode       String
  /// low | medium | high, mirroring CruiseLeg.
  confidence String @default("medium")

  /// `[[lon, lat], …]` in GeoJSON order. Null when source is `straight`.
  waypoints      Json?
  drivingMinutes Int?  @map("driving_minutes")
  // The toll that used to live here (`toll_cost` + `currency`) is a
  // `TripExpense` of kind `toll` since forgejo#140 — one source for totals.

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  route    TripRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  fromStop TripStop  @relation("LegFrom", fields: [fromStopId], references: [id], onDelete: Cascade)
  toStop   TripStop  @relation("LegTo", fields: [toStopId], references: [id], onDelete: Cascade)

  @@unique([routeId, fromStopId, toStopId])
  @@index([routeId])
  @@map("trip_route_legs")
}

/// Money spent on the way (forgejo#140, owner 2026-10-01): a ferry ticket, a
/// toll, a pitch fee, fuel. Belongs to EXACTLY one of a trip (trip-wide, "the
/// vignette") or a route section (a roadtrip or tour) — `trip_expenses_one_scope`
/// holds that in the database. A route-scoped expense deliberately does not
/// copy the route's trip: a roadtrip can move between trips, and a copied id
/// would keep billing the trip it left.
///
/// Optionally pinned to a station (`stopId`) or to the way between two
/// (`legFromStopId` → `legToStopId`, a toll or a ferry). All three are SetNull:
/// deleting a station keeps the money, which still was spent. That is also why
/// no CHECK pairs the two leg ends — the cascade clears one at a time, the
/// trap migration 20260921195505 met.
///
/// Totals are per currency and never summed across them: unlike a stay, an
/// expense carries no FX snapshot.
model TripExpense {
  id            String    @id @default(uuid())
  /// The owner, held directly (see `TripRoute.userId`): a FK proves existence, not ownership.
  userId        String    @map("user_id")
  tripId        String?   @map("trip_id")
  routeId       String?   @map("route_id")
  stopId        String?   @map("stop_id")
  legFromStopId String?   @map("leg_from_stop_id")
  legToStopId   String?   @map("leg_to_stop_id")
  /// ferry | toll | pitch | fuel | parking | other — `EXPENSE_KINDS`, CHECKed.
  kind          String
  amount        Decimal   @db.Decimal(16, 4)
  /// ISO 4217, upper-case.
  currency      String
  /// The local calendar day it was paid (ADR 0002: a DATE, "YYYY-MM-DD"), or
  /// null when not known — then it counts in totals and in no year.
  date          DateTime? @db.Date
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip        Trip?      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  route       TripRoute? @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop        TripStop?  @relation("ExpenseStop", fields: [stopId], references: [id], onDelete: SetNull)
  legFromStop TripStop?  @relation("ExpenseLegFrom", fields: [legFromStopId], references: [id], onDelete: SetNull)
  legToStop   TripStop?  @relation("ExpenseLegTo", fields: [legToStopId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tripId])
  @@index([routeId])
  @@index([stopId])
  @@index([legFromStopId])
  @@index([legToStopId])
  @@map("trip_expenses")
}

/// A recorded track. Hangs off the SECTION and a time window, never off a
/// leg: a GPX file knows nothing about the user's stops, and forcing it
/// into the leg structure on import loses data. Legs may later take their
/// distance from an overlapping track (§7.3); the track itself stays whole.
model TripRouteTrack {
  id            String   @id @default(uuid())
  routeId       String   @map("route_id")
  source        String // gpx | dawarich
  name          String?
  startedAt     DateTime @map("started_at")
  endedAt       DateTime @map("ended_at")
  /// GeoJSON LineString coordinates, already simplified on import.
  geometry      Json
  /// Index into `geometry` where each RECORDING segment starts, always
  /// beginning at 0. GPX separates continuous stretches of recording with
  /// `<trkseg>`, and the gap between two of them is exactly what was NOT
  /// recorded. Flattening them into one line made every gap a straight
  /// stretch that the distance counted as travelled (AUD-033). Null on rows
  /// written before the boundaries were carried — read as a single segment.
  segmentStarts Json?    @map("segment_starts")
  /// Running RAW distance in km at each vertex of `geometry`, from the start.
  /// The stored line is simplified, so re-measuring it is short by however
  /// many corners were cut — a leg adopting the whole track came out 7% under
  /// the number shown beside it, and the raw measurement was unrecoverable
  /// from two remaining points (AUD-034). With this, any sub-range is a
  /// subtraction against raw data. Null on rows written before it existed;
  /// those fall back to measuring the simplified line, as they always did.
  cumulativeKm  Json?    @map("cumulative_km")
  pointCount    Int      @map("point_count")
  distanceKm    Float    @map("distance_km")
  /// True when a Dawarich pull hit `MAX_PAGES` (dawarichClient.ts) and the
  /// stored points are therefore a PARTIAL window, not the full requested
  /// span — the newest points only, per Dawarich's measured ordering. Always
  /// false for `source = "gpx"`, which refuses an oversized file outright
  /// instead of storing a silently-shortened one. Surfaced in the API
  /// response and in `TourTrackList` so a partial track's distance is never
  /// presented with the same confidence as a complete one.
  truncated     Boolean  @default(false)
  /// The elevation PROFILE: `[km, metres]` pairs sampled from the raw points
  /// (low and high per distance bucket), NOT aligned with `geometry` — the
  /// simplified line drops the summits a profile exists to show. Null when
  /// the source had no elevation, and on rows written before.
  elevations    Json?
  /// Climb and descent in metres, measured on the RAW points with a
  /// hysteresis — never on the simplified line, which cuts exactly the
  /// small climbs a hike is made of (`services/tour/tracks/trackMetrics.ts`).
  ascentM       Float?   @map("ascent_m")
  descentM      Float?   @map("descent_m")
  /// Seconds spent actually moving. Null when the points carry no times.
  movingSeconds Int?     @map("moving_seconds")
  /// The source record's own id (a HealthKit workout UUID, a Strava activity
  /// id), so importing the same workout twice is one track, not two.
  externalRef   String?  @map("external_ref")
  createdAt     DateTime @default(now()) @map("created_at")

  route TripRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, externalRef])
  @@index([routeId])
  @@map("trip_route_tracks")
}

model TripJournalEntry {
  id              String    @id @default(uuid())
  tripId          String    @map("trip_id")
  date            DateTime
  title           String?
  /// ADR 0002 phase 2 dual-write: the journal day as a calendar day. `date`
  /// keeps its UTC-midnight meaning until phase 6.
  day             DateTime? @db.Date
  body            String
  mood            String?
  weather         String?
  /// The day's measured weather at the trip's stop on `date`, from Open-Meteo:
  /// `{ code, tMaxC, tMinC, precipMm, place, lat, lon, source, fetchedAt }`.
  /// Kept apart from `weather`, which is the author's own words and is counted
  /// as such by the trip statistics. Null until fetched, or when no stop of
  /// the trip gives that day a place.
  observedWeather Json?     @map("observed_weather")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  trip   Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  photos JournalEntryPhoto[]

  @@index([tripId])
  @@index([tripId, date])
  @@map("trip_journal_entries")
}

/// A photograph of the trip's gallery shown in a journal entry. A join, not a
/// copy: the picture stays the trip's, and the entry only points at it. Both
/// ends cascade — an entry without the photo, or a photo without the entry,
/// leaves nothing to show. Only a photo of the entry's own trip is accepted
/// (checked in the route; the keys prove existence, not the trip).
model JournalEntryPhoto {
  id          String @id @default(uuid())
  entryId     String @map("entry_id")
  tripPhotoId String @map("trip_photo_id")
  sortIdx     Int    @default(0) @map("sort_idx")

  entry     TripJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tripPhoto TripPhoto        @relation(fields: [tripPhotoId], references: [id], onDelete: Cascade)

  @@unique([entryId, tripPhotoId])
  @@index([tripPhotoId])
  @@map("journal_entry_photos")
}

model Booking {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  tripId   String? @map("trip_id")
  pnr      String?
  price    Float?
  currency String? @default("EUR")

  /// FX snapshot (#267) — same contract as `Flight`. A booking's price counts
  /// once for the whole booking rather than once per segment, so the cost
  /// aggregates read this instead of the segments' own prices; without a
  /// snapshot here a multi-currency logbook could not be totalled honestly
  /// either. Dated by `createdAt`, the only day a booking carries.
  priceBase      Float?    @map("price_base")
  fxRate         Float?    @map("fx_rate")
  fxRateDate     DateTime? @map("fx_rate_date")
  fxBaseCurrency String?   @map("fx_base_currency")
  fxSource       String?   @map("fx_source")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip         Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  flights      Flight[]
  cruises      Cruise[]
  railJourneys RailJourney[]
  lodgingStays LodgingStay[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([tripId])
  @@map("bookings")
}

model Cruise {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  shipId           Int?      @map("ship_id")
  shipNameOverride String?   @map("ship_name_override")
  cruiseLine       String?   @map("cruise_line")
  departurePortId  Int?      @map("departure_port_id")
  arrivalPortId    Int?      @map("arrival_port_id")
  routeName        String?   @map("route_name")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  /// ADR 0002 phase 2 dual-write: embarkation and disembarkation as local
  /// days, with the zone of the departure / arrival port.
  startDay         DateTime? @map("start_day") @db.Date
  endDay           DateTime? @map("end_day") @db.Date
  startZone        String?   @map("start_zone")
  endZone          String?   @map("end_zone")
  status           String    @default("scheduled")
  cabinNumber      String?   @map("cabin_number")
  cabinType        String?   @map("cabin_type")
  deck             Int?
  bookingReference String?   @map("booking_reference")
  price            Float?
  currency         String?   @default("EUR")
  /// FX snapshot (#267), same contract as `Flight`/`Booking` — `Cruise` was
  /// the only priced model without one, which is what let a 200.000 KRW
  /// cruise beat a 1.650 EUR trip on the trips page (compared by raw face
  /// value across currencies). Rate for the START day; no backfill for
  /// historical rows — an invented rate is worse than an absent one, so a
  /// pre-migration cruise simply reports null here and is left out of any
  /// base-currency comparison rather than guessed at.
  priceBase        Float?    @map("price_base")
  fxRate           Float?    @map("fx_rate")
  fxRateDate       DateTime? @map("fx_rate_date")
  fxBaseCurrency   String?   @map("fx_base_currency")
  fxSource         String?   @map("fx_source")
  notes            String?
  tags             String[]  @default([])
  companions       String[]  @default([])
  tripId           String?   @map("trip_id")
  bookingId        String?   @map("booking_id")
  parserTemplate   String?   @map("parser_template")
  parserConfidence Int?      @map("parser_confidence")
  dataSource       String?   @map("data_source")
  // Optional user-selectable map color (hex, e.g. "#e88374"). Nullable —
  // null means "auto-derive from cruise id" (see resolveCruiseColor on the
  // frontend). Unlike Trip.color, there is no default so existing rows stay
  // null and keep their derived color.
  color            String?   @map("color")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ship          Ship?            @relation(fields: [shipId], references: [id], onDelete: SetNull)
  departurePort Port?            @relation("CruiseDeparture", fields: [departurePortId], references: [id], onDelete: SetNull)
  arrivalPort   Port?            @relation("CruiseArrival", fields: [arrivalPortId], references: [id], onDelete: SetNull)
  trip          Trip?            @relation(fields: [tripId], references: [id], onDelete: SetNull)
  booking       Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  stops         CruiseStop[]
  legs          CruiseLeg[]
  legRoutes     CruiseLegRoute[]
  tracks        CruiseTrack[]

  /// Where this row came from, so a second import of the same file recognises
  /// it instead of duplicating it (#84). Format `<source>:<stable key>`; the
  /// key must identify THIS entry, never just the booking — a return leg
  /// shares its PNR with the outbound one, and a unique constraint on the
  /// booking alone would silently refuse the second half of every trip.
  externalRef   String? @map("external_ref")
  importBatchId String? @map("import_batch_id")

  companionLinks CruiseCompanion[]
  importBatch    ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  documents Document[]

  @@unique([userId, externalRef])
  @@index([userId])
  @@index([startDate])
  @@index([status])
  @@index([cruiseLine])
  @@index([tripId])
  @@index([bookingId])
  @@index([importBatchId])
  @@map("cruises")
}

model CruiseLeg {
  id            String   @id @default(uuid())
  cruiseId      String   @map("cruise_id")
  ordinal       Int
  fromPortId    Int      @map("from_port_id")
  toPortId      Int      @map("to_port_id")
  distanceKm    Float    @map("distance_km")
  method        String
  routerVersion String   @map("router_version")
  dataVersion   String?  @map("data_version")
  confidence    String   @default("medium")
  notes         String?
  computedAt    DateTime @default(now()) @map("computed_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cruise   Cruise @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  fromPort Port   @relation("CruiseLegFromPort", fields: [fromPortId], references: [id], onDelete: Restrict)
  toPort   Port   @relation("CruiseLegToPort", fields: [toPortId], references: [id], onDelete: Restrict)

  @@unique([cruiseId, ordinal])
  @@index([cruiseId])
  @@index([fromPortId])
  @@index([toPortId])
  @@index([method])
  @@map("cruise_legs")
}

/// A hand-corrected route for one leg of one cruise.
///
/// Keyed by the leg's two ENDPOINTS, never by its ordinal: keying by position
/// means inserting a port shifts every stored line one leg along, and the map
/// then looks like the router broke. With endpoint keying an itinerary change
/// simply leaves the row unmatched and inert.
///
/// Consequence accepted on purpose: if the same directed pair occurs twice in
/// one itinerary, both occurrences render the same corrected line — which is
/// almost always what the user meant.
///
/// A row is never deleted by an itinerary change, only unmatched — so
/// undoing the change (e.g. removing a stop, then re-adding it with the same
/// endpoints) brings the old corrected line back automatically. Nothing
/// tells the user this resurrection happened.
model CruiseLegRoute {
  id       String @id @default(uuid())
  cruiseId String @map("cruise_id")

  /// 'port' today. 'place' arrives with the private-place stage; the column
  /// exists now so that stage adds rows rather than migrating every stored line.
  fromKind String @map("from_kind")
  /// The endpoint's id as text — a Port id today.
  fromRef  String @map("from_ref")
  toKind   String @map("to_kind")
  toRef    String @map("to_ref")

  /// `[[lon, lat], ...]` in GeoJSON order, 2..64 points, first and last equal
  /// to the leg's endpoints (within 1 km, to allow for coordinate rounding).
  /// Zod (`routeOverrideSchema`) validates count and coordinate ranges; the
  /// endpoint anchor itself is checked in the `PUT` handler
  /// (`routes/cruises.ts`), because it needs the leg's port coordinates from
  /// the database — something a Zod schema cannot see.
  waypoints Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cruise Cruise @relation(fields: [cruiseId], references: [id], onDelete: Cascade)

  @@unique([cruiseId, fromKind, fromRef, toKind, toRef])
  @@index([cruiseId])
  @@map("cruise_leg_routes")
}

/// A recorded track of a cruise (2.7): a GPS recording of the voyage, uploaded
/// as a file or pulled from Dawarich.
///
/// Hangs off the CRUISE and a time window, never off a leg — the same rule
/// `TripRouteTrack` follows, for the same reason: a recording knows nothing
/// about the itinerary, and one file usually spans several legs. Which legs it
/// covers is decided on read, from the geometry, by
/// `services/trackCoverage/legCoverage.ts`; nothing per leg is stored here, so
/// an itinerary change re-decides coverage instead of leaving a stale link.
///
/// A table of its own rather than a nullable `cruiseId` on `TripRouteTrack`:
/// every tour path (ownership, archive, Strava, export) reads that table's
/// `routeId` as non-null, and a second owner column would make each of them
/// answer "which owner?" first. The COLUMNS are the same on purpose, and both
/// are written through `ingestedTrackColumns`, so the pipeline stays one.
/// Elevation, climb and moving time are left out: at sea they measure nothing.
model CruiseTrack {
  id            String   @id @default(uuid())
  cruiseId      String   @map("cruise_id")
  /// gpx | tcx | fit | dawarich | healthkit | healthconnect
  source        String
  name          String?
  startedAt     DateTime @map("started_at")
  endedAt       DateTime @map("ended_at")
  /// GeoJSON LineString coordinates, simplified on import.
  geometry      Json
  /// Index into `geometry` where each recording segment starts. Besides the
  /// file's own segments, a cruise import also breaks the line wherever two
  /// consecutive points lie further apart than `CRUISE_TRACK_GAP_KM` — a phone
  /// at sea is offline for hours, and the jump across is not a recording.
  segmentStarts Json     @map("segment_starts")
  /// Running RAW distance in km at each vertex of `geometry`; a step across a
  /// segment boundary adds nothing (see `ingestTrack`).
  cumulativeKm  Json     @map("cumulative_km")
  pointCount    Int      @map("point_count")
  distanceKm    Float    @map("distance_km")
  /// A Dawarich pull that hit its page cap — see `TripRouteTrack.truncated`.
  truncated     Boolean  @default(false)
  /// The source record's own id, so the same export imported twice is one track.
  externalRef   String?  @map("external_ref")
  createdAt     DateTime @default(now()) @map("created_at")

  cruise Cruise @relation(fields: [cruiseId], references: [id], onDelete: Cascade)

  @@unique([cruiseId, externalRef])
  @@index([cruiseId])
  @@map("cruise_tracks")
}

/// A flight as the passenger's phone recorded it (Companion background GPS,
/// forgejo#193). A table of its own and never `Flight.actualRoute`: a provider
/// lookup overwrites that column, and a recording is the one line no provider
/// can supply again (owner decision D5, 2026-10-01).
///
/// ONE per flight — a second recording of the same flight replaces this one
/// only when the client asks for it explicitly. The columns are `CruiseTrack`'s
/// and are written through `ingestedTrackColumns`, so the pipeline stays one;
/// the altitude profile is kept (a flight's climb is what it is), speed is not.
model FlightTrack {
  id            String   @id @default(uuid())
  flightId      String   @unique @map("flight_id")
  /// companion
  source        String
  /// The client's id for this upload. A retry from the phone's outbox sends
  /// the same id and is answered with the stored row instead of a second one.
  uploadId      String   @map("upload_id")
  /// The paired device that sent it (`ApiToken.deviceId`); null from a browser.
  deviceId      String?  @map("device_id")
  startedAt     DateTime @map("started_at")
  endedAt       DateTime @map("ended_at")
  /// GeoJSON LineString coordinates, simplified on ingest.
  geometry      Json
  /// Index into `geometry` where each recording segment starts. A phone in a
  /// cabin loses its fix for long stretches; a step longer than
  /// `FLIGHT_TRACK_GAP_KM` is such a hole, not a recording.
  segmentStarts Json     @map("segment_starts")
  /// Running RAW distance in km at each vertex of `geometry`.
  cumulativeKm  Json     @map("cumulative_km")
  /// `[km, metres]` altitude profile from the raw points; null without altitudes.
  elevations    Json?
  pointCount    Int      @map("point_count")
  distanceKm    Float    @map("distance_km")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@map("flight_tracks")
}

model CruiseStop {
  id                 String    @id @default(uuid())
  cruiseId           String    @map("cruise_id")
  portId             Int?      @map("port_id")
  dayNumber          Int       @map("day_number")
  date               DateTime?
  isAtSea            Boolean   @default(false) @map("is_at_sea")
  arrivalTime        DateTime? @map("arrival_time")
  departureTime      DateTime? @map("departure_time")
  /// Read by the statistics ETag (forgejo#50).
  /// ADR 0002 phase 2 dual-write: `arrivalTime`/`departureTime` keep their
  /// old meaning (the port's wall clock stored as if it were UTC) and `date`
  /// its UTC-midnight day; these hold the real instants, the port's zone,
  /// the call's local day and the precision. A sea day or an unresolved port
  /// has no zone: its times stay in the legacy columns, precision `unknown`.
  arrivalUtc         DateTime? @map("arrival_utc")
  departureUtc       DateTime? @map("departure_utc")
  stopZone           String?   @map("stop_zone")
  stopDate           DateTime? @map("stop_date") @db.Date
  timePrecision      String?   @map("time_precision")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  excursionNote      String?   @map("excursion_note")
  /// "All aboard" (forgejo#223): the latest time to be back on the ship at
  /// this port, `HH:mm` on the PORT's clock, on the stop's own day. Only ever
  /// what the user typed from the ship's daily programme — it is never derived
  /// from the departure, because the gap between the two differs by line and
  /// port, and a guessed time to be back on board is worse than none.
  allAboardTime      String?   @map("all_aboard_time")
  // Third stop state: a port whose name could not be matched to the catalog on
  // import. portId=null AND isAtSea=false AND this set => unresolved port.
  unresolvedPortName String?   @map("unresolved_port_name")

  cruise Cruise @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  port   Port?  @relation(fields: [portId], references: [id], onDelete: SetNull)

  @@index([cruiseId])
  @@index([portId])
  @@map("cruise_stops")
}

model Ship {
  id           Int     @id @default(autoincrement())
  name         String
  imo          String? @unique
  cruiseLine   String  @map("cruise_line")
  yearBuilt    Int?    @map("year_built")
  grossTonnage Int?    @map("gross_tonnage")
  capacity     Int?
  status       String  @default("active")
  isUserAdded  Boolean @default(false) @map("is_user_added")

  cruises Cruise[]

  @@index([name])
  @@index([cruiseLine])
  @@map("ships")
}

model Port {
  id          Int     @id @default(autoincrement())
  name        String
  city        String?
  country     String?
  unlocode    String? @unique
  lat         Float
  lon         Float
  timezone    String?
  region      String?
  isUserAdded Boolean @default(false) @map("is_user_added")

  cruisesDeparting Cruise[]     @relation("CruiseDeparture")
  cruisesArriving  Cruise[]     @relation("CruiseArrival")
  stops            CruiseStop[]
  legsFrom         CruiseLeg[]  @relation("CruiseLegFromPort")
  legsTo           CruiseLeg[]  @relation("CruiseLegToPort")

  @@index([name])
  @@index([city])
  @@index([region])
  @@map("ports")
}

model Lodging {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  type               String    @default("hotel") // hotel | campsite | guesthouse | apartment | hostel
  name               String
  chainId            Int?      @map("chain_id")
  address            String?
  city               String?
  country            String?
  /// ISO 3166-1 alpha-2, derived from `country`. The text field keeps whatever
  /// the source wrote ("Deutschland", "Germany", "Schweiz/Suisse/Svizzera/Svizra");
  /// everything that GROUPS or COUNTS joins on this instead. Null when the text
  /// resolves to no country — a finding, not a gap ("Dubai" is a city).
  isoCountryCode     String?   @map("iso_country_code")
  lat                Float?
  lon                Float?
  /// When the coordinate backfill last TRIED this row, successful or not.
  /// Ordering the batch by it gives every row a turn: ordering by `createdAt`
  /// handed the same oldest 500 unresolvable rows to the geocoder on every
  /// run, so a hotel added afterwards was never reached at all (AUD-070).
  geocodeAttemptedAt DateTime? @map("geocode_attempted_at")
  stars              Int? // official 1–5
  /// The house's own website. Filled by hand or by the OpenStreetMap
  /// enrichment, which only ever writes an empty field.
  website            String?
  /// Wikidata item of the house itself, from its OpenStreetMap tags.
  wikidataId         String?   @map("wikidata_id")
  amenities          String[]  @default([])
  notes              String?
  /// Has the user actually been here, or is it only noted down? A saved-places
  /// export mixes both, and only the user knows which is which — so the import
  /// asks once instead of inferring. Defaults to true: everything created
  /// before this column existed, and everything entered by hand or parsed from
  /// a booking, describes a place the user really went to.
  visited            Boolean   @default(true)
  dataSource         String?   @map("data_source") // parser | manual | enriched
  externalRef        String?   @map("external_ref") // e.g. "google:ChIJd8BlQ2Bo5kcRAFTLmuLK8bA"
  batchId            String?   @map("batch_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain           LodgingChain?              @relation(fields: [chainId], references: [id], onDelete: SetNull)
  batch           ImportBatch?               @relation(fields: [batchId], references: [id], onDelete: SetNull)
  stays           LodgingStay[]
  membershipLinks LodgingMembershipLodging[]
  photos          LodgingPhoto[]

  @@unique([userId, externalRef])
  @@index([userId])
  @@index([userId, type])
  @@index([chainId])
  @@index([batchId])
  @@map("lodgings")
}

model LodgingStay {
  id               String    @id @default(uuid())
  lodgingId        String    @map("lodging_id")
  userId           String    @map("user_id")
  tripId           String?   @map("trip_id")
  bookingId        String?   @map("booking_id")
  /// Hotel-local, do not normalize to UTC.
  ///
  /// NULLABLE since 2.7: a hotel you remember but cannot date is still a place
  /// you slept, and rating/price/board/room/membership all live on the STAY —
  /// so without a dateless stay those data points had nowhere to go. Flights
  /// (`departure_time`) and cruises (`start_date`) have always allowed this;
  /// lodging was the odd one out. What the dates mean is qualified by
  /// `date_precision`.
  checkIn          DateTime? @map("check_in")
  checkOut         DateTime? @map("check_out")
  /// Optional wall-clock times ("HH:mm", hotel-local like the dates) for the
  /// check-in/check-out DAY above. Stored separately so the UTC-midnight day
  /// anchors — which the FX snapshot, night counting and status derivation
  /// all key on — never shift. Only the "Als Nächstes" countdown combines
  /// day + time; everything else keeps reading the dates alone. Meaningful
  /// only at DAY precision (schema-enforced). Tester wish, #dev-talk
  /// 2026-08-18: a planned hotel should not "begin" at midnight.
  checkInTime      String?   @map("check_in_time")
  checkOutTime     String?   @map("check_out_time")
  /// ADR 0002 phase 2 dual-write: the check-in/-out days as calendar days,
  /// the instants they begin/end (day + time in the hotel's zone; null
  /// without a time or without a zone) and the hotel's zone. The legacy
  /// columns above keep their meaning until phase 6.
  checkInDate      DateTime? @map("check_in_date") @db.Date
  checkOutDate     DateTime? @map("check_out_date") @db.Date
  checkInAt        DateTime? @map("check_in_at")
  checkOutAt       DateTime? @map("check_out_at")
  stayZone         String?   @map("stay_zone")
  /// How much of the date is actually known: DAY (both dates real) | MONTH
  /// ("July 2011", stored as the 1st) | YEAR ("some time in 2011", stored as
  /// 1 January) | NONE (no idea, both dates null).
  ///
  /// Mirrors `Flight.dep_time_semantics`, which exists for the same reason: a
  /// placeholder that is not marked as one gets aggregated as if it were real.
  /// A MONTH-precision stay must never land in a weekday histogram, and a
  /// YEAR-precision one must never land in a month histogram — see
  /// shared/lodgingTiming.ts, which is the only place that decides this.
  datePrecision    String    @default("DAY") @map("date_precision")
  /// Nights, when the dates cannot supply them. "Three nights, no idea when"
  /// is a different gap from "July 2011, no idea how long", and one field
  /// cannot express both. Null = unknown; the dates win wherever they can
  /// answer (DAY precision with both ends).
  nights           Int?
  status           String    @default("completed") // scheduled | in_progress | completed | cancelled
  roomNumber       String?   @map("room_number")
  roomCategory     String?   @map("room_category")
  board            String? // none | breakfast | half | full | all_inclusive
  // How many people the booking covered, as the confirmation states it. A COUNT,
  // never a name: a confirmation names the booker, so who came along stays the
  // user's to enter in `companions`. Kept so the stay editor can point at that
  // field when a booking covered more than one person.
  guests           Int?
  pricePerNight    Float?    @map("price_per_night")
  currency         String    @default("EUR")
  totalPrice       Float?    @map("total_price")
  totalPriceBase   Float?    @map("total_price_base") // FX snapshot (§7.1)
  fxRate           Float?    @map("fx_rate")
  fxRateDate       DateTime? @map("fx_rate_date")
  fxBaseCurrency   String?   @map("fx_base_currency")
  // 'ecb' | 'cdn' | 'manual' — which provider produced the snapshot above.
  // A rate alone cannot say whether it is official or the user's own estimate.
  fxSource         String?   @map("fx_source")
  isAwardStay      Boolean   @default(false) @map("is_award_stay")
  ratingRoom       Float?    @map("rating_room")
  ratingBreakfast  Float?    @map("rating_breakfast")
  ratingService    Float?    @map("rating_service")
  ratingOverall    Float?    @map("rating_overall")
  roomAmenities    String[]  @default([]) @map("room_amenities")
  bookingReference String?   @map("booking_reference")
  membershipId     String?   @map("membership_id")
  /// true = the user explicitly used NO programme for this stay. Distinct from
  /// `membershipId = null`, which means "derive it from the hotel"
  /// (shared/membershipDerivation.ts).
  membershipOptOut Boolean   @default(false) @map("membership_opt_out")
  receiptUrl       String?   @map("receipt_url")
  companions       String[]  @default([])
  notes            String?
  parserTemplate   String?   @map("parser_template")
  parserConfidence Int?      @map("parser_confidence")
  dataSource       String?   @map("data_source")
  externalRef      String?   @map("external_ref") // e.g. "booking:5087376273"
  batchId          String?   @map("batch_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  lodging    Lodging            @relation(fields: [lodgingId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip       Trip?              @relation(fields: [tripId], references: [id], onDelete: SetNull)
  booking    Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  membership LoyaltyMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  batch      ImportBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)

  /// Roadtrip stations that slept here. The stay does not own them.
  roadtripStations TripStop[]

  documents Document[]

  @@unique([userId, externalRef])
  @@index([lodgingId])
  @@index([userId, checkIn])
  @@index([status])
  @@index([tripId])
  @@index([bookingId])
  @@index([membershipId])
  @@index([batchId])
  @@map("lodging_stays")
}

/// A hotel chain. Two kinds share the table (owner decision 2026-09-25):
///
/// - the CATALOGUE (`userId` null) — seeded from CSV, the same rows for every
///   account, read-only for users;
/// - a user's OWN chains (`userId` set) — created by that user, by hand or by
///   an import, and visible to nobody else.
///
/// Until then every chain was global, so one tester's import wrote "KOA" into
/// the owner's catalogue (UAT 2026-08-16). Every read is catalogue ∪ own and
/// every lookup goes through `services/lodging/chainScope.ts`.
model LodgingChain {
  id             Int      @id @default(autoincrement())
  name           String
  brandColor     String?  @map("brand_color")
  loyaltyProgram String?  @map("loyalty_program")
  isUserAdded    Boolean  @default(false) @map("is_user_added")
  userId         String?  @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user        User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lodgings    Lodging[]
  memberships LodgingMembershipChain[]

  @@unique([userId, name])
  @@unique([name], map: "lodging_chains_catalogue_name_key", where: raw("user_id IS NULL"))
  @@index([userId])
  @@map("lodging_chains")
}

/// One loyalty card of the user's — a hotel programme, a frequent-flyer
/// programme or a cruise line's club. It was `LodgingMembership` until 2.7,
/// when the owner asked for one page holding every programme (2026-09-25).
///
/// ONE table for all three domains rather than one per domain, because the
/// card is the same thing in each: a name, a number, a status. What differs is
/// only what the card COVERS, and each domain keeps its own coverage shape:
/// lodging links chains and hotels by id (the two link tables below), a
/// flight card lists IATA codes (a code is the airline's identity —
/// `shared/airlineNormalize.ts`), a cruise card lists cruise-line names (there
/// is no cruise-line catalogue; a cruise names its line as text), a rail card
/// lists operators as the rides name them (forgejo#132 item 23 — BahnBonus and
/// the like; no operator catalogue exists either). A column for
/// another domain's coverage stays empty, and the write path refuses to fill
/// it (`schemas/loyalty.ts`).
///
/// `domain` is a closed vocabulary — `LOYALTY_DOMAINS` in
/// `shared/domains.ts`, held by a CHECK constraint in the migration. It
/// is fixed at creation: moving a card between domains would strand its
/// coverage and every stay that names it.
model LoyaltyMembership {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  domain           String   @default("lodging")
  programName      String   @map("program_name")
  membershipNumber String?  @map("membership_number")
  /// The status held TODAY, the only status a card carries. A dated history
  /// existed in the 2.7 betas and was dropped on the tester's word
  /// (2026-09-26): nobody needed to know when a status was reached.
  tier             String?
  notes            String?
  airlineCodes     String[] @default([]) @map("airline_codes")
  cruiseLines      String[] @default([]) @map("cruise_lines")
  railOperators    String[] @default([]) @map("rail_operators")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stays    LodgingStay[]
  chains   LodgingMembershipChain[]
  lodgings LodgingMembershipLodging[]

  @@unique([userId, domain, programName])
  @@index([userId])
  @@map("loyalty_memberships")
}

/// Which chains a membership covers, linked BY ID.
///
/// The chain page used to find "your membership for this chain" by comparing
/// `LodgingChain.loyaltyProgram` to `LodgingMembership.programName` as
/// strings. Loyalty programmes get rebranded — NH Rewards -> NH DISCOVERY
/// (2022) -> Minor DISCOVERY — so that join broke on the day either side was
/// corrected: a user whose card says "Minor DISCOVERY" saw nothing on the NH
/// page, and the membership form had to LOCK the programme name to keep the
/// comparison alive. An id link survives every rename, and one membership can
/// legitimately cover several brands (Minor DISCOVERY: NH, NH Collection,
/// nhow, Anantara, Tivoli).
///
/// `LodgingChain.loyaltyProgram` survives as a SUGGESTION only — it seeds
/// which chains to pre-select and what to prefill the name with. It is no
/// longer load-bearing, so a stale catalogue value costs a checkbox, not a
/// missing membership.
model LodgingMembershipChain {
  membershipId String   @map("membership_id")
  chainId      Int      @map("chain_id")
  createdAt    DateTime @default(now()) @map("created_at")

  membership LoyaltyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  chain      LodgingChain      @relation(fields: [chainId], references: [id], onDelete: Cascade)

  @@id([membershipId, chainId])
  @@index([chainId])
  @@map("lodging_membership_chains")
}

/// Which INDEPENDENT hotels a membership covers, linked BY ID.
///
/// Mirrors LodgingMembershipChain so that "what does this card cover" is one
/// idea with one editor. It exists for a hotel that offers a programme without
/// belonging to a chain.
///
/// There is deliberately NO constraint tying this to `lodging.chain_id IS
/// NULL`. A chain link always WINS over one of these
/// (shared/membershipDerivation.ts), so assigning a chain to the hotel later
/// makes this row dormant rather than invalid. The alternative — enforcing the
/// rule in the database — would force a choice between blocking a legitimate
/// chain correction and silently deleting the user's link.
model LodgingMembershipLodging {
  membershipId String   @map("membership_id")
  lodgingId    String   @map("lodging_id")
  createdAt    DateTime @default(now()) @map("created_at")

  membership LoyaltyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  lodging    Lodging           @relation(fields: [lodgingId], references: [id], onDelete: Cascade)

  @@id([membershipId, lodgingId])
  @@index([lodgingId])
  @@map("lodging_membership_lodgings")
}

/// A point of interest in the user's own world — the thing, not the visit.
///
/// Mirrors the Lodging/LodgingStay split one-for-one, and for the same reason:
/// a place visited twice must stay ONE row, or "places visited" can never be
/// counted. That is the whole argument of #177, which warned that a trip-scoped
/// POI and a global POI would be "two different kinds of POI" — here there is
/// only this one, and a trip is a VIEW of it via PlaceVisit.
///
/// Per-user, like Lodging: on a shared instance one user's list of McDonald's
/// is nobody else's business. Curated checklist targets live in their own
/// global tables and only become a Place once the user ticks them off.
model Place {
  id     String @id @default(uuid())
  userId String @map("user_id")

  name     String
  /// The name in the place's own script, kept beside a Latin `name` — "반포대교"
  /// beside "Banpo Bridge" (forgejo#199). Null when the two would be the same,
  /// or when no second name is known; never transliterated or invented.
  localName String? @map("local_name")
  /// Drives the pin ICON, deliberately not the pin hue: on a map any two
  /// categories can end up adjacent, and only ~3 categorical hues survive that
  /// all-pairs separation test. Mirrored in frontend/src/shared/placeCategories.ts.
  category String @default("other")

  /// REQUIRED, unlike Lodging.lat/lon — a place that cannot be drawn defeats
  /// the point of the domain, and every creation path (search hit, map click,
  /// manual entry) already yields a position. The migration honours this by
  /// NOT migrating coordinate-less trip stops rather than inventing a position.
  lat Float
  lon Float

  address        String?
  city           String?
  country        String?
  /// ISO 3166-1 alpha-2 derived from `country`, same contract as Lodging: the
  /// text field keeps whatever the source wrote, everything that GROUPS or
  /// COUNTS joins on this instead.
  isoCountryCode String? @map("iso_country_code")

  /// Geocoder provenance, e.g. "osm:node/240109189". The dedup key: picking the
  /// same restaurant out of search twice yields one row.
  externalRef String? @map("external_ref")

  /// Set when this place was materialised by ticking a curated checklist item.
  /// Null for anything the user created themselves. Reserved for Phase C; the
  /// column ships now so the unique index does not need a later table rewrite.
  curatedItemId String? @map("curated_item_id")

  /// Wikidata item ("Q64"), resolved once from the place's OSM tags or its
  /// curated item and remembered, so the Wikipedia summary is not looked up
  /// through two services on every visit. Never guessed from the name.
  wikidataId String? @map("wikidata_id")

  /// Logbook or wishlist? Same question Lodging.visited answers — but note the
  /// OPPOSITE default. Lodging chose `true` because every row predating the
  /// column described a real stay; here the dominant creation path is "add a
  /// target to a list", and a wishlist entry silently counted as visited would
  /// inflate the headline number on day one.
  visited Boolean @default(false)

  /// The photograph the place page leads with, picked from its visits' photos.
  /// Null means "the first one" — a default, not a choice, so it is never
  /// written for the user. SetNull: deleting the photo must not delete the place.
  coverPhotoId String? @map("cover_photo_id")

  notes      String?
  dataSource String? @map("data_source") // manual | import | curated
  batchId    String? @map("batch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch            ImportBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  coverPhoto       PlaceVisitPhoto? @relation("PlaceCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  visits           PlaceVisit[]
  /// Roadtrip pass-throughs that name this place. The place does not own them.
  roadtripStations TripStop[]
  listEntries      PlaceListEntry[]
  photoJourneys    PhotoJourney[]

  @@unique([userId, externalRef])
  @@unique([userId, curatedItemId])
  @@index([userId])
  @@index([userId, category])
  @@index([userId, visited])
  @@map("places")
}

/// One visit to a Place. Replaces `TripStop` rows with `domain = 'poi'`.
///
/// This is what makes a trip a view rather than an owner, and it is also the
/// fix for #175 (several POIs on one day needed a time to sort by) — carrying
/// a DateTime instead of a date is the whole change.
model PlaceVisit {
  id      String  @id @default(uuid())
  placeId String  @map("place_id")
  userId  String  @map("user_id")
  tripId  String? @map("trip_id")

  /// Local wall-clock at the place — do NOT normalize to UTC. There is no
  /// timezone column and inventing one would be worse than the honest local
  /// reading; tripTimeline.ts already documents this for TripStop.
  ///
  /// Nullable: a place you know you visited but cannot date is still a visit
  /// (the LodgingStay 2.7 precedent). A visit dated in the FUTURE is not a
  /// visit yet and is excluded from every count — see shared/placeCounting.ts.
  visitedAt DateTime? @map("visited_at")

  /// ADR 0002 phase 2 dual-write. `visitedAt` above is a MIXED column — the web
  /// wrote the place's wall clock as fake UTC, the Companion a real instant —
  /// so new writes keep its web meaning, and these carry the truth: the real
  /// instant, the place's zone, the precision (`day` for a visit known only
  /// to the day) and who wrote the row (web | companion | import | suggestion
  /// | api), which the phase-3b backfill cannot recover for older rows (Q4).
  visitedAtUtc     DateTime? @map("visited_at_utc")
  visitedZone      String?   @map("visited_zone")
  visitedPrecision String?   @map("visited_precision")
  writtenVia       String?   @map("written_via")

  /// Tie-break inside a day when two visits share a timestamp, or when
  /// visitedAt is null and the user dragged them into an order.
  orderIdx Int @default(0) @map("order_idx")

  notes  String?
  rating Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull, matching Booking.tripId: deleting a trip must not delete the
  /// evidence that the user stood in front of the Colosseum.
  trip  Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  photos        PlaceVisitPhoto[]
  photoRefusals VisitPhotoRefusal[]

  documents Document[]

  @@index([userId])
  @@index([placeId])
  @@index([tripId])
  @@index([userId, visitedAt])
  @@index([userId, visitedAtUtc])
  @@map("place_visits")
}

/// Photo proof for one visit.
///
/// Deliberately a MIRROR of TripPhoto rather than a generalisation of it.
/// Making TripPhoto polymorphic would touch the shipped Immich import job, the
/// album-resync ordering invariant and the asset proxy's ownership check —
/// three things CLAUDE.md flags as load-bearing. A parallel table costs one
/// small file and risks none of them.
/// Photographs of a HOUSE, not of a stay.
///
/// Asked for by a tester who wanted pictures on the hotel (Alex, 2026-08-29).
/// Deliberately hung off the lodging rather than off a stay: a photo of the
/// building, the lobby or the view is a fact about the place and survives every
/// visit to it, while a stay-level photo would be re-uploaded each time.
///
/// A third table rather than a polymorphic photo owner, for the reason
/// `routes/places/visitPhotos.ts` writes down at length: a shared owner column
/// would reach into the Immich import job, the resync ordering invariant and
/// the asset proxy's ownership check, three places that already answer the
/// ownership question in a specific way.
model LodgingPhoto {
  id        String  @id @default(uuid())
  lodgingId String  @map("lodging_id")
  filename  String
  mimetype  String
  sizeBytes Int     @map("size_bytes")
  caption   String?
  sortIdx   Int     @default(0) @map("sort_idx")

  createdAt DateTime @default(now()) @map("created_at")

  lodging Lodging @relation(fields: [lodgingId], references: [id], onDelete: Cascade)

  @@index([lodgingId])
  @@map("lodging_photos")
}

model PlaceVisitPhoto {
  id           String  @id @default(uuid())
  placeVisitId String  @map("place_visit_id")
  /// The copy on disk. Null once the photo has become a LINK into the owner's
  /// Immich (forgejo#21): the row keeps `immichAssetId`, the file route streams
  /// that asset, and the copy is gone.
  filename     String?
  mimetype     String
  sizeBytes    Int     @map("size_bytes")
  caption      String?
  sortIdx      Int     @default(0) @map("sort_idx")

  /// Immich provenance, set only when imported from a linked album.
  immichAssetId String? @map("immich_asset_id")

  /// SHA-1 of the uploaded original, base64 — the encoding Immich uses for
  /// `asset.checksum`, so a later match is exact rather than a guess.
  ///
  /// Computed server-side from the bytes on disk. A client-supplied value
  /// would be unverified, and the whole point of this column is that it can be
  /// trusted. Null for rows written before it existed and for anything
  /// imported FROM Immich, which already carries its asset id.
  ///
  /// Forgejo #21: the Companion uploads place-visit photos as a TEMPORARY copy
  /// and tells the user they will become a library link later. Without an
  /// identity on the row that promise can only be kept heuristically — by
  /// original filename, size and creation time, which works often and not
  /// always. The window of rows that can never be matched exactly is the only
  /// thing that grows by waiting.
  checksum String?

  /// When the picture was taken, as opposed to when it was uploaded.
  ///
  /// Deliberately NOT parsed from EXIF here: this project has no EXIF reader,
  /// and adding one to a photo upload path is a bigger decision than this
  /// column. `TripPhoto.takenAt` is filled the same two ways — from Immich's
  /// `fileCreatedAt` on import, or by the client through PATCH.
  takenAt DateTime? @map("taken_at")

  /// A LINK to one of the owner's trip photographs, picked from the visit's
  /// photo suggestions: the file route streams the trip photo's bytes, and no
  /// copy is made. Cascade, because a link to a deleted photo shows nothing.
  tripPhotoId String? @map("trip_photo_id")

  createdAt DateTime @default(now()) @map("created_at")

  visit     PlaceVisit @relation(fields: [placeVisitId], references: [id], onDelete: Cascade)
  tripPhoto TripPhoto? @relation(fields: [tripPhotoId], references: [id], onDelete: Cascade)
  coverOf   Place[]    @relation("PlaceCover")

  @@index([placeVisitId])
  @@index([tripPhotoId])
  @@map("place_visit_photos")
}

/// A photo suggestion the user refused for one visit ("Nicht diese",
/// forgejo#132 item 13), so the suggestion list stops offering it. Per visit:
/// the same picture may well belong to another visit. `suggestionId` is a trip
/// photo id for kind "trip" and an Immich asset id for kind "library" — no
/// foreign key, because a library asset lives outside this database; a trip
/// photo deleted later leaves a refusal that simply matches nothing.
model VisitPhotoRefusal {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  placeVisitId String   @map("place_visit_id")
  /// "trip" | "library"
  kind         String
  suggestionId String   @map("suggestion_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  visit PlaceVisit @relation(fields: [placeVisitId], references: [id], onDelete: Cascade)

  @@unique([placeVisitId, kind, suggestionId])
  @@index([userId])
  @@map("visit_photo_refusals")
}

/// A user's own grouping of places — "Maccis weltweit", "Rom 2024".
///
/// Also the row that represents a SUBSCRIPTION to a shipped checklist: then
/// `curatedKey` is non-null and the name and membership come from the catalog
/// rather than the user. Both are the same kind of thing to everything that
/// renders a list, which is why they share one table.
model PlaceList {
  id     String @id @default(uuid())
  userId String @map("user_id")

  name        String
  description String?
  /// Defaults to the POI domain colour. What `list` colour mode resolves — the
  /// reason that mode could not exist before this table did.
  color       String  @default("#5ec2b2")
  icon        String?
  sortIdx     Int     @default(0) @map("sort_idx")
  /// What this list's places are labelled with on the map: "name" or "icon".
  /// Only ever the list's DEFAULT -- the map's own control overrides it for the
  /// whole map, which is why this is a per-list column and not a user setting.
  /// A list with no `icon` always renders names whatever this says.
  labelMode   String  @default("name") @map("label_mode")

  /// Non-null when this list is the user's subscription to a shipped checklist
  /// (e.g. "world-wonders-new7"). A subscribed list's name and membership are
  /// not user-editable; its colour is.
  curatedKey String? @map("curated_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries PlaceListEntry[]

  @@unique([userId, curatedKey])
  @@index([userId])
  @@map("place_lists")
}

/// Membership. Its own table because a place belongs to MANY lists — the
/// McDonald's at the Trevi Fountain is in "Maccis" and in "Rom" at once, which
/// a column on `places` could never express.
model PlaceListEntry {
  id      String @id @default(uuid())
  listId  String @map("list_id")
  placeId String @map("place_id")
  sortIdx Int    @default(0) @map("sort_idx")

  createdAt DateTime @default(now()) @map("created_at")

  list  PlaceList @relation(fields: [listId], references: [id], onDelete: Cascade)
  place Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([listId, placeId])
  @@index([listId])
  @@index([placeId])
  @@map("place_list_entries")
}

/// NOT application data — the receipt of the POI backfill.
///
/// `20260823150500_poi_backfill_from_trip_stops` copies POI trip stops into
/// places and deliberately deletes nothing; this table records which stop
/// became which visit, so the contract migration one release later can delete
/// exactly those and nothing else. On production the backfill runs for the
/// first time at the 2.6.0 promote, which makes this the ONLY record of it.
///
/// It is declared here purely so `prisma migrate dev` stops proposing to drop
/// it. It was created by raw SQL and had no model, so the very next generated
/// migration led with `DROP TABLE "_poi_backfill_audit"` — which would have
/// left the contract half with nothing to work from. Nothing reads it through
/// the client; the contract migration drops both the table and this model.
model PoiBackfillAudit {
  tripStopId   String   @id @map("trip_stop_id")
  placeVisitId String   @map("place_visit_id")
  migratedAt   DateTime @default(now()) @map("migrated_at")

  @@map("_poi_backfill_audit")
}

/// A checklist the INSTANCE ships — the same category of thing as Port, Ship
/// and LodgingChain, all of which seed from CSV idempotently. Global and
/// read-only; a user's progress against it lives in their own Place rows, never
/// here.
model CuratedList {
  key String @id

  /// User-facing, so it follows the project language rule: German is the
  /// primary copy and English is mirrored beside it. A catalog row cannot go
  /// through i18n resource files the way UI copy does, so the pair lives in
  /// the table and the client picks by locale, falling back to `name`.
  name          String
  nameEn        String? @map("name_en")
  description   String?
  descriptionEn String? @map("description_en")

  icon    String?
  sortIdx Int     @default(0) @map("sort_idx")

  items CuratedPlace[]

  @@map("curated_lists")
}

/// One target inside a shipped checklist. A target, NOT a pin: it becomes a
/// drawable place only when the user ticks it, which is what keeps the promise
/// that every pin on the globe is a real Place.
model CuratedPlace {
  id      String @id
  listKey String @map("list_key")

  /// German primary, English mirrored — see CuratedList.name. Most landmark
  /// names are identical in both ("Machu Picchu", "Petra"); `nameEn` is null
  /// for those rather than a duplicate, and the client falls back.
  name    String
  nameEn  String? @map("name_en")
  blurb   String?
  blurbEn String? @map("blurb_en")

  lat            Float
  lon            Float
  country        String?
  isoCountryCode String? @map("iso_country_code")
  sortIdx        Int     @default(0) @map("sort_idx")

  list CuratedList @relation(fields: [listKey], references: [key], onDelete: Cascade)

  @@index([listKey])
  @@map("curated_places")
}

/// One import run (CSV file, e-mail or PDF). Every row it created carries its
/// id, so a 232-row import that turns out wrong is revertible as a unit.
/// One import, as a unit the user can take back.
///
/// Started life as `LodgingImportBatch` because stays were the only domain
/// that logged its imports; flights and cruises wrote their rows and left no
/// trace, so "undo" existed for one area out of three. The model is the same
/// for all of them — what differs is only which rows point at it, hence the
/// `domain` column and one relation per domain rather than three near-identical
/// tables.
model ImportBatch {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  domain    String // flight | cruise | lodging | rail
  source    String // csv | email | pdf
  fileName  String?  @map("file_name")
  createdAt DateTime @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lodgings Lodging[]
  stays    LodgingStay[]
  flights  Flight[]
  cruises  Cruise[]
  rail     RailJourney[]
  rentals  RentalBooking[]
  places   Place[]

  @@index([userId])
  @@index([userId, domain])
  @@map("import_batches")
}

model Airline {
  id          Int     @id @default(autoincrement())
  iata        String? @unique
  icao        String?
  name        String
  callsign    String?
  country     String?
  active      Boolean @default(true)
  isUserAdded Boolean @default(false) @map("is_user_added")

  @@index([name])
  @@index([icao])
  @@map("airlines")
}

model Aircraft {
  id          Int     @id @default(autoincrement())
  icao        String? @unique
  name        String
  isUserAdded Boolean @default(false) @map("is_user_added")

  @@index([name])
  @@map("aircraft")
}

model Companion {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  canonicalName String   @map("canonical_name")
  displayName   String   @map("display_name")
  searchName    String   @map("search_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  flights FlightCompanion[]
  trips   TripCompanion[]
  cruises CruiseCompanion[]
  rail    RailJourneyCompanion[]
  rentals RentalBookingCompanion[]

  @@unique([userId, canonicalName])
  @@index([userId, searchName])
  @@map("companions")
}

model FlightCompanion {
  flightId    String @map("flight_id")
  companionId String @map("companion_id")
  position    Int

  flight    Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@id([flightId, companionId])
  @@index([companionId])
  @@map("flight_companions")
}

model TripCompanion {
  tripId      String @map("trip_id")
  companionId String @map("companion_id")
  position    Int

  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@id([tripId, companionId])
  @@index([companionId])
  @@map("trip_companions")
}

model CruiseCompanion {
  cruiseId    String @map("cruise_id")
  companionId String @map("companion_id")
  position    Int

  cruise    Cruise    @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@id([cruiseId, companionId])
  @@index([companionId])
  @@map("cruise_companions")
}

/// A stretch of photos that looks like travel nobody recorded.
///
/// Derived from the user's own Immich library: photos cluster in time,
/// the clusters that no flight, cruise, trip or stay explains are
/// reverse-geocoded, and what comes back is offered as a suggestion.
///
/// Never a fact and never applied on its own. A photo proves where a
/// CAMERA was, which is usually but not always where its owner was — a
/// shared album, a picture taken by someone else, an import from a
/// friend. So every row here waits for a person to accept it.
model PhotoJourney {
  id     String @id @default(uuid())
  userId String @map("user_id")

  /// pending | accepted | dismissed
  status String @default("pending")

  /// The cluster's span, from the first photo to the last.
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  photoCount   Int @map("photo_count")
  /// How many of those carried a coordinate. A cluster located by two
  /// photos out of sixty deserves less trust than one located by all of
  /// them, and the UI should be able to say so.
  locatedCount Int @map("located_count")

  /// Representative position — the median of the located photos.
  lat Float
  lon Float

  /// What the reverse lookup made of that position. Null when it
  /// answered nothing: an ocean, a desert, or Nominatim being down. The
  /// row still stands, because the DATES are the find.
  countryCode String? @map("country_code")
  countryName String? @map("country_name")
  city        String?

  /// Immich asset ids for the preview strip, capped when written.
  /// Ids rather than images: the proxy already streams thumbnails and
  /// copying bytes into our own database would duplicate the library.
  previewAssetIds String[] @map("preview_asset_ids")

  /// Stable across re-scans, so a nightly job updates a row instead of
  /// stacking a new copy of the same journey every night. Derived from
  /// the user, the start date and the rounded position.
  fingerprint String

  /// What the burst is taken for (forgejo#94), ranked by how much it proves:
  /// `place` — photos at an own place with no visit that day; `trip` — away
  /// from home near an own, flown airport; `stay` — nights away with no dated
  /// stay. One burst, one reading. The rule is `shared/photoScan.ts`.
  kind        String  @default("trip")
  /// `place`: the place the photos were taken at. `stay`: the own place that
  /// names where the nights were. Null for a trip.
  placeId     String? @map("place_id")
  /// `place`: how far the nearest photo was from it, shown rather than hidden.
  /// `trip`: how far the nearest own airport was.
  distanceKm  Float?  @map("distance_km")
  /// Whole nights the burst spans.
  nights      Int?
  /// `trip`: the nearest own airport the burst reached (not home).
  airportIata String? @map("airport_iata")
  /// `trip`: how far apart the burst's coordinates lie, home left out — a
  /// Rundreise is not a point.
  spreadKm    Float?  @map("spread_km")

  /// `visit` (forgejo#211): a stop INSIDE a recorded trip where the photos
  /// dwelt and no visit, stay or flight explains it — the trip is the anchor.
  /// Deleting the trip deletes the question: a stop of no trip is a `place`
  /// or `trip` finding's business, and the next scan asks it that way.
  tripId             String? @map("trip_id")
  /// `visit`: what the reverse lookup called the nearest named object — its
  /// English name, its own-script name where that differs, and its `osm:` ref
  /// so accepting dedupes against a place the user already has. All null when
  /// nothing within reach had a name; the finding still stands on its dates.
  suggestedName      String? @map("suggested_name")
  suggestedLocalName String? @map("suggested_local_name")
  suggestedRef       String? @map("suggested_ref")
  /// The place category the object's OSM tag maps to (`shared/placeCategories`),
  /// kept so accepting needs no second lookup; null falls back to `landmark`.
  suggestedCategory  String? @map("suggested_category")

  /// Set when the user accepted it and something was created from it.
  createdTripId        String? @map("created_trip_id")
  /// Accepting a `place` finding records a visit; a `stay` finding, a stay.
  createdPlaceVisitId  String? @map("created_place_visit_id")
  createdLodgingStayId String? @map("created_lodging_stay_id")

  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A finding about a place that no longer exists asks about nothing.
  place Place? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  trip  Trip?  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, status])
  @@index([startDate])
  @@map("photo_journeys")
}

/// The user's answer to one trip suggestion (owner decision 2026-09-26).
///
/// The suggestions themselves are never stored: the engine derives them from
/// the logbook on demand (`services/tripSuggestions/`), so a stored copy could
/// only go stale. What must survive is the ANSWER — a dismissed proposal must
/// not come back on the next visit, and that needs memory.
///
/// A dismissal is matched by member set, not by id alone: `memberKeys` holds
/// the `domain:id` of every entry the proposal carried when it was answered,
/// and a later proposal is suppressed while it still overlaps that set by at
/// least half (`shared/tripSuggestionRules.ts`, `isMaterialChange`).
model TripSuggestionDecision {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  /// new_trip | assign | extend | place_visit
  kind                String
  /// The proposal's stable id at the time it was answered.
  fingerprint         String
  /// accepted | dismissed
  status              String
  /// assign/extend: the trip it targeted. place_visit: the place.
  targetId            String?  @map("target_id")
  memberKeys          String[] @map("member_keys")
  /// What accepting created, for the record. No foreign key: the trip may be
  /// deleted later, and the answer stays an answer.
  createdTripId       String?  @map("created_trip_id")
  createdPlaceVisitId String?  @map("created_place_visit_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, status])
  @@map("trip_suggestion_decisions")
}

/// Who owns a file on disk, recorded when it is uploaded.
///
/// Before this table, "do you own this receipt" was answered by asking whether
/// the caller owned a flight or a stay REFERENCING it — a reference the caller
/// writes themselves. Knowing another account's file URL was therefore enough:
/// create your own flight pointing at it, and the read guard agreed you owned
/// the file (audit finding AUD-019). Ownership now lives with the file, is
/// written once at upload time, and no request body can change it.
model ReceiptUpload {
  id        String   @id @default(uuid())
  /// The name on disk, which is also what the URL carries.
  filename  String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("receipt_uploads")
}

/// A kept original — the photographed bill, the PDF, the mail, the Wallet pass —
/// filed with the entry it produced (forgejo#116).
///
/// The parsed fields are a summary of the document; the document is the record.
/// Two readings of one hotel bill (accommodation 123.25, total paid 162.75) were
/// both defensible, so no parser tuning settles which is right — keeping the
/// bill does, for good.
///
/// Owner decisions (2026-09-16): the ORIGINAL at full size is what is kept;
/// keeping is opt-in per capture; deleting an entry deletes its documents, row
/// and file; offline captures arrive late, so an upload is idempotent per
/// sha256 and target, and linking works after the entry exists.
///
/// At most ONE owner is set (CHECK in the migration). None set means "uploaded,
/// not yet filed": such a row expires with the nightly sweep.
model Document {
  id     String @id @default(uuid())
  userId String @map("user_id")

  /// Stored name on disk under uploads/documents — generated, never the client's.
  storedName   String  @map("stored_name")
  /// The client's file name, sanitised. Shown to the user, never used as a path
  /// and never written to a log.
  originalName String? @map("original_name")
  mimetype     String
  sizeBytes    Int     @map("size_bytes")
  /// SHA-256 of the stored bytes, hex, computed by the server.
  sha256       String
  /// Pages of a PDF, counted from its bytes when it was kept (forgejo#132
  /// item 4). NULL when unknown — every non-PDF, a PDF whose page tree could
  /// not be read, and every row kept before the column existed. Never 0.
  pageCount    Int?    @map("page_count")

  /// The FILE: image | pdf | eml | emailText | pkpass.
  format        String
  /// What the document IS: invoice | booking | boardingPass | ticket | other.
  /// The parser's guess or the user's statement; null until one of them says.
  kind          String?
  /// The date printed ON the document, when known.
  issuedOn      DateTime? @map("issued_on") @db.Date
  /// How the row came to be: upload | parse.
  source        String    @default("upload")
  /// What the parse decided and extracted, kept for a later diff.
  parsedDomain  String?   @map("parsed_domain")
  parsedPayload Json?     @map("parsed_payload")

  flightId        String? @map("flight_id")
  cruiseId        String? @map("cruise_id")
  lodgingStayId   String? @map("lodging_stay_id")
  tripId          String? @map("trip_id")
  placeVisitId    String? @map("place_visit_id")
  railJourneyId   String? @map("rail_journey_id")
  rentalBookingId String? @map("rental_booking_id")

  createdAt  DateTime  @default(now()) @map("created_at")
  /// When it was filed with an entry; null while unlinked.
  linkedAt   DateTime? @map("linked_at")
  /// Since WHEN this document has belonged to nothing — the clock the sweep
  /// runs on, and the one `deletesAt` is measured from. Null exactly when the
  /// document IS filed.
  ///
  /// The sweep used to count from `createdAt`, which is the age of the FILE and
  /// not the age of the problem. Unfiling a document uploaded two months ago
  /// therefore put it past the TTL the moment it was unfiled, and the next
  /// hourly pass deleted it — while the inbox, reading the same `createdAt`,
  /// had just promised a date in the past. Whatever the TTL is, the user is
  /// owed it from the moment the document became unfiled.
  unlinkedAt DateTime? @map("unlinked_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  flight        Flight?        @relation(fields: [flightId], references: [id], onDelete: Cascade)
  cruise        Cruise?        @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  lodgingStay   LodgingStay?   @relation(fields: [lodgingStayId], references: [id], onDelete: Cascade)
  trip          Trip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  placeVisit    PlaceVisit?    @relation(fields: [placeVisitId], references: [id], onDelete: Cascade)
  railJourney   RailJourney?   @relation(fields: [railJourneyId], references: [id], onDelete: Cascade)
  rentalBooking RentalBooking? @relation(fields: [rentalBookingId], references: [id], onDelete: Cascade)

  @@index([userId, sha256])
  @@index([flightId])
  @@index([cruiseId])
  @@index([lodgingStayId])
  @@index([tripId])
  @@index([placeVisitId])
  @@index([railJourneyId])
  @@index([rentalBookingId])
  @@index([userId, linkedAt])
  /// The sweep asks exactly this: unfiled rows past their stamp.
  @@index([unlinkedAt])
  @@map("documents")
}

/// One train ride: one vehicle, boarded at one station and left at another
/// (spec docs/superpowers/specs/2026-09-25-rail-domain.md). A connection is
/// several rows bound by `bookingId`, exactly as a flight's legs are.
///
/// Station fields are the ones a catalogue row will later fill; phase 1 takes
/// them from the geocoder. Coordinates are REQUIRED, as on `Flight`: a station
/// without a position can be neither drawn, measured nor placed in a zone.
model RailJourney {
  id     String @id @default(uuid())
  userId String @map("user_id")

  operator      String?
  /// "ICE", "TGV", "RJX" — apart from the number because statistics group by it.
  trainCategory String? @map("train_category")
  trainNumber   String? @map("train_number")

  depStationName String  @map("dep_station_name")
  /// UIC code when known — the catalogue's, when the station was picked there.
  depStationCode String? @map("dep_station_code")
  /// The catalogue row the station was picked from; null for a geocoder pick.
  /// The name/code/position columns stay the record either way, so deleting
  /// or reseeding a catalogue row never empties a journey.
  depStationId   Int?    @map("dep_station_id")
  depLat         Float   @map("dep_lat")
  depLon         Float   @map("dep_lon")
  /// ISO 3166-1 alpha-2, from the geocoder; null when unknown, never guessed.
  depCountry     String? @map("dep_country")
  /// IANA zone, derived by the server from the coordinates — never user input.
  depTimezone    String? @map("dep_timezone")
  arrStationName String  @map("arr_station_name")
  arrStationCode String? @map("arr_station_code")
  arrStationId   Int?    @map("arr_station_id")
  arrLat         Float   @map("arr_lat")
  arrLon         Float   @map("arr_lon")
  arrCountry     String? @map("arr_country")
  arrTimezone    String? @map("arr_timezone")

  /// Real UTC instants. The client sends the station's wall clock and the
  /// server converts it with the station's zone.
  departureTime DateTime  @map("departure_time")
  arrivalTime   DateTime? @map("arrival_time")
  /// ADR 0002: minute | day | unknown. Null = written before the column existed.
  depPrecision  String?   @map("dep_precision")
  arrPrecision  String?   @map("arr_precision")

  /// great_circle | user | null. Great-circle understates track length; the
  /// source is kept so a statistic can say which it is showing.
  distanceKm     Float?  @map("distance_km")
  distanceSource String? @map("distance_source")

  /// The line on the map, `[[lon, lat], ...]`, fetched ONCE when the journey is
  /// logged and frozen with it — a timetable changes, the ride that happened
  /// does not. Null = draw the chord between the two stations.
  geometry       Json?
  /// straight | transitous | openrailrouting | brouter | manual (| none for a
  /// row that cannot be drawn). `brouter` is the demo account's line, routed
  /// offline once. Kept because a line routed over the TRACKS may not be the
  /// line the train took, and the map has to be able to say which it shows.
  geometrySource String @default("straight") @map("geometry_source")

  /// What actually happened, when known: captured on the day or typed. A past
  /// journey with no record keeps null — no free source answers past actuals.
  actualDepartureTime DateTime? @map("actual_departure_time")
  actualArrivalTime   DateTime? @map("actual_arrival_time")

  /// The timetable trip a lookup matched (phase 2: transitous | db-rest | …),
  /// and that provider's id for it. Apart from `externalRef`, which is the
  /// IMPORT key and unique per user; two journeys may match the same trip.
  lookupProvider String? @map("lookup_provider")
  lookupRef      String? @map("lookup_ref")

  /// first | second | sleeper | couchette
  travelClass      String? @map("travel_class")
  coach            String?
  seat             String?
  bookingReference String? @map("booking_reference")

  price          Float?
  currency       String?   @default("EUR")
  /// FX snapshot (#267), same contract as `Cruise`, dated by the departure.
  priceBase      Float?    @map("price_base")
  fxRate         Float?    @map("fx_rate")
  fxRateDate     DateTime? @map("fx_rate_date")
  fxBaseCurrency String?   @map("fx_base_currency")
  fxSource       String?   @map("fx_source")

  /// scheduled | in_progress | completed | cancelled — lodging's vocabulary.
  /// A cache of `deriveRailStatus`; only `cancelled` is set by a client.
  status       String   @default("scheduled")
  /// Arrival delay as experienced. Null = not recorded, 0 = on time.
  delayMinutes Int?     @map("delay_minutes")
  notes        String?
  tags         String[] @default([])
  companions   String[] @default([])

  tripId    String? @map("trip_id")
  bookingId String? @map("booking_id")

  /// Reserved for imports, same contract as `Cruise.externalRef`.
  externalRef   String? @map("external_ref")
  importBatchId String? @map("import_batch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip           Trip?                  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  booking        Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  importBatch    ImportBatch?           @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  depStation     RailStation?           @relation("RailJourneyDepStation", fields: [depStationId], references: [id], onDelete: SetNull)
  arrStation     RailStation?           @relation("RailJourneyArrStation", fields: [arrStationId], references: [id], onDelete: SetNull)
  companionLinks RailJourneyCompanion[]
  documents      Document[]

  @@unique([userId, externalRef])
  @@index([userId, departureTime])
  @@index([status])
  @@index([tripId])
  @@index([bookingId])
  @@index([importBatchId])
  @@index([depStationId])
  @@index([arrStationId])
  @@map("rail_journeys")
}

/// The station catalogue: a filtered copy of Trainline's stations.csv (ODbL 1.0,
/// backend/data/rail/), seeded idempotently like ports and ships. Seeding only
/// ever INSERTS missing `sourceId`s, so a user-added row (`isUserAdded`) and any
/// row already present are never overwritten.
model RailStation {
  id             Int     @id @default(autoincrement())
  /// Trainline's own id; null for a row a user added.
  sourceId       String? @unique @map("source_id")
  name           String
  /// Lower case, diacritics folded, punctuation to spaces — what search matches.
  searchName     String  @map("search_name")
  uic            String?
  /// Deutsche Bahn's EVA number (Trainline `db_id`) — how db-rest names a stop.
  /// Not the UIC code: Frankfurt (Main) Hbf is UIC 8011068 but EVA 8000105.
  dbId           String? @map("db_id")
  /// DB station code ("Ril 100" / DS100 — KK for Köln Hbf), from
  /// data/rail/station_codes.csv (OpenStation + Wikidata, CC0). Null when
  /// neither source names one; never derived.
  shortCode      String? @map("short_code")
  lat            Float
  lon            Float
  country        String?
  timezone       String?
  /// Trainline id of the parent (the city or the main station a platform belongs to).
  parentSourceId String? @map("parent_source_id")
  isUserAdded    Boolean @default(false) @map("is_user_added")

  departures RailJourney[] @relation("RailJourneyDepStation")
  arrivals   RailJourney[] @relation("RailJourneyArrStation")

  @@index([uic])
  @@index([searchName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("rail_stations")
}

model RailJourneyCompanion {
  railJourneyId String @map("rail_journey_id")
  companionId   String @map("companion_id")
  position      Int

  railJourney RailJourney @relation(fields: [railJourneyId], references: [id], onDelete: Cascade)
  companion   Companion   @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@id([railJourneyId, companionId])
  @@index([companionId])
  @@map("rail_journey_companions")
}

/// A car rental — one row per rental contract (spec
/// docs/superpowers/specs/2026-10-01-rental-domain-design.md §3.1). A rental is
/// a contract, not a route: it has no geometry of its own; a roadtrip may name
/// it as the car it was driven in (`routeId`).
model RentalBooking {
  id     String @id @default(uuid())
  userId String @map("user_id")

  /// The company whose counter hands over the keys ("Sixt", "Alamo").
  provider           String
  /// Set only when the counter belongs to someone else than `provider`.
  operatedBy         String? @map("operated_by")
  /// OTA, broker or tour operator the booking went through.
  broker             String?
  /// The provider's number — the identity a later mail is matched by.
  confirmationNumber String? @map("confirmation_number")
  brokerReference    String? @map("broker_reference")
  /// Known only from a rental agreement; a second match key, never a create key.
  agreementNumber    String? @map("agreement_number")
  /// Known only from the final invoice; a third match key, never a create key.
  invoiceNumber      String? @map("invoice_number")

  pickupStationName String  @map("pickup_station_name")
  pickupAddress     String? @map("pickup_address")
  /// The airport the station sits at, when it is one. The name/position
  /// columns stay the record either way.
  pickupAirportId   Int?    @map("pickup_airport_id")
  /// Required: a station without a position has no zone, no country, no map point.
  pickupLat         Float   @map("pickup_lat")
  pickupLon         Float   @map("pickup_lon")
  /// ISO 3166-1 alpha-2 from the airport or the geocoder; null when unknown, never guessed.
  pickupCountry     String? @map("pickup_country")
  /// IANA zone, derived by the server (airport catalogue first, coordinates second).
  pickupTimezone    String  @map("pickup_timezone")
  returnStationName String  @map("return_station_name")
  returnAddress     String? @map("return_address")
  returnAirportId   Int?    @map("return_airport_id")
  returnLat         Float   @map("return_lat")
  returnLon         Float   @map("return_lon")
  returnCountry     String? @map("return_country")
  returnTimezone    String  @map("return_timezone")

  /// Real UTC instants; the client sends the station's wall clock (ADR 0002).
  pickupTime      DateTime @map("pickup_time")
  returnTime      DateTime @map("return_time")
  /// minute | day | unknown (ADR 0002).
  pickupPrecision String   @default("minute") @map("pickup_precision")
  returnPrecision String   @default("minute") @map("return_precision")

  /// What happened at the counter, from an agreement/invoice or typed; null = nobody recorded it.
  actualPickupTime DateTime? @map("actual_pickup_time")
  actualReturnTime DateTime? @map("actual_return_time")

  /// The class as printed ("Compact", "Gruppe C").
  vehicleClass   String? @map("vehicle_class")
  /// Four-letter ACRISS code; transmission and A/C are derived on read, not stored.
  acrissCode     String? @map("acriss_code")
  /// "<model> or similar" — what was promised.
  vehicleExample String? @map("vehicle_example")
  /// The car actually driven — from the invoice, else an agreement, else typed.
  vehicleDriven  String? @map("vehicle_driven")
  /// The car's licence plate as the reader typed it — free text, trimmed, no format check (forgejo#196).
  licensePlate   String? @map("license_plate")

  /// From the final invoice (out also from an agreement). Null = unknown, never 0.
  odometerOutKm  Int?    @map("odometer_out_km")
  odometerInKm   Int?    @map("odometer_in_km")
  /// Driven km: the invoice's figure, else in − out, else null — never estimated.
  distanceKm     Int?    @map("distance_km")
  /// invoice | agreement | user (a labelled correction) | null.
  distanceSource String? @map("distance_source")

  /// What the invoice says was charged. Null until an invoice arrives.
  finalAmount         Float?    @map("final_amount")
  finalCurrency       String?   @map("final_currency")
  finalAmountBase     Float?    @map("final_amount_base")
  finalFxRate         Float?    @map("final_fx_rate")
  finalFxRateDate     DateTime? @map("final_fx_rate_date")
  finalFxBaseCurrency String?   @map("final_fx_base_currency")
  finalFxSource       String?   @map("final_fx_source")
  /// invoice | user (a labelled correction) | cancellationFee (a cancelled
  /// rental's fee — never a rental-day cost) | null — the row says which it shows.
  finalAmountSource   String?   @map("final_amount_source")
  /// The send time of the newest provider mail applied to this row. An older
  /// mail arriving later only fills what is still empty — it never overwrites
  /// what a newer one set. Null = no dated mail yet (pasted text carries none).
  lastMailSentAt      DateTime? @map("last_mail_sent_at")

  /// unlimited | capped | null; the cap beside it.
  mileagePolicy String? @map("mileage_policy")
  mileageCapKm  Int?    @map("mileage_cap_km")
  /// full_to_full | prepaid_tank | full_to_empty | null.
  fuelPolicy    String? @map("fuel_policy")
  /// prepaid | pay_at_counter | package | null. A null price with `package` is normal.
  paymentTiming String? @map("payment_timing")

  /// The booked price. Null = unknown (a tour-operator package prints 0.00 for a price that exists).
  price          Float?
  currency       String?
  /// FX snapshot (#267), same contract as `RailJourney`, dated by the pickup.
  priceBase      Float?    @map("price_base")
  fxRate         Float?    @map("fx_rate")
  fxRateDate     DateTime? @map("fx_rate_date")
  fxBaseCurrency String?   @map("fx_base_currency")
  fxSource       String?   @map("fx_source")

  /// Normalised codes of what was included or bought (cdw, tp, …) — not their prices.
  inclusions          String[] @default([])
  /// "Arriving Airline" as printed; drives a flight-link suggestion.
  arrivalFlightNumber String?  @map("arrival_flight_number")

  /// scheduled | in_progress | completed | cancelled — a cache of
  /// `deriveRentalStatus`; only `cancelled` is set by a client.
  status     String   @default("scheduled")
  notes      String?
  tags       String[] @default([])
  companions String[] @default([])

  /// Fields the user typed or edited by hand. A later mail of the same booking
  /// never replaces one of these (silent-failure class 4).
  userEditedFields String[] @default([]) @map("user_edited_fields")

  tripId  String? @map("trip_id")
  /// The roadtrip (`TripRoute`, kind roadtrip) this car was driven on.
  routeId String? @map("route_id")

  /// The parser writes `rental:<provider>:<confirmationNumber>`.
  externalRef   String? @map("external_ref")
  importBatchId String? @map("import_batch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip           Trip?                    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  route          TripRoute?               @relation(fields: [routeId], references: [id], onDelete: SetNull)
  importBatch    ImportBatch?             @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  pickupAirport  Airport?                 @relation("RentalPickupAirport", fields: [pickupAirportId], references: [id], onDelete: SetNull)
  returnAirport  Airport?                 @relation("RentalReturnAirport", fields: [returnAirportId], references: [id], onDelete: SetNull)
  companionLinks RentalBookingCompanion[]
  documents      Document[]

  @@unique([userId, externalRef])
  @@index([userId, pickupTime])
  @@index([userId, confirmationNumber])
  @@index([status])
  @@index([tripId])
  @@index([routeId])
  @@index([importBatchId])
  @@index([pickupAirportId])
  @@index([returnAirportId])
  @@map("rental_bookings")
}

/// Companions on a rental (additional drivers among them), dual-written with
/// `RentalBooking.companions` like rail.
model RentalBookingCompanion {
  rentalBookingId String @map("rental_booking_id")
  companionId     String @map("companion_id")
  position        Int

  rentalBooking RentalBooking @relation(fields: [rentalBookingId], references: [id], onDelete: Cascade)
  companion     Companion     @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@id([rentalBookingId, companionId])
  @@index([companionId])
  @@map("rental_booking_companions")
}

/// ADR 0002 phase 3: every legacy value the time-model backfill converted or
/// could not convert, with the rule it applied. The backfill writes only new
/// columns and this ledger; nothing here is read by the product. `status`
/// open = a row the owner must look at (no zone, ambiguous day), resolved =
/// converted, or answered since (a write gave the row its zone or time, the
/// question was dismissed, the row was deleted — `settleTimeLedger`).
model TimeMigrationLedger {
  id          String   @id @default(uuid())
  tableName   String   @map("table_name")
  rowId       String   @map("row_id")
  columnName  String   @map("column_name")
  legacyValue String?  @map("legacy_value")
  newValue    String?  @map("new_value")
  zone        String?
  rule        String
  status      String   @default("open")
  /// The account the row belongs to (phase 3b), so the data-quality inbox can
  /// read one user's open questions without a join per table. Null only for a
  /// row whose owner could not be read.
  userId      String?  @map("user_id")
  /// Why a row is open (`TIME_MIGRATION_REASONS`); null for a converted value.
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tableName, rowId])
  @@index([status])
  @@index([userId, status])
  @@map("time_migration_ledger")
}

/// The change feed behind `GET /sync/changes` (forgejo#141). One row per
/// insert, update or delete of a synced record, written by the database
/// trigger `sync_record_change` — never by application code, so a delete path
/// the routes forget (a `deleteMany`, an `onDelete: Cascade`, raw SQL) cannot
/// skip its tombstone. See `services/sync/` for the cursor and the reasoning.
model SyncChange {
  /// Insertion order inside one transaction; NOT a commit order across them.
  seq            BigInt    @id @default(autoincrement())
  /// `pg_current_xact_id()` of the writing transaction — the feed orders and
  /// cuts on this, below the reading snapshot's xmin.
  xid            BigInt
  /// No foreign key on purpose: deleting an account cascades through every
  /// synced table, and a key would make each of those tombstones fail.
  userId         String    @map("user_id")
  /// The sync entity name (`flight`, `lodging_stay`, …), not the table name.
  entity         String
  entityId       String    @map("entity_id")
  /// upsert | delete
  op             String
  /// Database column names an UPDATE changed; empty for insert and delete.
  changedColumns String[]  @default([]) @map("changed_columns")
  /// The row's `updated_at` after the write — what a 409 compares a client's
  /// base version against. Null for tables without one, and for deletes.
  rowUpdatedAt   DateTime? @map("row_updated_at")
  /// A tour section's `kind` (tour | roadtrip), so a tombstone can be gated
  /// by domain after the row itself is gone. Null for every other entity.
  kind           String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([userId, xid, seq])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("sync_changes")
}

/// The feed's single bookkeeping row (id = 1).
model SyncState {
  id          Int      @id @default(1)
  /// Changes when the feed's history stops being continuous — a database
  /// restore. A cursor from another epoch must resync in full.
  epoch       String
  /// The highest (xid, seq) the retention sweep has deleted. A cursor at or
  /// above it sees a complete feed; one below it would miss tombstones.
  prunedXid   BigInt   @default(0) @map("pruned_xid")
  prunedSeq   BigInt   @default(0) @map("pruned_seq")
  /// The newest row version whose change history may be incomplete — the
  /// moment the feed began, then the newest pruned `row_updated_at`. A 409
  /// against an older base cannot name its changed fields and says so.
  historyFrom DateTime @map("history_from")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sync_state")
}
