model TripStop {
  id          String    @id @default(uuid())
  tripId      String    @map("trip_id")
  orderIdx    Int       @default(0) @map("order_idx")
  // Free-form DomainKey-style label so the timeline picks the right
  // colour ("poi", "hotel", "train", "hike", …). Null means "generic".
  domain      String?
  // Optional id of an existing flight/cruise/etc. that this stop wraps.
  sourceId    String?   @map("source_id")
  title       String
  description String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  lat         Float?
  lon         Float?
  notes       String?
  /// Route membership. NULL means what every stop is today: a timeline
  /// point that produces no kilometres. Set means it is a vertex of that
  /// route section. Nothing derives this — see the migration note.
  routeId       String? @map("route_id")
  /// Position WITHIN the route, 0-based and contiguous. Written only by
  /// PUT /trips/:id/routes/:routeId/stops, never by a client.
  routeOrderIdx Int?    @map("route_order_idx")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  trip     Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  route     TripRoute?     @relation(fields: [routeId], references: [id], onDelete: SetNull)
  legsFrom  TripRouteLeg[] @relation("LegFrom")
  legsTo    TripRouteLeg[] @relation("LegTo")

  @@unique([routeId, routeOrderIdx])
  @@index([tripId])
  @@index([tripId, orderIdx])
  @@index([routeId])
  @@map("trip_stops")
}

/// A named, ordered route section inside a trip: "Norwegen mit dem
/// Wohnmobil", "Besseggen-Wanderung", "Fähre nach Hirtshals".
///
/// A trip may hold several. A section may be a LOOP — its first and last
/// stop may be the same place — which is what makes a day hike from a base
/// camp expressible. The vehicle link arrives with phase 2.
model TripRoute {
  id       String  @id @default(uuid())
  tripId   String  @map("trip_id")
  name     String
  /// Default mode for legs created in this section:
  /// road | ferry | rail | foot | bike
  mode     String
  orderIdx Int     @default(0) @map("order_idx")
  color    String?
  notes    String?

  /// Odometer at section start and end. Deliberately NOT reconciled with
  /// the sum of the legs: the difference is the finding.
  startOdometerKm Int? @map("start_odometer_km")
  endOdometerKm   Int? @map("end_odometer_km")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip   Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stops  TripStop[]
  legs   TripRouteLeg[]
  tracks TripRouteTrack[]

  @@index([tripId])
  @@map("trip_routes")
}

/// One leg of one section.
///
/// Keyed by its two ENDPOINT STOPS, never by an ordinal — the lesson
/// `CruiseLegRoute` records: keying by position means inserting a stop
/// shifts every stored line one leg along, and the map then looks like the
/// router broke. With endpoint keying an inserted stop leaves its
/// neighbours' stored geometry untouched.
model TripRouteLeg {
  id         String @id @default(uuid())
  routeId    String @map("route_id")
  fromStopId String @map("from_stop_id")
  toStopId   String @map("to_stop_id")

  distanceKm Float  @map("distance_km")
  /// straight | drawn (phase 1). routed | track arrive in phase 3.
  source     String
  /// road | ferry | rail | foot | bike. Per LEG, not per section: a road
  /// tour with one ferry crossing must not count it as motorway km.
  mode       String
  /// low | medium | high, mirroring CruiseLeg.
  confidence String @default("medium")

  /// `[[lon, lat], …]` in GeoJSON order. Null when source is `straight`.
  waypoints      Json?
  drivingMinutes Int?    @map("driving_minutes")
  tollCost       Float?  @map("toll_cost")
  currency       String?

  computedAt DateTime @default(now()) @map("computed_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  route    TripRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  fromStop TripStop  @relation("LegFrom", fields: [fromStopId], references: [id], onDelete: Cascade)
  toStop   TripStop  @relation("LegTo",   fields: [toStopId],   references: [id], onDelete: Cascade)

  @@unique([routeId, fromStopId, toStopId])
  @@index([routeId])
  @@map("trip_route_legs")
}

/// A recorded track. Hangs off the SECTION and a time window, never off a
/// leg: a GPX file knows nothing about the user's stops, and forcing it
/// into the leg structure on import loses data. Legs may later take their
/// distance from an overlapping track (§7.3); the track itself stays whole.
model TripRouteTrack {
  id         String   @id @default(uuid())
  routeId    String   @map("route_id")
  source     String   // gpx | dawarich
  name       String?
  startedAt  DateTime @map("started_at")
  endedAt    DateTime @map("ended_at")
  /// GeoJSON LineString coordinates, already simplified on import.
  geometry   Json
  pointCount Int      @map("point_count")
  distanceKm Float    @map("distance_km")
  createdAt  DateTime @default(now()) @map("created_at")

  route TripRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
  @@map("trip_route_tracks")
}

model TripJournalEntry {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  date      DateTime
  title     String?
  body      String
  mood      String?
  weather   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, date])
  @@map("trip_journal_entries")
}

model Booking {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  tripId   String? @map("trip_id")
  pnr      String?
  price    Float?
  currency String? @default("EUR")

  /// FX snapshot (#267) — same contract as `Flight`. A booking's price counts
  /// once for the whole booking rather than once per segment, so the cost
  /// aggregates read this instead of the segments' own prices; without a
  /// snapshot here a multi-currency logbook could not be totalled honestly
  /// either. Dated by `createdAt`, the only day a booking carries.
  priceBase      Float?    @map("price_base")
  fxRate         Float?    @map("fx_rate")
  fxRateDate     DateTime? @map("fx_rate_date")
  fxBaseCurrency String?   @map("fx_base_currency")
  fxSource       String?   @map("fx_source")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip         Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  flights      Flight[]
  cruises      Cruise[]
  lodgingStays LodgingStay[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([tripId])
  @@map("bookings")
}

model Cruise {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  shipId           Int?      @map("ship_id")
  shipNameOverride String?   @map("ship_name_override")
  cruiseLine       String?   @map("cruise_line")
  departurePortId  Int?      @map("departure_port_id")
  arrivalPortId    Int?      @map("arrival_port_id")
  routeName        String?   @map("route_name")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  status           String    @default("scheduled")
  cabinNumber      String?   @map("cabin_number")
  cabinType        String?   @map("cabin_type")
  deck             Int?
  bookingReference String?   @map("booking_reference")
  price            Float?
  currency         String?   @default("EUR")
  notes            String?
  tags             String[]  @default([])
  companions       String[]  @default([])
  tripId           String?   @map("trip_id")
  bookingId        String?   @map("booking_id")
  parserTemplate   String?   @map("parser_template")
  parserConfidence Int?      @map("parser_confidence")
  dataSource       String?   @map("data_source")
  // Optional user-selectable map color (hex, e.g. "#e88374"). Nullable —
  // null means "auto-derive from cruise id" (see resolveCruiseColor on the
  // frontend). Unlike Trip.color, there is no default so existing rows stay
  // null and keep their derived color.
  color            String?   @map("color")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ship          Ship?        @relation(fields: [shipId], references: [id], onDelete: SetNull)
  departurePort Port?        @relation("CruiseDeparture", fields: [departurePortId], references: [id], onDelete: SetNull)
  arrivalPort   Port?        @relation("CruiseArrival", fields: [arrivalPortId], references: [id], onDelete: SetNull)
  trip          Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  booking       Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  stops         CruiseStop[]
  legs          CruiseLeg[]
  legRoutes     CruiseLegRoute[]

  /// Where this row came from, so a second import of the same file recognises
  /// it instead of duplicating it (#84). Format `<source>:<stable key>`; the
  /// key must identify THIS entry, never just the booking — a return leg
  /// shares its PNR with the outbound one, and a unique constraint on the
  /// booking alone would silently refuse the second half of every trip.
  externalRef   String?  @map("external_ref")
  importBatchId String?  @map("import_batch_id")

  companionLinks CruiseCompanion[]
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startDate])
  @@index([status])
  @@index([cruiseLine])
  @@index([tripId])
  @@index([bookingId])
  @@index([importBatchId])
  @@unique([userId, externalRef])
  @@map("cruises")
}

model CruiseLeg {
  id            String   @id @default(uuid())
  cruiseId      String   @map("cruise_id")
  ordinal       Int
  fromPortId    Int      @map("from_port_id")
  toPortId      Int      @map("to_port_id")
  distanceKm    Float    @map("distance_km")
  method        String
  routerVersion String   @map("router_version")
  dataVersion   String?  @map("data_version")
  confidence    String   @default("medium")
  notes         String?
  computedAt    DateTime @default(now()) @map("computed_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cruise   Cruise @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  fromPort Port   @relation("CruiseLegFromPort", fields: [fromPortId], references: [id], onDelete: Restrict)
  toPort   Port   @relation("CruiseLegToPort", fields: [toPortId], references: [id], onDelete: Restrict)

  @@unique([cruiseId, ordinal])
  @@index([cruiseId])
  @@index([fromPortId])
  @@index([toPortId])
  @@index([method])
  @@map("cruise_legs")
}

/// A hand-corrected route for one leg of one cruise.
///
/// Keyed by the leg's two ENDPOINTS, never by its ordinal: keying by position
/// means inserting a port shifts every stored line one leg along, and the map
/// then looks like the router broke. With endpoint keying an itinerary change
/// simply leaves the row unmatched and inert.
///
/// Consequence accepted on purpose: if the same directed pair occurs twice in
/// one itinerary, both occurrences render the same corrected line — which is
/// almost always what the user meant.
///
/// A row is never deleted by an itinerary change, only unmatched — so
/// undoing the change (e.g. removing a stop, then re-adding it with the same
/// endpoints) brings the old corrected line back automatically. Nothing
/// tells the user this resurrection happened.
model CruiseLegRoute {
  id       String @id @default(uuid())
  cruiseId String @map("cruise_id")

  /// 'port' today. 'place' arrives with the private-place stage; the column
  /// exists now so that stage adds rows rather than migrating every stored line.
  fromKind String @map("from_kind")
  /// The endpoint's id as text — a Port id today.
  fromRef  String @map("from_ref")
  toKind   String @map("to_kind")
  toRef    String @map("to_ref")

  /// `[[lon, lat], ...]` in GeoJSON order, 2..64 points, first and last equal
  /// to the leg's endpoints (within 1 km, to allow for coordinate rounding).
  /// Zod (`routeOverrideSchema`) validates count and coordinate ranges; the
  /// endpoint anchor itself is checked in the `PUT` handler
  /// (`routes/cruises.ts`), because it needs the leg's port coordinates from
  /// the database — something a Zod schema cannot see.
  waypoints Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cruise Cruise @relation(fields: [cruiseId], references: [id], onDelete: Cascade)

  @@unique([cruiseId, fromKind, fromRef, toKind, toRef])
  @@index([cruiseId])
  @@map("cruise_leg_routes")
}

model CruiseStop {
  id            String    @id @default(uuid())
  cruiseId      String    @map("cruise_id")
  portId        Int?      @map("port_id")
  dayNumber     Int       @map("day_number")
  date          DateTime?
  isAtSea       Boolean   @default(false) @map("is_at_sea")
  arrivalTime   DateTime? @map("arrival_time")
  departureTime DateTime? @map("departure_time")
  excursionNote String?   @map("excursion_note")
  // Third stop state: a port whose name could not be matched to the catalog on
  // import. portId=null AND isAtSea=false AND this set => unresolved port.
  unresolvedPortName String? @map("unresolved_port_name")

  cruise Cruise @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  port   Port?  @relation(fields: [portId], references: [id], onDelete: SetNull)

  @@index([cruiseId])
  @@index([portId])
  @@map("cruise_stops")
}

model Ship {
  id           Int     @id @default(autoincrement())
  name         String
  imo          String? @unique
  cruiseLine   String  @map("cruise_line")
  yearBuilt    Int?    @map("year_built")
  grossTonnage Int?    @map("gross_tonnage")
  capacity     Int?
  status       String  @default("active")
  isUserAdded  Boolean @default(false) @map("is_user_added")

  cruises Cruise[]

  @@index([name])
  @@index([cruiseLine])
  @@map("ships")
}

model Port {
  id          Int     @id @default(autoincrement())
  name        String
  city        String?
  country     String?
  unlocode    String? @unique
  lat         Float
  lon         Float
  timezone    String?
  region      String?
  isUserAdded Boolean @default(false) @map("is_user_added")

  cruisesDeparting Cruise[]     @relation("CruiseDeparture")
  cruisesArriving  Cruise[]     @relation("CruiseArrival")
  stops            CruiseStop[]
  legsFrom         CruiseLeg[]  @relation("CruiseLegFromPort")
  legsTo           CruiseLeg[]  @relation("CruiseLegToPort")

  @@index([name])
  @@index([city])
  @@index([region])
  @@map("ports")
}

model Lodging {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  type          String   @default("hotel") // hotel | campsite | guesthouse | apartment | hostel
  name          String
  chainId       Int?     @map("chain_id")
  address       String?
  city          String?
  country       String?
  /// ISO 3166-1 alpha-2, derived from `country`. The text field keeps whatever
  /// the source wrote ("Deutschland", "Germany", "Schweiz/Suisse/Svizzera/Svizra");
  /// everything that GROUPS or COUNTS joins on this instead. Null when the text
  /// resolves to no country — a finding, not a gap ("Dubai" is a city).
  isoCountryCode String?  @map("iso_country_code")
  lat           Float?
  lon           Float?
  stars         Int?     // official 1–5
  amenities     String[] @default([])
  notes         String?
  /// Has the user actually been here, or is it only noted down? A saved-places
  /// export mixes both, and only the user knows which is which — so the import
  /// asks once instead of inferring. Defaults to true: everything created
  /// before this column existed, and everything entered by hand or parsed from
  /// a booking, describes a place the user really went to.
  visited       Boolean  @default(true)
  dataSource    String?  @map("data_source") // parser | manual | enriched
  externalRef   String?  @map("external_ref") // e.g. "google:ChIJd8BlQ2Bo5kcRAFTLmuLK8bA"
  batchId       String?  @map("batch_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain           LodgingChain?              @relation(fields: [chainId], references: [id], onDelete: SetNull)
  batch           ImportBatch?               @relation(fields: [batchId], references: [id], onDelete: SetNull)
  stays           LodgingStay[]
  membershipLinks LodgingMembershipLodging[]

  @@unique([userId, externalRef])
  @@index([userId])
  @@index([userId, type])
  @@index([chainId])
  @@index([batchId])
  @@map("lodgings")
}

model LodgingStay {
  id               String    @id @default(uuid())
  lodgingId        String    @map("lodging_id")
  userId           String    @map("user_id")
  tripId           String?   @map("trip_id")
  bookingId        String?   @map("booking_id")
  /// Hotel-local, do not normalize to UTC.
  ///
  /// NULLABLE since 2.7: a hotel you remember but cannot date is still a place
  /// you slept, and rating/price/board/room/membership all live on the STAY —
  /// so without a dateless stay those data points had nowhere to go. Flights
  /// (`departure_time`) and cruises (`start_date`) have always allowed this;
  /// lodging was the odd one out. What the dates mean is qualified by
  /// `date_precision`.
  checkIn          DateTime? @map("check_in")
  checkOut         DateTime? @map("check_out")
  /// Optional wall-clock times ("HH:mm", hotel-local like the dates) for the
  /// check-in/check-out DAY above. Stored separately so the UTC-midnight day
  /// anchors — which the FX snapshot, night counting and status derivation
  /// all key on — never shift. Only the "Als Nächstes" countdown combines
  /// day + time; everything else keeps reading the dates alone. Meaningful
  /// only at DAY precision (schema-enforced). Tester wish, #dev-talk
  /// 2026-08-18: a planned hotel should not "begin" at midnight.
  checkInTime      String?   @map("check_in_time")
  checkOutTime     String?   @map("check_out_time")
  /// How much of the date is actually known: DAY (both dates real) | MONTH
  /// ("July 2011", stored as the 1st) | YEAR ("some time in 2011", stored as
  /// 1 January) | NONE (no idea, both dates null).
  ///
  /// Mirrors `Flight.dep_time_semantics`, which exists for the same reason: a
  /// placeholder that is not marked as one gets aggregated as if it were real.
  /// A MONTH-precision stay must never land in a weekday histogram, and a
  /// YEAR-precision one must never land in a month histogram — see
  /// shared/lodgingTiming.ts, which is the only place that decides this.
  datePrecision    String    @default("DAY") @map("date_precision")
  /// Nights, when the dates cannot supply them. "Three nights, no idea when"
  /// is a different gap from "July 2011, no idea how long", and one field
  /// cannot express both. Null = unknown; the dates win wherever they can
  /// answer (DAY precision with both ends).
  nights           Int?
  status           String    @default("completed") // scheduled | in_progress | completed | cancelled
  roomNumber       String?   @map("room_number")
  roomCategory     String?   @map("room_category")
  board            String?   // none | breakfast | half | full | all_inclusive
  // How many people the booking covered, as the confirmation states it. A COUNT,
  // never a name: a confirmation names the booker, so who came along stays the
  // user's to enter in `companions`. Kept so the stay editor can point at that
  // field when a booking covered more than one person.
  guests           Int?
  pricePerNight    Float?    @map("price_per_night")
  currency         String    @default("EUR")
  totalPrice       Float?    @map("total_price")
  totalPriceBase   Float?    @map("total_price_base")   // FX snapshot (§7.1)
  fxRate           Float?    @map("fx_rate")
  fxRateDate       DateTime? @map("fx_rate_date")
  fxBaseCurrency   String?   @map("fx_base_currency")
  // 'ecb' | 'cdn' | 'manual' — which provider produced the snapshot above.
  // A rate alone cannot say whether it is official or the user's own estimate.
  fxSource         String?   @map("fx_source")
  isAwardStay      Boolean   @default(false) @map("is_award_stay")
  ratingRoom       Float?    @map("rating_room")
  ratingBreakfast  Float?    @map("rating_breakfast")
  ratingService    Float?    @map("rating_service")
  ratingOverall    Float?    @map("rating_overall")
  roomAmenities    String[]  @default([]) @map("room_amenities")
  bookingReference String?   @map("booking_reference")
  membershipId     String?   @map("membership_id")
  /// true = the user explicitly used NO programme for this stay. Distinct from
  /// `membershipId = null`, which means "derive it from the hotel"
  /// (shared/membershipDerivation.ts).
  membershipOptOut Boolean   @default(false) @map("membership_opt_out")
  receiptUrl       String?   @map("receipt_url")
  companions       String[]  @default([])
  notes            String?
  parserTemplate   String?   @map("parser_template")
  parserConfidence Int?      @map("parser_confidence")
  dataSource       String?   @map("data_source")
  externalRef      String?   @map("external_ref") // e.g. "booking:5087376273"
  batchId          String?   @map("batch_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  lodging    Lodging             @relation(fields: [lodgingId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip       Trip?               @relation(fields: [tripId], references: [id], onDelete: SetNull)
  booking    Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  membership LodgingMembership?  @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  batch      ImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([userId, externalRef])
  @@index([lodgingId])
  @@index([userId, checkIn])
  @@index([status])
  @@index([tripId])
  @@index([bookingId])
  @@index([membershipId])
  @@index([batchId])
  @@map("lodging_stays")
}

model LodgingChain {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  brandColor     String?  @map("brand_color")
  loyaltyProgram String?  @map("loyalty_program")
  isUserAdded    Boolean  @default(false) @map("is_user_added")
  createdAt      DateTime @default(now()) @map("created_at")

  lodgings    Lodging[]
  memberships LodgingMembershipChain[]

  @@map("lodging_chains")
}

model LodgingMembership {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  programName      String   @map("program_name")
  membershipNumber String?  @map("membership_number")
  tier             String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stays    LodgingStay[]
  chains   LodgingMembershipChain[]
  lodgings LodgingMembershipLodging[]

  @@unique([userId, programName])
  @@index([userId])
  @@map("lodging_memberships")
}

/// Which chains a membership covers, linked BY ID.
///
/// The chain page used to find "your membership for this chain" by comparing
/// `LodgingChain.loyaltyProgram` to `LodgingMembership.programName` as
/// strings. Loyalty programmes get rebranded — NH Rewards -> NH DISCOVERY
/// (2022) -> Minor DISCOVERY — so that join broke on the day either side was
/// corrected: a user whose card says "Minor DISCOVERY" saw nothing on the NH
/// page, and the membership form had to LOCK the programme name to keep the
/// comparison alive. An id link survives every rename, and one membership can
/// legitimately cover several brands (Minor DISCOVERY: NH, NH Collection,
/// nhow, Anantara, Tivoli).
///
/// `LodgingChain.loyaltyProgram` survives as a SUGGESTION only — it seeds
/// which chains to pre-select and what to prefill the name with. It is no
/// longer load-bearing, so a stale catalogue value costs a checkbox, not a
/// missing membership.
model LodgingMembershipChain {
  membershipId String   @map("membership_id")
  chainId      Int      @map("chain_id")
  createdAt    DateTime @default(now()) @map("created_at")

  membership LodgingMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  chain      LodgingChain      @relation(fields: [chainId], references: [id], onDelete: Cascade)

  @@id([membershipId, chainId])
  @@index([chainId])
  @@map("lodging_membership_chains")
}

/// Which INDEPENDENT hotels a membership covers, linked BY ID.
///
/// Mirrors LodgingMembershipChain so that "what does this card cover" is one
/// idea with one editor. It exists for a hotel that offers a programme without
/// belonging to a chain.
///
/// There is deliberately NO constraint tying this to `lodging.chain_id IS
/// NULL`. A chain link always WINS over one of these
/// (shared/membershipDerivation.ts), so assigning a chain to the hotel later
/// makes this row dormant rather than invalid. The alternative — enforcing the
/// rule in the database — would force a choice between blocking a legitimate
/// chain correction and silently deleting the user's link.
model LodgingMembershipLodging {
  membershipId String   @map("membership_id")
  lodgingId    String   @map("lodging_id")
  createdAt    DateTime @default(now()) @map("created_at")

  membership LodgingMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  lodging    Lodging           @relation(fields: [lodgingId], references: [id], onDelete: Cascade)

  @@id([membershipId, lodgingId])
  @@index([lodgingId])
  @@map("lodging_membership_lodgings")
}

/// A point of interest in the user's own world — the thing, not the visit.
///
/// Mirrors the Lodging/LodgingStay split one-for-one, and for the same reason:
/// a place visited twice must stay ONE row, or "places visited" can never be
/// counted. That is the whole argument of #177, which warned that a trip-scoped
/// POI and a global POI would be "two different kinds of POI" — here there is
/// only this one, and a trip is a VIEW of it via PlaceVisit.
///
/// Per-user, like Lodging: on a shared instance one user's list of McDonald's
/// is nobody else's business. Curated checklist targets live in their own
/// global tables and only become a Place once the user ticks them off.
model Place {
  id     String @id @default(uuid())
  userId String @map("user_id")

  name String
  /// Drives the pin ICON, deliberately not the pin hue: on a map any two
  /// categories can end up adjacent, and only ~3 categorical hues survive that
  /// all-pairs separation test. Mirrored in frontend/src/shared/placeCategories.ts.
  category String @default("other")

  /// REQUIRED, unlike Lodging.lat/lon — a place that cannot be drawn defeats
  /// the point of the domain, and every creation path (search hit, map click,
  /// manual entry) already yields a position. The migration honours this by
  /// NOT migrating coordinate-less trip stops rather than inventing a position.
  lat Float
  lon Float

  address        String?
  city           String?
  country        String?
  /// ISO 3166-1 alpha-2 derived from `country`, same contract as Lodging: the
  /// text field keeps whatever the source wrote, everything that GROUPS or
  /// COUNTS joins on this instead.
  isoCountryCode String? @map("iso_country_code")

  /// Geocoder provenance, e.g. "osm:node/240109189". The dedup key: picking the
  /// same restaurant out of search twice yields one row.
  externalRef String? @map("external_ref")

  /// Set when this place was materialised by ticking a curated checklist item.
  /// Null for anything the user created themselves. Reserved for Phase C; the
  /// column ships now so the unique index does not need a later table rewrite.
  curatedItemId String? @map("curated_item_id")

  /// Logbook or wishlist? Same question Lodging.visited answers — but note the
  /// OPPOSITE default. Lodging chose `true` because every row predating the
  /// column described a real stay; here the dominant creation path is "add a
  /// target to a list", and a wishlist entry silently counted as visited would
  /// inflate the headline number on day one.
  visited Boolean @default(false)

  notes      String?
  dataSource String? @map("data_source") // manual | import | curated
  batchId    String? @map("batch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch       ImportBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  visits      PlaceVisit[]
  listEntries PlaceListEntry[]

  @@unique([userId, externalRef])
  @@unique([userId, curatedItemId])
  @@index([userId])
  @@index([userId, category])
  @@index([userId, visited])
  @@map("places")
}

/// One visit to a Place. Replaces `TripStop` rows with `domain = 'poi'`.
///
/// This is what makes a trip a view rather than an owner, and it is also the
/// fix for #175 (several POIs on one day needed a time to sort by) — carrying
/// a DateTime instead of a date is the whole change.
model PlaceVisit {
  id      String  @id @default(uuid())
  placeId String  @map("place_id")
  userId  String  @map("user_id")
  tripId  String? @map("trip_id")

  /// Local wall-clock at the place — do NOT normalize to UTC. There is no
  /// timezone column and inventing one would be worse than the honest local
  /// reading; tripTimeline.ts already documents this for TripStop.
  ///
  /// Nullable: a place you know you visited but cannot date is still a visit
  /// (the LodgingStay 2.7 precedent). A visit dated in the FUTURE is not a
  /// visit yet and is excluded from every count — see shared/placeCounting.ts.
  visitedAt DateTime? @map("visited_at")

  /// Tie-break inside a day when two visits share a timestamp, or when
  /// visitedAt is null and the user dragged them into an order.
  orderIdx Int @default(0) @map("order_idx")

  notes  String?
  rating Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull, matching Booking.tripId: deleting a trip must not delete the
  /// evidence that the user stood in front of the Colosseum.
  trip  Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  photos PlaceVisitPhoto[]

  @@index([userId])
  @@index([placeId])
  @@index([tripId])
  @@index([userId, visitedAt])
  @@map("place_visits")
}

/// Photo proof for one visit.
///
/// Deliberately a MIRROR of TripPhoto rather than a generalisation of it.
/// Making TripPhoto polymorphic would touch the shipped Immich import job, the
/// album-resync ordering invariant and the asset proxy's ownership check —
/// three things CLAUDE.md flags as load-bearing. A parallel table costs one
/// small file and risks none of them.
model PlaceVisitPhoto {
  id           String  @id @default(uuid())
  placeVisitId String  @map("place_visit_id")
  filename     String
  mimetype     String
  sizeBytes    Int     @map("size_bytes")
  caption      String?
  sortIdx      Int     @default(0) @map("sort_idx")

  /// Immich provenance, set only when imported from a linked album.
  immichAssetId String? @map("immich_asset_id")

  createdAt DateTime @default(now()) @map("created_at")

  visit PlaceVisit @relation(fields: [placeVisitId], references: [id], onDelete: Cascade)

  @@index([placeVisitId])
  @@map("place_visit_photos")
}

/// A user's own grouping of places — "Maccis weltweit", "Rom 2024".
///
/// Also the row that represents a SUBSCRIPTION to a shipped checklist: then
/// `curatedKey` is non-null and the name and membership come from the catalog
/// rather than the user. Both are the same kind of thing to everything that
/// renders a list, which is why they share one table.
model PlaceList {
  id     String @id @default(uuid())
  userId String @map("user_id")

  name        String
  description String?
  /// Defaults to the POI domain colour. What `list` colour mode resolves — the
  /// reason that mode could not exist before this table did.
  color   String  @default("#5ec2b2")
  icon    String?
  sortIdx Int     @default(0) @map("sort_idx")
  /// What this list's places are labelled with on the map: "name" or "icon".
  /// Only ever the list's DEFAULT -- the map's own control overrides it for the
  /// whole map, which is why this is a per-list column and not a user setting.
  /// A list with no `icon` always renders names whatever this says.
  labelMode String @default("name") @map("label_mode")

  /// Non-null when this list is the user's subscription to a shipped checklist
  /// (e.g. "world-wonders-new7"). A subscribed list's name and membership are
  /// not user-editable; its colour is.
  curatedKey String? @map("curated_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries PlaceListEntry[]

  @@unique([userId, curatedKey])
  @@index([userId])
  @@map("place_lists")
}

/// Membership. Its own table because a place belongs to MANY lists — the
/// McDonald's at the Trevi Fountain is in "Maccis" and in "Rom" at once, which
/// a column on `places` could never express.
model PlaceListEntry {
  id      String @id @default(uuid())
  listId  String @map("list_id")
  placeId String @map("place_id")
  sortIdx Int    @default(0) @map("sort_idx")

  createdAt DateTime @default(now()) @map("created_at")

  list  PlaceList @relation(fields: [listId], references: [id], onDelete: Cascade)
  place Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([listId, placeId])
  @@index([listId])
  @@index([placeId])
  @@map("place_list_entries")
}

/// NOT application data — the receipt of the POI backfill.
///
/// `20260823150500_poi_backfill_from_trip_stops` copies POI trip stops into
/// places and deliberately deletes nothing; this table records which stop
/// became which visit, so the contract migration one release later can delete
/// exactly those and nothing else. On production the backfill runs for the
/// first time at the 2.6.0 promote, which makes this the ONLY record of it.
///
/// It is declared here purely so `prisma migrate dev` stops proposing to drop
/// it. It was created by raw SQL and had no model, so the very next generated
/// migration led with `DROP TABLE "_poi_backfill_audit"` — which would have
/// left the contract half with nothing to work from. Nothing reads it through
/// the client; the contract migration drops both the table and this model.
model PoiBackfillAudit {
  tripStopId   String   @id @map("trip_stop_id")
  placeVisitId String   @map("place_visit_id")
  migratedAt   DateTime @default(now()) @map("migrated_at")

  @@map("_poi_backfill_audit")
}

/// A checklist the INSTANCE ships — the same category of thing as Port, Ship
/// and LodgingChain, all of which seed from CSV idempotently. Global and
/// read-only; a user's progress against it lives in their own Place rows, never
/// here.
model CuratedList {
  key String @id

  /// User-facing, so it follows the project language rule: German is the
  /// primary copy and English is mirrored beside it. A catalog row cannot go
  /// through i18n resource files the way UI copy does, so the pair lives in
  /// the table and the client picks by locale, falling back to `name`.
  name        String
  nameEn      String? @map("name_en")
  description String?
  descriptionEn String? @map("description_en")

  icon    String?
  sortIdx Int     @default(0) @map("sort_idx")

  items CuratedPlace[]

  @@map("curated_lists")
}

/// One target inside a shipped checklist. A target, NOT a pin: it becomes a
/// drawable place only when the user ticks it, which is what keeps the promise
/// that every pin on the globe is a real Place.
model CuratedPlace {
  id      String @id
  listKey String @map("list_key")

  /// German primary, English mirrored — see CuratedList.name. Most landmark
  /// names are identical in both ("Machu Picchu", "Petra"); `nameEn` is null
  /// for those rather than a duplicate, and the client falls back.
  name    String
  nameEn  String? @map("name_en")
  blurb   String?
  blurbEn String? @map("blurb_en")

  lat            Float
  lon            Float
  country        String?
  isoCountryCode String? @map("iso_country_code")
  sortIdx        Int     @default(0) @map("sort_idx")

  list CuratedList @relation(fields: [listKey], references: [key], onDelete: Cascade)

  @@index([listKey])
  @@map("curated_places")
}

/// One import run (CSV file, e-mail or PDF). Every row it created carries its
/// id, so a 232-row import that turns out wrong is revertible as a unit.
/// One import, as a unit the user can take back.
///
/// Started life as `LodgingImportBatch` because stays were the only domain
/// that logged its imports; flights and cruises wrote their rows and left no
/// trace, so "undo" existed for one area out of three. The model is the same
/// for all of them — what differs is only which rows point at it, hence the
/// `domain` column and one relation per domain rather than three near-identical
/// tables.
model ImportBatch {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  domain    String // flight | cruise | lodging
  source    String // csv | email | pdf
  fileName  String?  @map("file_name")
  createdAt DateTime @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lodgings Lodging[]
  stays    LodgingStay[]
  flights  Flight[]
  cruises  Cruise[]
  places   Place[]

  @@index([userId])
  @@index([userId, domain])
  @@map("import_batches")
}

model Airline {
  id          Int     @id @default(autoincrement())
  iata        String? @unique
  icao        String?
  name        String
  callsign    String?
  country     String?
  active      Boolean @default(true)
  isUserAdded Boolean @default(false) @map("is_user_added")

  @@index([name])
  @@index([icao])
  @@map("airlines")
}

model Aircraft {
  id          Int     @id @default(autoincrement())
  icao        String? @unique
  name        String
  isUserAdded Boolean @default(false) @map("is_user_added")

  @@index([name])
  @@map("aircraft")
}

model Companion {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  canonicalName String   @map("canonical_name")
  displayName   String   @map("display_name")
  searchName    String   @map("search_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  flights FlightCompanion[]
  trips   TripCompanion[]
  cruises CruiseCompanion[]

  @@unique([userId, canonicalName])
  @@index([userId, searchName])
  @@map("companions")
}

model FlightCompanion {
  flightId    String @map("flight_id")
  companionId String @map("companion_id")
  position    Int

  flight    Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@id([flightId, companionId])
  @@index([companionId])
  @@map("flight_companions")
}

model TripCompanion {
  tripId      String @map("trip_id")
  companionId String @map("companion_id")
  position    Int

  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@id([tripId, companionId])
  @@index([companionId])
  @@map("trip_companions")
}

model CruiseCompanion {
  cruiseId    String @map("cruise_id")
  companionId String @map("companion_id")
  position    Int

  cruise    Cruise    @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@id([cruiseId, companionId])
  @@index([companionId])
  @@map("cruise_companions")
}

/// A stretch of photos that looks like travel nobody recorded.
///
/// Derived from the user's own Immich library: photos cluster in time,
/// the clusters that no flight, cruise, trip or stay explains are
/// reverse-geocoded, and what comes back is offered as a suggestion.
///
/// Never a fact and never applied on its own. A photo proves where a
/// CAMERA was, which is usually but not always where its owner was — a
/// shared album, a picture taken by someone else, an import from a
/// friend. So every row here waits for a person to accept it.
model PhotoJourney {
  id     String @id @default(uuid())
  userId String @map("user_id")

  /// pending | accepted | dismissed
  status String @default("pending")

  /// The cluster's span, from the first photo to the last.
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  photoCount Int @map("photo_count")
  /// How many of those carried a coordinate. A cluster located by two
  /// photos out of sixty deserves less trust than one located by all of
  /// them, and the UI should be able to say so.
  locatedCount Int @map("located_count")

  /// Representative position — the median of the located photos.
  lat Float
  lon Float

  /// What the reverse lookup made of that position. Null when it
  /// answered nothing: an ocean, a desert, or Nominatim being down. The
  /// row still stands, because the DATES are the find.
  countryCode String? @map("country_code")
  countryName String? @map("country_name")
  city        String?

  /// Immich asset ids for the preview strip, capped when written.
  /// Ids rather than images: the proxy already streams thumbnails and
  /// copying bytes into our own database would duplicate the library.
  previewAssetIds String[] @map("preview_asset_ids")

  /// Stable across re-scans, so a nightly job updates a row instead of
  /// stacking a new copy of the same journey every night. Derived from
  /// the user, the start date and the rounded position.
  fingerprint String

  /// Set when the user accepted it and something was created from it.
  createdTripId String? @map("created_trip_id")

  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, status])
  @@index([startDate])
  @@map("photo_journeys")
}
