model Backup {
  id              String    @id @default(uuid())
  type            String    @default("full") // "full" | "partial"
  status          String    @default("pending") // "pending" | "running" | "completed" | "failed"
  backupPath      String    @map("backup_path") // Path to backup archive
  dbBackupPath    String?   @map("db_backup_path") // Path to database dump
  filesBackupPath String?   @map("files_backup_path") // Path to files archive
