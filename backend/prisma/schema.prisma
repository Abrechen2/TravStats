model PendingFlightUpdate {
  id               String    @id @default(uuid())
  flightId         String    @map("flight_id")
  userId           String    @map("user_id")
  status           String    @default("pending") // "pending" | "applied" | "rejected" | "expired" | "edited"
  originalData     Json      @map("original_data")
  proposedData     Json      @map("proposed_data")
  editedData       Json?     @map("edited_data")
  changes          Json      @map("changes")
  editedChanges    Json?     @map("edited_changes")
  apiSource        String    @map("api_source") // "airlabs" | "aviationstack" | "opensky"
  fetchedAt        DateTime  @map("fetched_at")
