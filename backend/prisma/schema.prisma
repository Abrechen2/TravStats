/// A record that contradicts itself, raised as a QUESTION rather than settled.
///
/// Owner's decision, 2026-09-02 ("Unplausible Sachen markieren und in den
/// Posteingang", design §3.5): a geocoder that disagrees with the rest of a row
/// is not authority enough to refuse the user's own data — but it is more than
/// enough to ask. So the record is written unchanged, the disagreement is
/// flagged, and the question is queued where the user already answers questions
/// about their data.
///
/// **A flag never changes a number.** Counting continues under the stated rule
/// until the user answers. Withholding a country because a check was suspicious
/// would reintroduce, from the other direction, exactly the invisible arithmetic
/// the country-counting design removes.
///
/// ## Why this is not `PendingFlightUpdate`
///
/// That model carries a required `flightId`, an `apiSource` and an `expiresAt`:
/// it is flight-shaped by construction, and 858 lines of service depend on that
/// shape. It answers "a provider proposes these field values"; this answers "two
/// sources inside one of YOUR records disagree". One inbox in the UI, two tables
/// underneath, because the two are genuinely different things.
///
/// ## The subject is polymorphic, so there is no foreign key
///
/// `entityType` + `entityId` address a lodging, a place, or — for a finding that
/// is about a country rather than about a row — an ISO 3166-1 alpha-2 code.
/// Postgres cannot enforce that, which is the price of one inbox over one table
/// per subject. `dataQualityFlagService.listFlags` therefore drops a flag whose
/// subject has been deleted, and a re-run resolves it.
///
/// The column is a plain string on purpose: the vocabulary lives in
/// `schemas/dataQualityFlag.ts` (Zod) and widening it — a flight check, a cruise
/// check — costs no migration.
model DataQualityFlag {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  /// "lodging" | "place" | "country"
  entityType String    @map("entity_type")
  /// A row id, or an ISO 3166-1 alpha-2 code when entityType is "country".
  entityId   String    @map("entity_id")
  /// Which check fired. See `DATA_QUALITY_FLAG_KINDS`.
  kind       String
  /// "open" | "resolved" | "dismissed"
  status     String    @default("open")
  /// What disagreed, both values, and the records that proved it — so the row
  /// can be read without re-running the check, and so the UI can link to the
  /// records themselves (design §3.4).
  details    Json
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Re-running the checks must never duplicate a flag. It will run repeatedly
  /// — after an import, on demand — and a second copy of the same question is
  /// how an inbox becomes something people stop reading.
  @@unique([userId, entityType, entityId, kind])
  @@index([userId, status])
  @@map("data_quality_flags")
}

/// "On this day you were in this country" — the privacy-preserving projection
/// of a location history (design §8.4).
///
/// A movement trail is reduced to (day, country) and NOTHING else. TravStats
/// stores no coordinate from Dawarich, ever: the July concept
/// (`2026-07-04-dawarich-integration-concept.md` §3) makes location history
/// opt-in, key-encrypted and "never sent to the frontend", and the only way to
/// keep that promise while still counting countries is to throw the positions
/// away at the moment they are classified. The two numeric columns below are
/// scalars derived from points that are already out of memory by the time the
/// row is written — neither can be inverted back into a position.
///
/// After this table exists the count is a cheap read and catching up costs one
/// window, which is the whole reason §8.4 asks for it.
model CountryDay {
  /// ADR 0002 Q3: a documented exception to the time model — a UTC day,
  /// because a raw GPS point has no zone of its own. No zone column on purpose.
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  /// The UTC calendar day, at midnight UTC.
  ///
  /// UTC and not a local clock, deliberately, and it is a real limitation
  /// rather than a preference: the rest of this server reads a travel day at
  /// the DEPARTURE AIRPORT's clock, but a GPS point carries no such anchor —
  /// there is no airport, no port and no booking to borrow a timezone from.
  /// Guessing one from the coordinate would be an inference presented as a
  /// measurement, which §8.3 names as the failure this whole design exists to
  /// correct. So the bucket is the one clock the data actually carries, and a
  /// border crossed between 23:00 and 01:00 local may land on the neighbouring
  /// UTC day.
  date        DateTime
  /// ISO 3166-1 alpha-2, resolved offline by `services/geo/countryFromCoordinates.ts`.
  /// Never a name — everything that counts here joins on the code (§1.3).
  countryCode String   @map("country_code")
  /// Which pipeline observed the day. See `COUNTRY_DAY_SOURCES`
  /// (`services/countryDays/countryDaySource.ts`) for the vocabulary and for
  /// why it does NOT say "gps" or "photo": Dawarich 1.9.2's points payload,
  /// as measured, carries no provenance field at all, and a column that always
  /// answered "measured" would be exactly the inference-dressed-as-measurement
  /// §8.3 forbids. Part of the unique key so a second pipeline can observe the
  /// same day without overwriting this one's answer.
  source      String

  /// How many points attested this country on this day.
  ///
  /// A measurement, never a label. It is the ONE observable that separates a
  /// densely tracked day from a day held up by a single photo-derived fix, and
  /// §8.3 needs that distinction visible — but naming the sparse case
  /// "estimated" would be a judgement the payload does not support, so the
  /// count is published raw and whoever displays it decides. Same discipline as
  /// the ground time in §3.4b: shown as evidence, never used as a threshold.
  pointCount        Int     @map("point_count")
  /// How many of that day's points lay on the grounds of an airport this
  /// account is KNOWN to have flown through — the §8.2 signal.
  ///
  /// *"A GPS point in Doha is still a point in Qatar even if you never left the
  /// terminal."* Location history cannot tell a connection from a visit by
  /// itself; it becomes able to when the flights are read beside it. So each
  /// point is tested, while it is still in memory, against the coordinates of
  /// the airports this user's own flown flights name — and only those, because
  /// "an airport" is a place anybody might drive past, while "an airport you
  /// flew through" is a fact assembled from two records this server holds.
  ///
  /// Recovering it afterwards is impossible by construction: the positions are
  /// discarded inside `services/countryDays/reduce.ts` and never stored. That
  /// is why it is a column and not a derivation.
  ///
  /// A COUNT and not a verdict, the same discipline `pointCount` follows. The
  /// rule that reads it — every point airside means the country stays a
  /// `connection` — lives in `services/stats/trackEvidence.ts`, in one place,
  /// where it can be argued with. Rows written before this column existed read
  /// zero, which claims nothing was airside and so errs towards the STRONGER
  /// tier: the safe direction, since it keeps a country in the headline rather
  /// than dropping one out of it.
  airportPointCount Int     @default(0) @map("airport_point_count")
  /// The diagonal of the bounding box of that day's points inside this country,
  /// in kilometres — how far apart they were, never where they were.
  ///
  /// Kept as evidence a reader can weigh, NOT as the rule that separates the
  /// two lower rungs. That job went to `airport_point_count` above, because a
  /// bare kilometre cut-off is exactly the dial §2 refuses — it would call a
  /// compact city a connection and a sprawling airport a visit, and there is no
  /// value of it that is right.
  spanKm            Float   @map("span_km")
  /// True when the window this day came out of hit the client's `MAX_PAGES`
  /// cap even after being subdivided to a single day (`dawarichClient.ts`).
  ///
  /// It does NOT weaken the row: the country named here was genuinely
  /// observed. What it withdraws is the row's SILENCE — on a partial day the
  /// absence of a second country proves nothing, because Dawarich answers
  /// newest-first and the older part of the window was never seen. A partial
  /// window recorded as if whole is the measurement that lies, which is why
  /// this column exists rather than a log line.
  partialWindow     Boolean @default(false) @map("partial_window")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Re-sweeping is normal — the current month is re-read every night — so the
  /// same day observed twice must be one row, not two. This key is also the
  /// index that reads a user's days: its `(user_id)` and `(user_id, date)`
  /// prefixes serve both "every day this account has" and "the days in this
  /// window", so a separate index on those columns would only cost writes.
  @@unique([userId, date, countryCode, source])
  /// The passport's read: which countries, for this user. Not covered by the
  /// prefix above, because `date` sits between the two columns it needs.
  @@index([userId, countryCode])
  @@map("country_days")
}

/// How far each account's Dawarich history has been swept — the cursor that
/// makes catching up cost one window instead of a full replay (§8.4).
///
/// One row per account, created on the first sweep. An account with no
/// per-user Dawarich connection never gets one: the sweep does not enumerate
/// it at all, so a user without a connection costs nothing, not even a row.
model DawarichSweepState {
  userId String @id @map("user_id")

  /// Midnight UTC on the first day of the earliest month already swept. Null
  /// before the first run. The backwards walk continues from here.
  backfilledFromMonth DateTime? @map("backfilled_from_month")
  /// True once the backwards walk reached its floor and there is no more
  /// history to ask for. From then on a run costs exactly one window.
  backfillComplete    Boolean   @default(false) @map("backfill_complete")
  /// The newest instant covered by a completed forward sweep. A server that
  /// was off for three months resumes from here rather than from "now", so the
  /// missed months are not silently skipped.
  sweptThroughAt      DateTime? @map("swept_through_at")

  lastRunAt       DateTime? @map("last_run_at")
  /// The `DawarichErrorKind` of the last failure, or null after a clean run.
  ///
  /// The KIND and never the message: a Dawarich error message can carry the
  /// base URL, and a base URL is the address of the user's home server. The
  /// kind is a closed vocabulary of five words and says everything an operator
  /// needs in order to act.
  lastErrorKind   String?   @map("last_error_kind")
  /// Start of the most recent single-day window that was STILL truncated after
  /// subdivision — i.e. the one case where the sweep knowingly stored an
  /// incomplete day. Null on every healthy instance; a value here is the
  /// pointer to the `partial_window` rows.
  lastTruncatedAt DateTime? @map("last_truncated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dawarich_sweep_state")
}

