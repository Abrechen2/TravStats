// This is your Prisma schema file

// Prisma 7 replaced `prisma-client-js` with `prisma-client`: no more magic
// generation into node_modules, and `output` is required. The client is now
// plain TypeScript that `tsc` compiles alongside the rest of `src`, which is
// why it lives under `src/` — the compiled copy lands in `dist/generated/prisma`
// and the production image needs no `prisma generate` at all.
//
// `moduleFormat = "cjs"` is not a preference: this backend compiles to
// CommonJS (tsconfig `"module": "commonjs"`), and an ESM client would throw
// `ReferenceError: exports is not defined` the moment `dist/index.js` loaded it.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  // `partialIndexes`: the chain catalogue is unique by name among its
  // catalogue rows only (`LodgingChain`, user_id IS NULL) — Postgres treats
  // NULLs as distinct, so a plain (name, user_id) unique would not hold it.
  previewFeatures = ["partialIndexes"]
}

// Prisma 7 deprecated `url` / `directUrl` / `shadowDatabaseUrl` in the schema:
// the connection string belongs to `prisma.config.ts` for the CLI and to the
// driver adapter in `src/db.ts` for the runtime. Leaving a stale copy here
// would be a second source of truth that nothing reads.
datasource db {
  provider = "postgresql"
}

model User {
  id                     String                   @id @default(uuid())
  devicePushes           DevicePush[]
  username               String                   @unique
  passwordHash           String                   @map("password_hash")
  // Real name, shown wherever the person is addressed rather than identified
  // (#241). Columns on User rather than keys in the UserSettings JSON blob
  // where profilePicture lives: the header renders the name on every page from
  // the /auth/me payload, and reading it out of settings would make the header
  // wait for a second fetch and flash the username first. Both optional — a
  // logbook does not need your name.
  firstName              String?                  @map("first_name")
  lastName               String?                  @map("last_name")
  isAdmin                Boolean                  @default(false) @map("is_admin")
  isActive               Boolean                  @default(true) @map("is_active")
  invitedBy              String?                  @map("invited_by")
  createdAt              DateTime                 @default(now()) @map("created_at")
  // Email notification preferences
  notificationEmail      String?                  @map("notification_email")
  notifyBefore24h        Boolean                  @default(false) @map("notify_before_24h")
  notifyBefore2h         Boolean                  @default(false) @map("notify_before_2h")
  // Birthday for the BIRTHDAY_FLIGHT achievement. Only month+day are used;
  // the full DateTime lets us round-trip a year if the user enters one.
  birthdate              DateTime?                @map("birthdate")
  /// ADR 0002 phase 2 (dual-write): the birthday as a floating calendar day —
  /// no zone, it means the same day everywhere. `birthdate` keeps its old
  /// meaning (UTC midnight) until phase 6 drops it.
  birthDay               DateTime?                @map("birth_day") @db.Date
  /// day | unknown — how much of `birthDay` the user actually gave.
  birthPrecision         String?                  @map("birth_precision")
  resetToken             String?                  @unique @map("reset_token")
  resetTokenExpiry       DateTime?                @map("reset_token_expiry")
  mustChangePassword     Boolean                  @default(false) @map("must_change_password")
  changeToken            String?                  @unique @map("change_token")
  changeTokenExpiry      DateTime?                @map("change_token_expiry")
  // Bumped by every password change and reset. A session carries the epoch it
  // was minted under, and `authenticate` refuses anything older — see
  // middleware/auth.ts. A counter rather than a timestamp because `iat` has
  // second resolution, which would leave a one-second window open.
  sessionEpoch           Int                      @default(0) @map("session_epoch")
  // Two-factor (TOTP). Opt-in per user — null everywhere means "not using it",
  // which is the state every account starts in and most stay in.
  // `twoFactorSecret` is ENCRYPTED at rest via utils/encryption.ts; the pending
  // one holds a secret that has been shown as a QR code but not yet confirmed
  // by a first correct code, so an abandoned setup never locks anyone out.
  twoFactorSecret        String?                  @map("two_factor_secret")
  twoFactorPendingSecret String?                  @map("two_factor_pending_secret")
  twoFactorEnabledAt     DateTime?                @map("two_factor_enabled_at")
  // Short-lived login challenge, hashed like changeToken above: the password
  // was right, the second factor is still outstanding.
  twoFactorToken         String?                  @unique @map("two_factor_token")
  twoFactorTokenExpiry   DateTime?                @map("two_factor_token_expiry")
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  webauthnCredentials    WebAuthnCredential[]
  // True for users seeded by `seedDemoUser` (e.g. local dev `admin:admin123`).
  // Used to gate quota-burning admin actions like bulk historical refresh so
  // the dev demo can't drain a real RapidAPI key by accident.
  isDemo                 Boolean                  @default(false) @map("is_demo")
  flights                Flight[]
  receiptUploads         ReceiptUpload[]
  userAchievements       UserAchievement[]
  settings               UserSettings?
  analyticsEvents        AnalyticsEvent[]
  createdInvitations     Invitation[]             @relation("CreatedInvitations")
  usedInvitations        Invitation[]             @relation("UsedInvitations")
  trainingData           TrainingData[]
  parserTemplates        ParserTemplate[]
  pendingFlightUpdates   PendingFlightUpdate[]
  pendingUpdateStats     PendingUpdateStatistics?
  parseLogs              ParseTrainingLog[]
  trips                  Trip[]
  tourRoutes             TripRoute[]
  tripExpenses           TripExpense[]
  bookings               Booking[]
  cruises                Cruise[]
  railJourneys           RailJourney[]
  rentalBookings         RentalBooking[]
  apiTokens              ApiToken[]
  pairingCodes           PairingCode[]
  lodgings               Lodging[]
  lodgingStays           LodgingStay[]
  loyaltyMemberships     LoyaltyMembership[]
  lodgingChains          LodgingChain[]
  places                 Place[]
  placeVisits            PlaceVisit[]
  visitPhotoRefusals     VisitPhotoRefusal[]
  placeLists             PlaceList[]
  importBatches          ImportBatch[]
  companions             Companion[]
  photoJourneys          PhotoJourney[]
  tripSuggestionAnswers  TripSuggestionDecision[]
  dataQualityFlags       DataQualityFlag[]
  countryDays            CountryDay[]
  dawarichSweepState     DawarichSweepState?

  documents Document[]

  passwordResetRequest PasswordResetRequest?

  @@map("users")
}

/// "I forgot my password, and this instance cannot send me a mail."
///
/// An instance without SMTP used to answer that request with a sentence and
/// nothing else: the dialog told the user to contact an administrator, and no
/// administrator ever learned that anyone had asked (forgejo#88, point 2). The
/// row below is the message. It is written by the unauthenticated
/// `POST /auth/forgot-password` and read only by admins, in the inbox.
///
/// **One row per user, by the unique key.** That is what keeps an
/// unauthenticated write bounded: the route can be called a thousand times and
/// the table still cannot grow past the user table, because a repeat is an
/// UPDATE of `requestedAt`, not a second row. A name that matches no account
/// writes nothing at all — so the table also never learns a username that does
/// not exist, and the route keeps answering the same neutral 200 either way.
///
/// `handledAt` is the admin's "done". A later request re-opens the same row
/// (`handledAt` back to null) rather than inserting beside it — asking twice is
/// still one open question.
model PasswordResetRequest {
  id String @id @default(uuid())

  /// Unique: see above. The dedupe is the storage guarantee, not a convention.
  userId      String    @unique @map("user_id")
  requestedAt DateTime  @default(now()) @map("requested_at")
  handledAt   DateTime? @map("handled_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The inbox asks one question: which requests are still open.
  @@index([handledAt])
  @@map("password_reset_requests")
}

/// Personal Access Tokens for programmatic API access.
///
/// The plaintext token is shown to the user exactly once on creation
/// (formatted as `ts_pat_<32-byte-hex>`). Only the bcrypt hash is
/// persisted, so a leaked DB never exposes usable tokens.
///
/// Scopes are intentionally coarse for v1: a single token grants
/// `read`, `write`, or `admin`. Finer-grained per-resource scopes can
/// be layered on later via the `scopes` Json field if needed.
///
/// `lookupHash` is a fast SHA-256 of the plaintext, indexed for O(1)
/// row retrieval on every request — bcrypt is then used as the actual
/// constant-time secret comparison. Without this, every API request
/// would have to bcrypt-compare against every active token.
model ApiToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  lookupHash String    @unique @map("lookup_hash")
  hash       String
  scope      String    @default("read")
  prefix     String    @default("ts_pat_")
  lastUsedAt DateTime? @map("last_used_at")
  lastUsedIp String?   @map("last_used_ip")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Device-pairing metadata. Populated when a token is minted via the
  // mobile pairing flow (POST /api/v1/pairing/claim). `deviceId` lets the
  // claim path revoke a prior token for the same physical device so a
  // re-pair doesn't leave orphaned credentials behind.
  deviceId   String? @map("device_id")
  platform   String?
  appVersion String? @map("app_version")

  // The paired phone's push registration (Companion, TravStats#156). Its own
  // row so the token table stays an auth table; a revoked token's push row is
  // deleted by the revoke paths (revocation is soft, so the cascade below only
  // covers a hard delete).
  devicePush DevicePush?

  @@index([userId])
  @@index([userId, deviceId])
  @@map("api_tokens")
}

/// A paired phone's push token and X25519 public key (spec §3.2). The key
/// encrypts each notification for this phone alone (`travstats-push v1`);
/// the token addresses it through push.travstats.de at Apple or Google.
model DevicePush {
  apiTokenId      String   @id @map("api_token_id")
  apiToken        ApiToken @relation(fields: [apiTokenId], references: [id], onDelete: Cascade)
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "ios" | "android"
  platform        String
  token           String
  /// "production" | "sandbox" — iOS only, from the build's entitlement.
  apnsEnvironment String?  @map("apns_environment")
  /// base64url, 32 bytes
  publicKey       String   @map("public_key")
  flightChanges   Boolean  @default(true) @map("flight_changes")
  reminders       Boolean  @default(true)
  /// "de" | "en" — the language the server writes this phone's texts in.
  locale          String   @default("de")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  deliveries PushDelivery[]

  @@index([userId])
  @@map("device_push")
}

/// One notification already sent to one phone. The unique pair is the
/// dedupe: the 5-minute status job must never send the same change twice.
model PushDelivery {
  id         String     @id @default(uuid())
  apiTokenId String     @map("api_token_id")
  device     DevicePush @relation(fields: [apiTokenId], references: [apiTokenId], onDelete: Cascade)
  /// e.g. "flight:<id>:gate:B12" or "reminder:<flightId>:24h"
  eventKey   String     @map("event_key")
  sentAt     DateTime   @default(now()) @map("sent_at")

  @@unique([apiTokenId, eventKey])
  @@index([sentAt])
  @@map("push_deliveries")
}

/// One-time pairing codes for the mobile device-pairing flow.
///
/// A browser session calls POST /api/v1/pairing/start, which creates a
/// short-lived code (10 min). Only its SHA-256 (`codeHash`) is persisted —
/// the plaintext is shown to the user as a QR / typed code and never stored.
/// The mobile app posts the plaintext to POST /api/v1/pairing/claim, which
/// atomically consumes the row (sets `consumedAt`) and mints a device PAT.
/// `consumedAt` guards against double-claims: a conditional update on
/// `consumedAt = null` means only one concurrent claim can win.
model PairingCode {
  id         String    @id @default(uuid())
  codeHash   String    @unique @map("code_hash")
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("pairing_codes")
}

/// Single-use recovery codes, the way back in when the phone is gone.
///
/// Stored as bcrypt hashes for the same reason passwords are: a database dump
/// must not hand over a working credential. `usedAt` rather than deletion so a
/// user can see that a code was spent, and when.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

/// One registered passkey. A user may have several — phone, laptop, hardware
/// key, password manager — and revoking one must not touch the others.
model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Base64url credential ID as returned by the authenticator. Unique across the
  /// instance: the login flow looks a credential up by this alone, before it
  /// knows which user is signing in.
  credentialId String    @unique @map("credential_id")
  publicKey    String    @map("public_key")
  /// Signature counter. A counter that goes backwards means the credential was
  /// cloned. Note that many syncing authenticators (iCloud Keychain, Bitwarden)
  /// legitimately keep it at 0 forever — only a DECREASE from a non-zero value
  /// is evidence of anything.
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  /// What the user calls it ("MacBook", "Bitwarden"). Theirs to edit.
  name         String
  /// The RP ID this credential was minted under. Stored so the settings list can
  /// show WHY a key does not work when the instance is reached under another
  /// origin, instead of leaving the user guessing.
  rpId         String    @map("rp_id")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("webauthn_credentials")
}

model Airport {
  id               Int     @id @default(autoincrement())
  iata             String?
  icao             String?
  name             String
  city             String?
  country          String?
  lat              Float
  lon              Float
  altitude         Int?
  timezone         String?
  shortName        String? @map("short_name")
  municipalityName String? @map("municipality_name")
  /// True if the airport has been permanently closed (e.g. Berlin Tegel TXL
  /// after 2020-11-08). Users can still pick closed airports for historical
  /// flights — the UI just marks them visually.
  isClosed         Boolean @default(false) @map("is_closed")

  /// Manually added via the admin master-data page (#191). Same invariant as
  /// Ship/Port/Airline/Aircraft: the CSV re-seed never overwrites these rows.
  isUserAdded   Boolean         @default(false) @map("is_user_added")
  rentalPickups RentalBooking[] @relation("RentalPickupAirport")
  rentalReturns RentalBooking[] @relation("RentalReturnAirport")

  // Composite uniqueness on (code, isClosed) lets the same IATA or ICAO
  // exist twice — once for the active airport and once for its closed
  // predecessor (e.g. Munich Airport EDDM/MUC + Munich-Riem EDDM/MUC).
  @@unique([iata, isClosed], name: "airports_iata_is_closed_key")
  @@unique([icao, isClosed], name: "airports_icao_is_closed_key")
  @@index([iata])
  @@index([icao])
  @@index([name])
  @@index([city])
  @@map("airports")
}

model Flight {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  airline              String?
  airlineIata          String?   @map("airline_iata")
  airlineIcao          String?   @map("airline_icao")
  operatingAirline     String?   @map("operating_airline")
  operatingAirlineIata String?   @map("operating_airline_iata")
  operatingAirlineIcao String?   @map("operating_airline_icao")
  isCodeshare          Boolean?  @map("is_codeshare")
  flightNumber         String?   @map("flight_number")
  callsign             String?
  aircraft             String?
  aircraftRegistration String?   @map("aircraft_registration")
  aircraftModeS        String?   @map("aircraft_mode_s")
  depIcao              String?   @map("dep_icao")
  depIata              String?   @map("dep_iata")
  depName              String?   @map("dep_name")
  depLat               Float     @map("dep_lat")
  depLon               Float     @map("dep_lon")
  arrIcao              String?   @map("arr_icao")
  arrIata              String?   @map("arr_iata")
  arrName              String?   @map("arr_name")
  arrLat               Float     @map("arr_lat")
  arrLon               Float     @map("arr_lon")
  departureTime        DateTime? @map("departure_time")
  arrivalTime          DateTime? @map("arrival_time")
  status               String    @default("scheduled") // scheduled, flown, cancelled, historical
  notes                String?
  // Boarding Pass Information
  seatNumber           String?   @map("seat_number")
  seatClass            String?   @map("seat_class") // economy, premium_economy, business, first
  boardingGroup        String?   @map("boarding_group")
  gate                 String?
  terminal             String?
  bookingReference     String?   @map("booking_reference")
  ticketNumber         String?   @map("ticket_number")
  // Costs & categorization
  price                Float?    @map("price")
  currency             String?   @default("EUR") @map("currency")
  taxes                Float?    @map("taxes")
  fees                 Float?    @map("fees")
  /// FX snapshot (#267). `price + taxes + fees` converted into the user's base
  /// currency at the rate for the DEPARTURE day, with the rate, its day and its
  /// source kept alongside. Statistics used to sum `price` across currencies
  /// with no conversion at all and render the result with the user's display
  /// symbol, so 300 USD + 300 EUR was reported as "600 €". Null where no
  /// honest conversion was possible (no date, no currency, no rate) — those
  /// amounts are reported per currency instead of being folded into a total.
  priceBase            Float?    @map("price_base")
  fxRate               Float?    @map("fx_rate")
  fxRateDate           DateTime? @map("fx_rate_date")
  fxBaseCurrency       String?   @map("fx_base_currency")
  fxSource             String?   @map("fx_source")
  // No column default: category is genuinely optional. The old
  // @default("private") silently classified every API import that omitted
  // the field, while the UI suggested "business" — two systems, two
  // opinions, neither of them the user's (dropped 2026-08-02).
  category             String?   @map("category") // business, private, vacation
  tags                 String[]  @default([]) @map("tags")
  companions           String[]  @default([]) @map("companions") // User-defined travel group (set manually, vs. coPassengers = auto-parsed from email)
  receiptUrl           String?   @map("receipt_url")
  ticketPrice          Float?    @map("ticket_price")
  createdAt            DateTime  @default(now()) @map("created_at")
  /// Bumped by every Prisma write. Read by the statistics ETag (forgejo#50):
  /// without it an edited flight could not be told apart from an unchanged one.
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  // Route tracking
  actualRoute          Json?     @map("actual_route") // Array of waypoints [{lat, lon, timestamp, country?}]
  overflownCountries   String[]  @default([]) @map("overflown_countries")
  routeDistance        Float?    @map("route_distance")
  // MEASURED flight time in minutes — the clocks, never an estimate. The
  // estimate stays where it belongs, in `shared/flightDuration.ts`, which
  // labels it as a guess; this column only ever carries evidence.
  //
  // Postgres computes it (GENERATED ALWAYS ... STORED). No application code
  // writes it and none can, which is the entire point. The value has four
  // inputs — departure_time, arrival_time and the two *_time_semantics tags —
  // and eight code paths write at least one of them (both create routes, the
  // update route, pendingUpdateService, flightAutoUpdate, bulkFlightRefresh
  // and two backfill scripts). A write-through column stays true only until
  // someone adds the ninth and does not know it exists; a stale duration is
  // worse than a derived one, so the invariant is enforced where every writer
  // meets — in the table — rather than asked of every writer in turn.
  //
  // Float, not Int, deliberately: this is byte-for-byte what
  // `tzAwareDurationMinutes` returns, so an aggregate that sums the column
  // lands on the total it lands on today. Rounding is the API's job at the
  // edge, as it already was.
  //
  // NULL carries TWO different facts and readers must not merge them:
  //   1. Unmeasurable — a time is missing, or a side is tagged DATE_ONLY,
  //      whose 12:00 placeholder is not evidence (#106A). "No duration",
  //      never 0; `resolveFlightDuration` then estimates from coordinates and
  //      SAYS it estimated.
  //   2. Not expressible here — BOTH sides tagged LEGACY_FAKE_UTC. Such a row
  //      stores a wall-clock pair that only becomes an instant through its
  //      AIRPORTS' timezones, so its duration is not a function of this row at
  //      all: correcting an airport's tz moves the answer while the row stands
  //      still. Storing a value the table cannot keep true is the one thing
  //      worse than not storing one, so it stores nothing and the reader
  //      derives it from the catalogue exactly as before. That class is closed
  //      — nothing creates LEGACY_FAKE_UTC rows any more and
  //      `scripts/fixMistaggedDurations.ts` retags them to UTC — so the derived
  //      path shrinks over time instead of spreading.
  //
  // Read it through `measuredDurationMinutes()` (utils/flightDurationColumn.ts),
  // which tells those two NULLs apart. Reading the column raw silently demotes
  // a legacy row's measurement to a coordinate estimate.
  //
  // `@default(dbgenerated())` is how Prisma is told "the database fills this
  // in": without it every `migrate diff` wants to DROP the generated
  // expression it cannot see.
  durationMinutes      Float?    @default(dbgenerated()) @map("duration_minutes")
  routeSource          String?   @map("route_source") // 'live_tracking', 'historical_aggregation', 'estimated'
  hasLiveTracking      Boolean   @default(false) @map("has_live_tracking")
  // Data source tracking
  dataSource           String?   @map("data_source") // 'manual', 'email_import', 'boarding_pass_scan', 'historical_enrichment', 'live_update', 'api_lookup', 'bulk_import', 'imported_fr24', 'imported_generic_csv', 'imported_roundtrip'
  // Time-storage semantics for departureTime / arrivalTime.
  // 'UTC' = canonical real UTC instant (current writes always use this).
  // 'LEGACY_FAKE_UTC' = wall-clock encoded as fake-UTC; needs depTz/arrTz to
  // be interpreted as a real instant. Relic of the pre-canonical write path.
  // 'UNKNOWN' = not yet classified by the backfill script (DB-side default
  // for rows existing at the time of the ADD COLUMN migration). New writes
  // from Prisma default to 'UTC'.
  depTimeSemantics     String    @default("UTC") @map("dep_time_semantics")
  arrTimeSemantics     String    @default("UTC") @map("arr_time_semantics")
  /// ADR 0002: the IANA zone each end was WRITTEN with, frozen. Reads used to
  /// join the airport catalogue, so a catalogue correction moved the displayed
  /// time of every past flight there. Re-derived only when the airport itself
  /// changes (`routes/flights/timeInput.ts`). Null = not yet backfilled (3b).
  depTimezone          String?   @map("dep_timezone")
  arrTimezone          String?   @map("arr_timezone")
  /// minute | day | unknown (`shared/time/wire.ts` TIME_PRECISIONS).
  depPrecision         String?   @map("dep_precision")
  arrPrecision         String?   @map("arr_precision")
  lastModifiedBy       String?   @map("last_modified_by") // 'user', 'auto_update', 'historical_enrichment', 'api'
  enrichmentHistory    Json?     @map("enrichment_history") // Array of enrichment events [{type, timestamp, confidence?, source?}]

  // Phase 3: Actual Times, Delay, CO₂
  actualDeparture DateTime? @map("actual_departure")
  actualArrival   DateTime? @map("actual_arrival")
  delayMinutes    Int?      @map("delay_minutes")
  co2Kg           Float?    @map("co2_kg")

  // Phase 1: Email Template Parsing
  baggageAllowance    String?  @map("baggage_allowance")
  frequentFlyerNumber String?  @map("frequent_flyer_number")
  bookingClassLetter  String?  @map("booking_class_letter") // e.g. "Y", "C", "J", "F"
  coPassengers        String[] @default([]) @map("co_passengers") // Names parsed from booking email (vs. companions = user-defined travel group)
  parserTemplate      String?  @map("parser_template") // e.g. "LH" or null
  parserConfidence    Int?     @map("parser_confidence") // 0–100

  // AeroDataBox extended fields (v1.5 importers — additive nullable)
  runwayDepartureTime       DateTime? @map("runway_departure_time")
  runwayArrivalTime         DateTime? @map("runway_arrival_time")
  isCargo                   Boolean?  @map("is_cargo")
  aerodataboxLastUpdatedUtc DateTime? @map("aerodatabox_last_updated_utc")
  aerodataboxQualityTags    String[]  @default([]) @map("aerodatabox_quality_tags")
  baggageBelt               String?   @map("baggage_belt")
  checkInDesk               String?   @map("check_in_desk")

  // Smart API check — scheduled time for next live-data lookup
  nextApiCheckAt DateTime? @map("next_api_check_at")

  tripId    String? @map("trip_id")
  bookingId String? @map("booking_id")

  // Special flights (Sonder-Flüge) — non-null specialType marks flight as
  // non-standard (sightseeing loop, eclipse chase, rocket launch, ZeroG,
  // aurora, training, ferry, test). When null, flight is a regular line
  // flight and the new fields are unused. eventLat/Lon mark the off-route
  // attraction (rocket pad, eclipse path) and patternLat/Lon the optional
  // hold/orbit pattern centre. specialData is a free-form JSON blob for
  // type-specific extras (e.g. eclipse magnitude, parabola count).
  specialType String? @map("special_type")
  eventLat    Float?  @map("event_lat")
  eventLon    Float?  @map("event_lon")
  eventLabel  String? @map("event_label")
  patternLat  Float?  @map("pattern_lat")
  patternLon  Float?  @map("pattern_lon")
  specialData Json?   @map("special_data")

  /// Where this row came from, so a second import of the same file recognises
  /// it instead of duplicating it (#84). Format `<source>:<stable key>`; the
  /// key must identify THIS entry, never just the booking — a return leg
  /// shares its PNR with the outbound one, and a unique constraint on the
  /// booking alone would silently refuse the second half of every trip.
  externalRef   String? @map("external_ref")
  importBatchId String? @map("import_batch_id")

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch    ImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  trip           Trip?                 @relation(fields: [tripId], references: [id], onDelete: SetNull)
  booking        Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  pendingUpdates PendingFlightUpdate[]
  companionLinks FlightCompanion[]
  /// The phone's own recording of this flight (forgejo#193) — see `FlightTrack`.
  track          FlightTrack?

  documents Document[]

  @@unique([userId, externalRef])
  // Composite indexes for the two shapes that actually dominate reads.
  // Everything else below is a single-column index kept for a single,
  // named call site — see the note under each.
  //
  // (userId, status, departureTime) serves the statistics shape:
  // `{ userId, status: { in: ['flown','historical'] } }`, optionally with a
  // `departureTime` range. That is ~19 of the queries in routes/stats.ts
  // alone, plus utils/achievements.ts and routes/placeLists/curated.ts.
  // Without it Postgres reads the user's whole row set from the heap and
  // throws the wrong statuses away afterwards; with it, `count` and
  // `groupBy(['status'])` become index-ONLY scans and never touch the heap
  // at all. Column order is deliberate: userId first because it is the only
  // truly selective predicate, departureTime LAST because it is the one
  // arriving as a range — a range column can only be the final index column
  // without cutting off everything after it.
  @@index([userId, status, departureTime])
  // (userId, departureTime) serves the chronological shape: the flight list
  // (`GET /flights`, `orderBy [departureTime desc, id asc]` with skip/take)
  // and `GET /upcoming` (`status != 'cancelled'`, so status is NOT an
  // equality predicate and cannot help an index). Without it those walk the
  // global departure_time index and discard every other user's rows one by
  // one — on a 40-user instance that was 97% of everything it read.
  @@index([userId, departureTime])
  // Kept although both composites above start with userId: dropping it is a
  // separate, measurable decision, not a side effect of this one.
  @@index([userId])
  // Global time window, no user: services/reminderScheduler.ts and
  // services/statusSweep.ts sweep across all users.
  @@index([departureTime])
  // Status without a userId — the sweeps and the boot-time backfill in
  // index.ts filter `status: 'scheduled'` instance-wide. The composite above
  // cannot serve those: its leading column is missing.
  @@index([status])
  @@index([airline])
  @@index([flightNumber])
  @@index([tripId])
  @@index([bookingId])
  @@index([nextApiCheckAt])
  @@index([specialType])
  @@index([importBatchId])
  // Partial, and written in the 2026-05-03 migration by hand. Declared here
  // since the `partialIndexes` preview feature makes Prisma see it — without
  // this line the next migration would silently drop it.
  @@index([userId, aircraftRegistration], map: "flights_user_id_aircraft_registration_idx", where: raw("aircraft_registration IS NOT NULL"))
  @@map("flights")
}

model Achievement {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  description      String
  category         String // explorer, distance, collector, social, elite, special
  domain           String            @default("flight") // 'flight' | 'cruise' | 'shared' | future domain keys
  icon             String // icon identifier
  tier             String            @default("bronze") // bronze, silver, gold, platinum, diamond
  requirement      Int // numeric requirement for achievement
  requirementType  String // flights_count, distance_km, countries, airlines, airports, continents, etc.
  points           Int               @default(10)
  isHidden         Boolean           @default(false) @map("is_hidden")
  createdAt        DateTime          @default(now()) @map("created_at")
  userAchievements UserAchievement[]

  @@index([category])
  @@index([tier])
  @@index([domain])
  @@map("achievements")
}

model UserAchievement {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  /// Read by the statistics ETag (forgejo#50).
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  achievementId String    @map("achievement_id")
  /// When the badge was EARNED. Null until it is, and never null again.
  ///
  /// It used to be `DateTime @default(now())`, so every row carried a date —
  /// including the progress-tracking rows the engine creates the moment a
  /// measure first moves off zero. A row at 86 of a required 100 therefore read
  /// as "unlocked on <the day tracking started>", which is how the owner's
  /// account came to show COUNTRIES_100 four months BEFORE COUNTRIES_50. Nothing
  /// user-facing was wrong (every read derives held-ness from
  /// `progress >= requirement`), but the column asserted something false and an
  /// audit of the table believed it.
  ///
  /// Nullable and WITHOUT a default is what lets an un-earned row say so: with
  /// the default in place a progress-tracking `create` would stamp a date
  /// nobody asked for and the lie would re-appear on every new row.
  ///
  /// It does NOT make a badge held. Held-ness is `progress >= requirement`,
  /// read live (`utils/achievementHeld.ts`) — owner's ruling, 2026-09-20:
  /// "Löschen löscht auch Punkte, der Live-Stand wird gezählt". Delete the
  /// flights behind a badge and the badge goes, and its points with it. For one
  /// day the rule also accepted a non-null date here, which silently froze every
  /// badge a user had genuinely stopped holding.
  ///
  /// What this column IS, and has been since 2026-09-19, is a fact that survives
  /// re-measurement: it is never cleared and never overwritten. It used to be
  /// cleared whenever a measure fell back below its requirement, and the
  /// integrity audit of that day booted the prod mirror and watched
  /// AWAY_SHARE_25 — earned 2026-09-03 — lose its date because the away-share
  /// denominator grows with every day of the year. The date is what lets a card
  /// that has dropped back to a progress bar say when the badge was last held,
  /// instead of a total falling in silence.
  unlockedAt    DateTime? @map("unlocked_at")
  progress      Int       @default(0) // current progress towards achievement

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}

model UserSettings {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  enabledDomains String[] @default(["flight"]) @map("enabled_domains")
  data           Json     @map("data")

  // Parser preferences
  preferredVisionParser String? @default("auto") @map("preferred_vision_parser")
  preferredTextParser   String? @default("auto") @map("preferred_text_parser")
  visionFallbackChain   String? @default("ollama,openai,claude,tesseract,manual") @map("vision_fallback_chain")
  textFallbackChain     String? @default("ollama,openai,claude,regex") @map("text_fallback_chain")

  // User-specific API keys (encrypted at application level)
  openaiApiKey String? @map("openai_api_key")
  claudeApiKey String? @map("claude_api_key")

  // Flight lookup API keys (encrypted at application level)
  airlabsApiKey       String? @map("airlabs_api_key")
  aviationstackApiKey String? @map("aviationstack_api_key")
  aerodataboxApiKey   String? @map("aerodatabox_api_key")
  aeroapiApiKey       String? @map("aeroapi_api_key")
  openskyClientId     String? @map("opensky_client_id")
  openskyClientSecret String? @map("opensky_client_secret")
  openskyUsername     String? @map("opensky_username")
  openskyPassword     String? @map("opensky_password")

  // Tour routing provider API keys (encrypted at application level, Phase 3).
  // The "custom" provider (a self-hosted OSRM) has no key column here — it
  // takes no key at all, see AdminSettings.routingCustomUrl.
  openrouteserviceApiKey String? @map("openrouteservice_api_key")
  graphhopperApiKey      String? @map("graphhopper_api_key")

  // Immich connection (base URL plain, API key encrypted at application level)
  immichBaseUrl     String? @map("immich_base_url")
  immichApiKey      String? @map("immich_api_key")
  immichDefaultMode String  @default("link") @map("immich_default_mode")

  // Dawarich connection (base URL plain, API key encrypted at application
  // level, Phase 3b). Same shape as the Immich connection above — Dawarich
  // is a second self-hosted, LAN-adjacent, pull-only integration, not a
  // fourth key-only provider — so it gets a base URL too rather than
  // reusing `apiKeyResolver.ts`'s single-value-per-provider pattern.
  dawarichBaseUrl String? @map("dawarich_base_url")
  dawarichApiKey  String? @map("dawarich_api_key")

  /// Strava connection (2.7, design 2026-09-24 §5). OAuth tokens, both
  /// encrypted at rest; the athlete id identifies the account for the UI.
  /// Strava's API agreement (Nov 2024) lets a third-party app show this data
  /// to this user ONLY and never to an AI model — tracks imported from it
  /// carry `source = "strava"`, which is what those paths check.
  stravaAthleteId      String?   @map("strava_athlete_id")
  stravaAccessToken    String?   @map("strava_access_token")
  stravaRefreshToken   String?   @map("strava_refresh_token")
  stravaTokenExpiresAt DateTime? @map("strava_token_expires_at")
  stravaScope          String?   @map("strava_scope")

  // Trip automation: silently group imported flights of one PNR into a trip +
  // booking (routes/flightsBatch.ts). Default keeps today's behaviour; the
  // explicit "detect trips" endpoint is NOT gated by this — pressing that
  // button is already the user asking for trips.
  autoCreateTrips Boolean @default(true) @map("auto_create_trips")

  // Auto-update settings
  autoUpdateEnabled          Boolean @default(false) @map("auto_update_enabled")
  /// Opt-in: scan the user's Immich for photo journeys every night (forgejo#94).
  /// Off by default, like flight auto-updates — a scan reads the whole library
  /// and asks a third-party geocoder about the result.
  photoJourneyNightlyScan    Boolean @default(false) @map("photo_journey_nightly_scan")
  autoUpdateRequireApproval  Boolean @default(true) @map("auto_update_require_approval")
  autoUpdateCheckInterval    Int     @default(15) @map("auto_update_check_interval") // minutes
  autoUpdateOnlyDuringFlight Boolean @default(true) @map("auto_update_only_during_flight")
  autoUpdateExpiryHours      Int     @default(24) @map("auto_update_expiry_hours")

  // Boarding pass parser strategy
  // null = auto (LLM wenn verfügbar, sonst basierend auf Verfügbarkeit)
  // "parser-only" = Nur Frontend-Parser, kein API-Call
  // "parser-with-api" = Parser + API zur Validierung
  // "api-only" = Direkt API verwenden
  boardingPassParserStrategy String? @map("boarding_pass_parser_strategy")

  // Historical enrichment settings (Beta)
  historicalEnrichmentEnabled       Boolean @default(false) @map("historical_enrichment_enabled")
  historicalEnrichmentMinConfidence Int     @default(60) @map("historical_enrichment_min_confidence")
  historicalEnrichmentMaxPerDay     Int     @default(50) @map("historical_enrichment_max_per_day")

  // Mobile app preferences backup/sync blob (units, formats, …). Opaque
  // JSON owned by the mobile client; the server only stores + serves it.
  // PAT / device identity are NOT stored here.
  appPrefs          Json?     @map("app_prefs")
  appPrefsUpdatedAt DateTime? @map("app_prefs_updated_at")

  // The web app's display preferences (colours, map appearance, filters, …),
  // kept per SECTION so two devices editing different sections cannot clobber
  // each other: `{ [section]: { value, updatedAt } }` (forgejo#200). A column
  // of its own on purpose — `app_prefs` is the Companion's whole blob and a
  // PUT there replaces it. Section list: `services/webPrefs/sections.ts`.
  webPrefs          Json?     @map("web_prefs")
  webPrefsUpdatedAt DateTime? @map("web_prefs_updated_at")

  // Base currency for lodging FX snapshots (§7.1) and cross-domain totals.
  baseCurrency String @default("EUR") @map("base_currency")

  /// Which evidence tier the country headline counts from — one of
  /// `COUNTRY_TIERS` (shared/countryEvidence.ts): "transit" | "visited" | "slept".
  ///
  /// NULLABLE, and the null is the point: it means "follow the instance
  /// default" rather than "visited". "Does a connection count?" is a personal
  /// definition (spec §3.2), so the admin sets a starting point and a user may
  /// disagree — but an account that never opened the setting must keep
  /// following the admin, not freeze whatever the default happened to be on the
  /// day it was created.
  ///
  /// A bare string, not a Prisma enum, for the reason `routingProvider` gives:
  /// `CountryTier` already owns the closed set in TypeScript and Zod validates
  /// it at the boundary; a DB-level enum would be a second place for the list
  /// to drift. It changes NO stored row and NO country list — only which rows
  /// the headline counts.
  countryThreshold String? @map("country_threshold")

  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model AnalyticsEvent {
