{
  "name": "travstats-backend",
  "version": "1.0.0",
  "description": "Flight tracking backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run prisma:generate && npm run init && tsx watch src/index.ts",
    "postinstall": "prisma generate",
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:parser": "tsx scripts/test-enhanced-parser.ts",
    "test:parser:real": "tsx scripts/test-real-emails.ts",
    "test:parser:integration": "tsx scripts/test-integration.ts",
    "test:ollama": "tsx scripts/test-ollama-models.ts",
    "test:ollama:download": "tsx scripts/test-ollama-models.ts --download-missing",
    "test:samples": "tsx scripts/test-parser-samples.ts all",
    "test:samples:email": "tsx scripts/test-parser-samples.ts email",
    "test:samples:boardingpass": "tsx scripts/test-parser-samples.ts boardingpass",
    "init": "tsx src/init.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "check:drift": "tsx scripts/check-schema-drift.ts",
    "generate:airline-catalog": "tsx scripts/generate-airline-catalog.ts",
    "seed:airports:csv": "node dist/seedAirportsFromCSV.js",
    "backfill:closed-airports": "node dist/scripts/backfillClosedAirports.js",
    "backfill:route-distance": "node dist/scripts/backfillRouteDistance.js",
    "sharing:report-consent": "node dist/scripts/reportShareGroupConsent.js",
    "sharing:backfill-ferries": "node dist/scripts/backfillSharedFerries.js",
    "seed:demo": "node dist/seedDemoAccount.js",
    "seed:dev-admin": "tsx src/seedDevAdmin.ts",
    "seed:roadtrip-demo": "tsx src/seedRoadtripDemoCli.ts",
    "seed:dev-admin-keys": "tsx src/seedDevAdminKeys.ts",
    "dead-code": "ts-prune | grep -v \"(used in module)\"",
    "lint:py": "ruff check src/scripts/",
    "refresh:airline-logos": "bash scripts/refresh-airline-logos.sh",
    "typecheck:tests": "node --max-old-space-size=6144 ../scripts/check-test-types.mjs",
    "typecheck:manual": "tsc -p tsconfig.manual.json"
  },
  "keywords": [
    "flight",
    "tracking",
    "api"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@kenjiuno/msgreader": "^1.29.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/server": "^14.0.3",
    "archiver": "^7.0.1",
    "axios": "^1.20.0",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.8",
    "exifreader": "^4.50.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "fit-file-parser": "6.2.2",
    "flag-icons": "7.6.0",
    "geo-tz": "^8.1.10",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "node-html-parser": "^9.0.1",
    "nodemailer": "^10.1.1",
    "otplib": "^13.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "postal-mime": "^3.0.1",
    "rotating-file-stream": "^3.2.10",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^6.0.1",
    "uuid": "^14.0.3",
    "webdav": "^5.11.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.12.0",
    "jest": "^29.7.0",
    "jpeg-js": "^0.4.4",
    "pino-pretty": "^13.2.0",
    "pngjs": "^6.0.0",
    "prisma": "^7.10.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "qs": ">=6.14.2",
    "tar": ">=7.5.22",
    "lodash": ">=4.17.23",
    "body-parser": "^1.20.6",
    "minimatch@3": {
      "brace-expansion": "^1.1.16"
    },
    "fast-xml-parser": ">=5.10.1",
    "fast-xml-builder": ">=1.1.7",
    "uuid": "$uuid",
    "deepmerge-ts": ">=8.0.2",
    "mysql2": ">=3.24.4"
  }
}
