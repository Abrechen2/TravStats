{
  "name": "travstats-backend",
  "version": "1.0.0",
  "description": "Flight tracking backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run prisma:generate && npm run init && tsx watch src/index.ts",
    "postinstall": "prisma generate",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:parser": "tsx scripts/test-enhanced-parser.ts",
    "test:parser:real": "tsx scripts/test-real-emails.ts",
    "test:parser:integration": "tsx scripts/test-integration.ts",
    "test:ollama": "tsx scripts/test-ollama-models.ts",
    "test:ollama:download": "tsx scripts/test-ollama-models.ts --download-missing",
    "test:samples": "tsx scripts/test-parser-samples.ts all",
    "test:samples:email": "tsx scripts/test-parser-samples.ts email",
    "test:samples:boardingpass": "tsx scripts/test-parser-samples.ts boardingpass",
    "init": "tsx src/init.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "check:drift": "tsx scripts/check-schema-drift.ts",
    "generate:airline-catalog": "tsx scripts/generate-airline-catalog.ts",
    "seed:airports:csv": "node dist/seedAirportsFromCSV.js",
    "backfill:closed-airports": "node dist/scripts/backfillClosedAirports.js",
    "seed:demo": "node dist/seedDemoAccount.js",
    "seed:dev-admin": "tsx src/seedDevAdmin.ts",
    "seed:dev-admin-keys": "tsx src/seedDevAdminKeys.ts",
    "dead-code": "ts-prune | grep -v \"(used in module)\"",
    "lint:py": "ruff check src/scripts/",
    "refresh:airline-logos": "bash scripts/refresh-airline-logos.sh"
  },
  "keywords": [
    "flight",
    "tracking",
    "api"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@kenjiuno/msgreader": "^1.28.0",
    "@prisma/client": "^5.7.0",
    "@simplewebauthn/server": "^13.3.2",
    "archiver": "^7.0.1",
    "axios": "^1.19.0",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "geo-tz": "^8.1.8",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "node-html-parser": "^9.0.1",
    "nodemailer": "^9.0.5",
    "openai": "^6.46.0",
    "otplib": "^12.0.1",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "rotating-file-stream": "^3.2.10",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^6.0.1",
    "uuid": "^14.0.2",
    "webdav": "^5.9.0",
    "zod": "^3.22.4",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.8.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "qs": ">=6.14.2",
    "tar": ">=7.5.22",
    "lodash": ">=4.17.23",
    "body-parser": "^1.20.6",
    "minimatch@3": {
      "brace-expansion": "^1.1.16"
    },
    "fast-xml-parser": ">=5.10.1",
    "fast-xml-builder": ">=1.1.7",
    "uuid": "$uuid"
  }
}
