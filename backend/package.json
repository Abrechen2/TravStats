{
  "name": "travstats-backend",
  "version": "0.9.1-beta",
  "description": "Flight tracking backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run init && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:parser": "tsx scripts/test-enhanced-parser.ts",
    "test:parser:real": "tsx scripts/test-real-emails.ts",
    "test:parser:integration": "tsx scripts/test-integration.ts",
    "test:ollama": "tsx scripts/test-ollama-models.ts",
    "test:ollama:download": "tsx scripts/test-ollama-models.ts --download-missing",
    "test:samples": "tsx scripts/test-parser-samples.ts all",
    "test:samples:email": "tsx scripts/test-parser-samples.ts email",
    "test:samples:boardingpass": "tsx scripts/test-parser-samples.ts boardingpass",
    "init": "tsx src/init.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:airports:csv": "node dist/seedAirportsFromCSV.js",
    "seed:demo": "node dist/seedDemoUser.js",
    "dead-code": "ts-prune | grep -v \"(used in module)\"",
    "lint:py": "ruff check src/scripts/"
  },
  "keywords": [
    "flight",
    "tracking",
    "api"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@kenjiuno/msgreader": "^1.27.0-alpha.3",
    "@prisma/client": "^5.7.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.5",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "node-html-parser": "^7.0.1",
    "nodemailer": "^8.0.2",
    "openai": "^6.10.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "rotating-file-stream": "^3.2.7",
    "tesseract.js": "^6.0.1",
    "uuid": "^13.0.0",
    "webdav": "^5.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^5.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "qs": ">=6.14.2",
    "tar": ">=7.5.7",
    "lodash": ">=4.17.23"
  }
}
