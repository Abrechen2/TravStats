{
  "airline": "Emirates",
  "iata": "EK",
  "version": "2026-10",
  "from": ["@emirates.com", "@emirates.email"],
  "subject": ["Ihre Buchung ist bestätigt"],
  "selectors": {},
  "textPatterns": {
    "flightNumber": ["^Start\\s+Ankunft[\\s\\S]*?^Flug\\s*\\n\\s*(EK\\s?\\d{2,4})\\s*$"],
    "pnr": ["^Buchungsnummer\\s*\\n\\s*([A-Z0-9]{6})\\s*$"],
    "departureCode": ["^Start\\s+Ankunft\\s*\\n\\s*([A-Z]{3})\\s*$"],
    "arrivalCode": ["^Start\\s+Ankunft\\s*\\n\\s*[A-Z]{3}\\s*\\n[\\s\\S]*?\\b([A-Z]{3})\\s*$"],
    "departureTime": [
      "^Start\\s+Ankunft[\\s\\S]*?^(?=\\d{1,2}:\\d{2}\\s*\\n[^\\n]+\\n\\s*(\\d{1,2}\\.\\s*[A-Za-zä]{3,9}\\.?\\s+\\d{2})\\b)(\\d{1,2}:\\d{2})"
    ],
    "arrivalTime": [
      "^Start\\s+Ankunft[\\s\\S]*?[A-Za-zä]{3,9}\\.?\\s+\\d{2}\\s+(?=\\d{1,2}:\\d{2}\\s*\\n[^\\n]+\\n\\s*(\\d{1,2}\\.\\s*[A-Za-zä]{3,9}\\.?\\s+\\d{2})\\b)(\\d{1,2}:\\d{2})"
    ]
  },
  "segments": {
    "splitPattern": "^Start\\s+Ankunft\\s*$"
  },
  "declineIf": ["Prämienflugbuchung\\*? bestätigen", "Skywards-Meilen von Ihrem Konto abgebucht"],
  "transforms": {
    "flightNumber": "removeSpaces",
    "pnr": "uppercase",
    "departureTime": "parseIso",
    "arrivalTime": "parseIso"
  },
  "testCases": [
    {
      "input": "Buchungsnummer\nQX7TST\nStart Ankunft\nMUC\nMünchen DXB\nDubai\n21:10\nMittwoch\n04. März 26 05:20\nDonnerstag\n05. März 26\nFlug\nEK111",
      "expected": {
        "flightNumber": "EK111",
        "pnr": "QX7TST",
        "departureCode": "MUC",
        "arrivalCode": "DXB",
        "departureTime": "2026-03-04T21:10",
        "arrivalTime": "2026-03-05T05:20"
      }
    }
  ]
}
