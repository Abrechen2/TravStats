    ],
    "arrivalTime": [
      "^EK\\s?\\d{3,4}\\s*\\n\\s*\\S+\\s+\\d{1,2}-[A-Za-zä]{3}-\\d{2}\\s+\\d{1,2}:\\d{2}[\\s\\S]*?\\s\\S+\\s+(\\d{1,2}-[A-Za-zä]{3}-\\d{2})\\s+(\\d{1,2}:\\d{2})"
    ]
  },
  "segments": {
    "splitPattern": "^EK\\s?\\d{3,4}\\s*$"
