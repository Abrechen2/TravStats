{
  "id": "lodging:travelclick",
  "domain": "lodging",
  "version": "2026.10.9",
  "issuer": {
    "name": "TravelClick booking engine",
    "kind": "other"
  },
  "markets": [],
  "match": {
    "markers": ["confirmation number"],
    "anchors": ["reservations.travelclick.com", "thank you for your reservation at"]
  },
  "extraction": {
    "fields": {
      "hotelName": {
        "patterns": ["Thank you for your reservation at\\s+([^!\\n]+)"],
        "flags": "i",
        "transform": ["text", "stripTrailingSeparator"]
      },
      "confirmationNumber": {
        "patterns": ["Confirmation number\\s*:?\\s*(\\d+)"],
        "flags": "i",
        "transform": ["text", "stripTrailingSeparator"]
      },
      "checkIn": {
        "patterns": ["Check\\s*in\\s*\\t?\\s*([A-Za-z]+ \\d{1,2}, \\d{4})"],
        "flags": "i",
        "transform": "englishDate"
      },
      "checkOut": {
        "patterns": ["Check\\s*out\\s*\\t?\\s*([A-Za-z]+ \\d{1,2}, \\d{4})"],
        "flags": "i",
        "transform": "englishDate"
      },
      "roomCategory": {
        "patterns": ["You reserved:\\s*([^\\n]+)"],
        "flags": "i",
        "transform": ["text", "stripTrailingSeparator"]
      },
      "totalPrice": {
        "patterns": ["Total amount including all taxes[^:]*:?\\s*\\t?\\s*[A-Z]{3}\\s*([\\d.,]+)"],
        "flags": "i",
        "transform": "money"
      },
      "currency": {
        "patterns": ["Total amount including all taxes[^:]*:?\\s*\\t?\\s*([A-Z]{3})"],
        "flags": "i",
        "transform": "currency"
      },
      "guests": {
        "patterns": ["Adults\\s*\\t?\\s*(\\d+)"],
        "flags": "i",
        "transform": "integer"
      },
      "type": {
        "value": "hotel"
      }
    },
    "required": ["hotelName", "checkIn", "checkOut"]
  },
  "testCases": [
    {
      "name": "a TravelClick property",
      "input": "Thank you for your reservation at Armani Hotel Dubai! Reference Number 711754296\nThank you for your reservation at Armani Hotel Dubai! Reference Number 711754296\nConfirmation number : 711754296 <https://reservations.travelclick.com/73769?confirmid=711754296>\nCheck in\t April 30, 2023\nCheck out\t May 3, 2023\nAdults\t 2\nYou reserved: Armani Fountain Suite with Balcony, Breakfast\nTotal amount including all taxes and excluding Tourism Dirham Fee:\t AED 11,662.00",
      "expect": "match",
      "expected": {
        "hotelName": "Armani Hotel Dubai",
        "checkIn": "2023-04-30",
        "checkOut": "2023-05-03",
        "confirmationNumber": "711754296"
      }
    },
    {
      "name": "a mail without stay dates",
      "input": "Thank you for your reservation at Armani Hotel Dubai!\nThank you for your reservation at Armani Hotel Dubai!\nConfirmation number : 711754296\nWe look forward to welcoming you.",
      "expect": "decline"
    }
  ]
}
