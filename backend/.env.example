# ============================================
# SELF-HOSTING CONFIGURATION
# ============================================
# Instance name (shown in UI, useful for families/groups)
INSTANCE_NAME=TravStats Family

# Allow new user registration (recommended: disable after initial setup)
# Set to 'false' to require invitation tokens for new users
# First user is always allowed and becomes admin automatically
ALLOW_REGISTRATION=true

# Maximum recommended users per instance (warning threshold, not hard limit)
# Recommended: 1-10 users for optimal performance
MAX_USERS=10

# ============================================
# DATABASE
# ============================================
# For self-hosting: use Docker container or local PostgreSQL
# Change the password to something secure!
DATABASE_URL=postgresql://flights:CHANGE-THIS-PASSWORD@db:5432/flights

# ============================================
# JWT & SECURITY
# ============================================
# CRITICAL: Generate with: openssl rand -hex 32
# NEVER use the default value in production!
JWT_SECRET=CHANGE-THIS-IN-PRODUCTION-USE-OPENSSL-RAND-HEX-32
JWT_EXPIRES_IN=7d

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=8000

# Set to false when serving over plain HTTP (local dev/LAN)
# Set to true when behind HTTPS (reverse proxy, domain)
COOKIE_SECURE=false

# External APIs
AVIATIONSTACK_API_KEY=your-aviationstack-key

# CORS & Frontend URL
# Local network: http://192.168.1.X:3000
# Tailscale VPN: http://100.64.0.X:3000
# Public domain: https://travstats.yourdomain.com
# Multiple origins: Use comma-separated values
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# AirLabs Flight Data API (Optional)
# Free Tier: 1000 requests/month
# Get your free API key at: https://airlabs.co/
# Leave empty to disable flight lookup features
AIRLABS_API_KEY=

# OpenSky (Optional, free but rate-limited; used as final fallback)
# For new accounts (OAuth2 client credentials):
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# For legacy accounts (Basic Auth fallback):
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# Shared secret for webhook endpoint /imports/email
IMPORT_SECRET=change-me-to-random-secret

# ============================================
# LLM PARSER (Ollama)
# ============================================
# Enable AI-powered email parsing (highly accurate, requires Ollama)
# Set to 'true' to use LLM as fallback when regex parsing fails
# Set to 'false' to use only regex parsing (faster, but less accurate)
USE_LLM_PARSER=true

# Ollama server URL (default: http://ollama:11434 for Docker)
# For local development: http://localhost:11434
OLLAMA_URL=http://ollama:11434

# Ollama model to use for parsing
# Recommended models:
#   - llama3.2:3b (default, ~1.5GB, fast, good accuracy)
#   - mistral:7b (~4GB, slower, better accuracy)
#   - llama3.2:1b (~700MB, very fast, lower accuracy)
OLLAMA_MODEL=llama3.2:3b
