# Database
# Production: Use a secure password and consider connection pooling
DATABASE_URL=postgresql://flights:example@192.168.178.36:5432/flights

# JWT
# CRITICAL: Generate a strong random secret for production!
# Example: openssl rand -hex 32
# NEVER use the default value in production!
JWT_SECRET=your-secret-key-change-in-production-MINIMUM-32-chars
JWT_EXPIRES_IN=7d

# Server
NODE_ENV=development
PORT=8000

# External APIs
AVIATIONSTACK_API_KEY=your-aviationstack-key

# CORS
# Production: Set to your actual frontend URL(s)
# Multiple origins: Use comma-separated values or configure in code
CORS_ORIGIN=http://localhost:3000

# AirLabs Flight Data API (Optional)
# Free Tier: 1000 requests/month
# Get your free API key at: https://airlabs.co/
# Leave empty to disable flight lookup features
AIRLABS_API_KEY=

# OpenSky (Optional, free but rate-limited; used as final fallback)
# For new accounts (OAuth2 client credentials):
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# For legacy accounts (Basic Auth fallback):
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# IMAP Import (Booking confirmation ingestion)
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=import@example.com
# IMAP_PASSWORD=your-password
# IMAP_TLS=true
# IMPORT_SECRET=change-me   # shared secret for inbound email endpoint / imap poll trigger
