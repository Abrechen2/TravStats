# =====================================================================
#  TravStats backend — development environment
# =====================================================================
#
# For PRODUCTION deployments the root-level `.env.prod.example` is the
# canonical template (only DB_PASSWORD is required). This file is for
# LOCAL BACKEND DEVELOPMENT.
#
# Runtime-configurable from the admin UI after first boot (do NOT put
# these in .env anymore):
#   - Instance name / public URL / user cap / registration mode
#   - AirLabs / OpenSky / Aviationstack API keys
#   - Ollama endpoint + model
#   - Backup schedule / retention / WebDAV sync
#   - SMTP (invites, password reset)
#
# Copy this file to `backend/.env` and fill in.

# ============================================
# DATABASE
# ============================================
# Local Postgres (PostGIS-enabled). Start with Docker:
#   docker run -d --name travstats-db-dev \
#     -e POSTGRES_USER=flights -e POSTGRES_PASSWORD=dev \
#     -e POSTGRES_DB=flights -p 5433:5432 postgis/postgis:15-3.4
DATABASE_URL=postgresql://flights:dev@localhost:5433/flights

# ============================================
# JWT
# ============================================
# Leave empty — auto-generated and persisted to /app/secrets on first run
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=8000

# Plain HTTP in local dev → must be false
COOKIE_SECURE=false

# Vite dev server origin for CORS (backend at :8000 serves API to :3000)
CORS_ORIGIN=http://localhost:3000

# ============================================
# OPTIONAL — seed data for first-time dev setup
# ============================================
# Load ~9000 airports from OpenFlights on first boot (recommended once)
SEED_AIRPORTS=false

# Demo user with 120 sample flights (demo / demo123)
CREATE_DEMO_USER=false

# ============================================
# OPTIONAL — webhook endpoint shared secret
# ============================================
# Used by /imports/email when wiring up an external mail-fetch service
IMPORT_SECRET=

# ============================================
# OPTIONAL — airline logo API (logostream.dev)
# ============================================
# Without it the logo proxy falls back to Daisycon (full-wordmark logos
# only, PNG). Also settable from the admin UI (global, instance-wide).
LOGOSTREAM_API_KEY=
