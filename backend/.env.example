# Database
# Production: Use a secure password and consider connection pooling
DATABASE_URL=postgresql://flights:example@192.168.178.36:5432/flights

# JWT
# CRITICAL: Generate a strong random secret for production!
# Example: openssl rand -hex 32
# NEVER use the default value in production!
JWT_SECRET=your-secret-key-change-in-production-MINIMUM-32-chars
JWT_EXPIRES_IN=7d

# Server
NODE_ENV=development
PORT=8000
# Set to false when serving over plain HTTP (local dev); true when behind HTTPS
COOKIE_SECURE=false

# External APIs
AVIATIONSTACK_API_KEY=your-aviationstack-key

# CORS
# Production: Set to your actual frontend URL(s)
# Multiple origins: Use comma-separated values or configure in code
# Add both Vite dev (5173) and built (3000) if you switch between them
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# AirLabs Flight Data API (Optional)
# Free Tier: 1000 requests/month
# Get your free API key at: https://airlabs.co/
# Leave empty to disable flight lookup features
AIRLABS_API_KEY=

# OpenSky (Optional, free but rate-limited; used as final fallback)
# For new accounts (OAuth2 client credentials):
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# For legacy accounts (Basic Auth fallback):
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# IMAP Import (Booking confirmation ingestion)
# Enable automatic email import of flight confirmations
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your-email@gmail.com
# For Gmail: Use App-Specific Password (see IMAP_SETUP.md)
IMAP_PASSWORD=your-app-specific-password
# Optional: mailbox/folder name (e.g., INBOX/Bookings)
IMAP_MAILBOX=INBOX
# User ID to assign imported flights to
IMAP_DEFAULT_USER_ID=
# Poll interval in minutes (default: 5)
IMAP_POLL_INTERVAL=5
# Comma-separated filter lists (defaults target Lufthansa booking mails)
IMAP_ALLOWED_SENDERS=@lufthansa.com,@dlh.de,@mail.lufthansa.com
IMAP_SUBJECT_KEYWORDS=lufthansa,buchungsbestaetigung,booking,etix,eticket
# Shared secret for webhook endpoint /imports/email
IMPORT_SECRET=change-me-to-random-secret
