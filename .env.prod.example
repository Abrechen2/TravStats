# TravStats Production Environment Variables
# Copy this file to .env and fill in your values

# ==============================================
# REQUIRED: Database Password
# ==============================================
# SECURITY: Use a strong password!
# Generate with: openssl rand -base64 32
DB_PASSWORD=changeme-to-strong-password

# ==============================================
# Application Port
# ==============================================
# Port where TravStats will be accessible
APP_PORT=3000

# ==============================================
# OPTIONAL: JWT Secret
# ==============================================
# If not set, TravStats will auto-generate a secure secret
# and persist it to /app/data/jwt.secret
# Only set this if you need a custom secret
# Generate with: openssl rand -hex 32
# JWT_SECRET=

# ==============================================
# OPTIONAL: External API Keys
# ==============================================
# AirLabs Flight Data API (Free Tier: 1000 req/month)
# Get your free API key at: https://airlabs.co/
AIRLABS_API_KEY=

# OpenSky Network API (Optional, free but rate-limited)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ==============================================
# OPTIONAL: Admin & Instance Settings
# ==============================================
# Instance name shown in UI and Admin Panel
INSTANCE_NAME=TravStats

# Maximum number of user accounts (recommended for self-hosting: 1-10)
# Warning will be shown in Admin Panel when limit is reached
MAX_USERS=10

# Allow open registration without invitation links
# SECURITY: Set to false for private instances (recommended)
# Users can only register via admin-generated invitation links
ALLOW_REGISTRATION=false

# Frontend URL for generating invitation links
# Used by Admin Panel to create full invitation URLs
# Examples: http://192.168.1.100:3000, https://travstats.yourdomain.com
FRONTEND_URL=http://localhost:3000

# Create a demo user on first start (username: demo, password: demo123)
# SECURITY: Only for testing! Set to false in production
CREATE_DEMO_USER=false

# ==============================================
# OPTIONAL: CORS Settings
# ==============================================
# Allowed frontend origins (comma-separated for multiple)
# Examples: http://localhost:3000, https://travstats.yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Enable secure cookies (HTTPS only)
# Set to false if serving via HTTP (local network)
COOKIE_SECURE=true

# ==============================================
# OPTIONAL: Seeding
# ==============================================
# Automatically populate airports database on first start
# Recommended: true
SEED_AIRPORTS=true
