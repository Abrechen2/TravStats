# TravStats Production Environment Variables
# Copy this file to .env and adjust the values

# ===== REQUIRED =====
# Database Password (CHANGE THIS!)
DB_PASSWORD=your-secure-database-password-here

# ===== OPTIONAL =====
# Application Port (default: 3000)
APP_PORT=3000

# Auto-seed airports database on first start (default: true)
SEED_AIRPORTS=true

# ===== ADVANCED (Usually not needed) =====
# Database connection details (defaults work with docker-compose)
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=flights
# DB_USER=flights

# JWT Secret (auto-generated if not provided)
# JWT_SECRET=
